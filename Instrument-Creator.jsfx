desc:Instrument Creator — Build Impossible Instruments from Parts
//tags: instrument synthesizer physical-modelling
//author: KallumS
//
// A playable MIDI instrument assembled from ten kinds of part, the way a real
// instrument is: an energy source drives an exciter, which sets a vibrating
// element going; a coupler passes the vibration to a resonator, and a
// radiator sends it into the air. Four control parts (frequency control,
// tuning, damping, modulation) decide how it is played. The vibrating element
// and the resonator can be made of any of twenty materials, real or silly.
//
// Every part is a small physical model. The element's pitch, decay and
// inharmonicity come from the material's real constants (stiffness, density,
// loss factor), the air column from Trombolese's boundary-layer physics, and
// the loop tuning from Reverberator's phase-exact method. See README.md.

slider1:0<0,5,1{Breath,Bow,Finger,Plectrum,Hammer,Electricity}>-Energy Source
slider2:0<0,5,1{Reed,Lips,Hammer,Bow,Plectrum,Mallet}>-Exciter
slider3:5<0,5,1{String,Membrane,Bar,Plate,Reed,Air Column}>-Vibrating Element
slider4:12<0,30,1{Steel,Brass,Bronze,Aluminium,Gold,Glass,Crystal,Ice,Marble,Clay,Spruce,Rosewood,Bamboo,Bone,Gut,Nylon,Carbon Fibre,Rubber,Paper,Jelly,Plastic,PVC,Wood,Leather,Cardboard,Foil,Cling Film,Tin,Car Panel,Chain Link,Handpan Steel}>-Element Material
slider5:0<0,4,1{Bore,Soundbox,Pipe,Cavity,Body}>-Resonator
slider6:12<0,30,1{Steel,Brass,Bronze,Aluminium,Gold,Glass,Crystal,Ice,Marble,Clay,Spruce,Rosewood,Bamboo,Bone,Gut,Nylon,Carbon Fibre,Rubber,Paper,Jelly,Plastic,PVC,Wood,Leather,Cardboard,Foil,Cling Film,Tin,Car Panel,Chain Link,Handpan Steel}>-Resonator Material
slider7:2<0,3,1{Bridge,Soundpost,Mouthpiece,Windway}>-Coupler
slider8:0<0,3,1{Bell,Soundboard,Drumhead,Cone}>-Radiator
slider9:1<0,4,1{Fret,Tone Hole,Valve,Slide,Key}>-Frequency Control
slider10:2<0,3,1{Peg,Tuning Pin,Machine Head,Slide}>-Tuning Mechanism
slider11:0<0,4,1{Damper,Mute,Palm,Felt,Hand}>-Damping
slider12:0<0,4,1{Keywork,Pedals,Valves,Levers,Electronics}>-Modulation / Control
slider13:70<0,100,1>-Force / Pressure (%)
slider14:100<25,400,1:log=100>-Size (%)
slider15:0<-100,100,1>-Brightness
slider16:100<10,400,1:log=100>-Decay (%)
slider17:20<2,50,1>-Excite Position (%)
slider18:50<0,100,1>-Resonator Amount (%)
slider19:0<0,1,1{Poly,Mono (Legato)}>-Play Mode
slider20:120<5,1000,1:log=150>-Glide Time (ms)
slider21:0<-100,100,1>-Fine Tune (cents)
slider22:0<-36,12,0.1>-Output (dB)
slider23:0<0,100,1>-Age / Rust (%)

in_pin:none
out_pin:Left output
out_pin:Right output

@init

ext_noinit = 1;
gfx_ext_retina = 1;   // draw at full resolution on Retina/HiDPI screens (gsc in @gfx scales the layout)

// ---------------------------------------------------------------------------
// Memory map (units: EEL memory slots). Names are long on purpose: EEL2
// identifiers are case-insensitive (see Reverberator ADR 0010).
// ---------------------------------------------------------------------------
VOICE_BASE = 0; VOICE_STRIDE = 512; VOICES_MAX = 8;
MODE_OFF = 160; MODE_STRIDE = 8; MODES_MAX = 24;
MAT_TAB = 13600; MAT_STRIDE = 16; MAT_N = 31;
// 14200: CAT_TAB, each part's box, anchor and label in the drawing (12 x 16, window only; set with the drawing below)
FOCUS_TAB = 14400; FOCUS_MAX = 64;  // keyboard focus list: id, x, y, w, h per control (window only)
HIG_TXT = 14800; HIG_TXT_MAX = 180; // text audit for the tests: count, then r, g, b, x, y, w, h, - per string (window only)
BESSEL_TAB = 4600; BAR_TAB = 4700; CANT_TAB = 4720; PLATE_TAB = 4750;
BODY_BASE = 5000; BODY_STRIDE = 8; BODY_MAX = 24;
HEAD_BASE = 5300; HEAD_MAX = 8;
NOTE_STACK = 5500;
BIQ_COEF = 5600; BIQ_STATE = 5700;
MIDIQ = 82000; MIDIQ_MAX = 1000;
SCOPE_BUF = 11000; SCOPE_LEN = 2048;
DIFF_BASE = 16384; DIFF_LEN = 8192;
LINE_BASE = 131072; LINE_LEN = 16384; LINE_MASK = 16383;

// Voice fields
V_ON = 0; V_NOTE = 1; V_VEL = 2; V_GATE = 3; V_HELD = 4; V_AGE = 5;
V_PITCH = 6; V_PTGT = 7; V_T = 8; V_ENV = 9; V_LVLF = 10; V_REL = 11;
V_STRK = 12; V_PT = 13; V_PA = 14; V_PDUR = 15; V_E1 = 16; V_E2 = 17;
V_C = 18; V_WP = 19; V_DA = 20; V_DB = 21; V_DJ = 22; V_DR = 23;
V_LB = 24; V_LP = 25; V_LS = 26; V_SGN = 27; V_APA = 28; V_APM = 29;
V_AP = 30;            // 8 slots: dispersion allpass states
V_LIPA1 = 38; V_LIPA2 = 39; V_LIPY1 = 40; V_LIPY2 = 41;
V_DCX = 42; V_DCY = 43; V_LDCX = 44; V_LDCY = 45;
V_RLS = 46; V_RG = 47; V_RSGN = 48; V_RLB = 49; V_RLP = 50;
V_PANL = 51; V_PANR = 52; V_NM = 53; V_XLP = 54; V_TRT = 55;
V_DETC = 56; V_SETL = 57; V_THS = 58; V_THC = 59; V_OG = 60;
V_FCUR = 61; V_FMOD = 62; V_FBASE = 63; V_WG = 64; V_TWO = 65;
V_LOOPK = 66; V_XT = 67; V_CONT = 68; V_LEVEL = 69; V_NRES = 70;
V_BETA = 71; V_TLO = 72; V_THI = 73; V_FB = 74; V_TPA = 75; V_TPB = 76;
V_DRV = 77; V_LBASE = 78; V_INDC = 79; V_NS = 80; V_NS2 = 81;
V_PLKN = 82; V_RES_K = 83; V_WOB = 84; V_DIP = 85; V_OUTP = 86;
V_SUSDRV = 87; V_EG = 88; V_CHOP = 89; V_LIPY = 90; V_LIPV = 91; V_LIPIM = 92; V_FK = 93; V_BANDED = 94; V_NB = 95; V_DRVN = 96; V_LIPR = 97; V_RATS = 98; V_RATX = 99; V_CRKS = 100; V_CRKX = 101;
BAND_STRIDE = 20;

// ---------------------------------------------------------------------------
// Air at 20 C (Trombolese constants.py)
// ---------------------------------------------------------------------------
C_AIR = 343.2; RHO_AIR = 1.204; NU_AIR = 0.00001506; GAM_AIR = 1.4017; PR_AIR = 0.708;
BLC = sqrt(NU_AIR) + (GAM_AIR - 1)*sqrt(NU_AIR/PR_AIR);

// ---------------------------------------------------------------------------
// Materials: stiffness E (GPa), density (kg/m^3), loss factor eta at 1 kHz,
// how eta grows with frequency, irregularity (grain, cracks, bubbles: splits
// modes), wall roughness for air columns, hardness (how sharp a strike is),
// how thick a string of it must be (you cannot draw marble into wire),
// colour, longest ring the mounting allows (s), wobble (jelly), crackle
// (crumpled foil) and rattle (loose fixings, film slapping: Reverberator's
// contact rattle).
// ---------------------------------------------------------------------------
M_E = 0; M_RHO = 1; M_ETA = 2; M_SLOPE = 3; M_IRR = 4; M_ROUGH = 5; M_HARD = 6;
M_THICK = 7; M_CR = 8; M_CG = 9; M_CB = 10; M_TMAX = 11; M_WOB = 12; M_CRK = 13; M_RAT = 14;
function mat_def(idx, ee, rho, eta, slp, irr, rough, hard, thick, cr, cg, cb, tmax, wob) local(p)
(
  p = MAT_TAB + idx*MAT_STRIDE;
  p[13] = p[14] = 0;
  p[0] = ee; p[1] = rho; p[2] = eta; p[3] = slp; p[4] = irr; p[5] = rough; p[6] = hard;
  p[7] = thick; p[8] = cr; p[9] = cg; p[10] = cb; p[11] = tmax; p[12] = wob;
);
mat_def( 0, 200,   7850,  0.0003,  0.1, 0.001, 1.0, 1.0,  1.0, 0.70, 0.74, 0.80, 16, 0);   // Steel
mat_def( 1, 110,   8500,  0.0008,  0.1, 0.002, 1.0, 0.9,  1.0, 0.88, 0.72, 0.30, 12, 0);   // Brass
mat_def( 2, 110,   8700,  0.0004,  0.1, 0.004, 1.0, 0.95, 1.0, 0.74, 0.50, 0.26, 20, 0);   // Bronze
mat_def( 3, 69,    2700,  0.0003,  0.1, 0.001, 1.0, 0.8,  1.5, 0.84, 0.86, 0.88, 14, 0);   // Aluminium
mat_def( 4, 79,    19300, 0.003,   0.2, 0.002, 1.0, 0.5,  1.0, 1.00, 0.82, 0.25, 6, 0);    // Gold
mat_def( 5, 70,    2500,  0.0008,  0.1, 0.004, 0.9, 1.0,  3.0, 0.62, 0.86, 0.94, 10, 0);   // Glass
mat_def( 6, 80,    2650,  0.00008, 0.0, 0.002, 0.9, 1.0,  3.0, 0.86, 0.78, 1.00, 30, 0);   // Crystal
mat_def( 7, 9,     917,   0.0025,  0.3, 0.02,  0.8, 0.7,  4.0, 0.80, 0.93, 1.00, 6, 0);    // Ice
mat_def( 8, 55,    2700,  0.003,   0.2, 0.012, 1.0, 1.0,  4.0, 0.92, 0.90, 0.88, 5, 0);    // Marble
mat_def( 9, 40,    2000,  0.005,   0.3, 0.02,  2.5, 0.9,  4.0, 0.80, 0.45, 0.30, 3, 0);    // Clay
mat_def(10, 11,    440,   0.008,   0.4, 0.02,  1.5, 0.45, 3.0, 0.90, 0.76, 0.50, 3, 0);    // Spruce
mat_def(11, 16,    850,   0.006,   0.4, 0.015, 1.4, 0.55, 3.0, 0.55, 0.28, 0.16, 3, 0);    // Rosewood
mat_def(12, 20,    700,   0.009,   0.4, 0.02,  1.3, 0.5,  2.5, 0.80, 0.78, 0.42, 3, 0);    // Bamboo
mat_def(13, 18,    1900,  0.012,   0.3, 0.015, 1.6, 0.8,  3.0, 0.95, 0.92, 0.82, 2.5, 0);  // Bone
mat_def(14, 4,     1300,  0.006,   0.5, 0.005, 1.3, 0.35, 1.3, 0.90, 0.84, 0.66, 5, 0);    // Gut
mat_def(15, 3,     1140,  0.004,   0.5, 0.002, 1.0, 0.35, 1.3, 0.96, 0.96, 0.92, 6, 0);    // Nylon
mat_def(16, 150,   1600,  0.002,   0.2, 0.002, 1.0, 0.9,  1.5, 0.30, 0.31, 0.36, 8, 0);    // Carbon fibre
mat_def(17, 0.05,  1100,  0.035,   0.3, 0.01,  1.2, 0.12, 2.0, 0.80, 0.25, 0.22, 1.2, 0.4); // Rubber
mat_def(18, 3,     700,   0.03,    0.3, 0.03,  4.0, 0.2,  3.0, 0.86, 0.82, 0.72, 1.2, 0.15);// Paper
mat_def(19, 0.00005, 1050, 0.045,  0.2, 0.05,  1.2, 0.05, 6.0, 0.95, 0.25, 0.45, 1.0, 1);  // Jelly

// From Reverberator's objects: PVC pipe, toilet roll tube (cardboard), foil,
// cling film (polyethylene), corrugated tin roof, car body panel, chain link
// fence, handpan. The lossiest are made less lossy than the real thing (PVC
// 0.03, cardboard 0.06, leather 0.06, film 0.12 in Reverberator) so that they
// can still be played.
mat_def(20, 2.3,   1050,  0.01,    0.3, 0.005, 1.0, 0.4,  2.0, 0.20, 0.55, 0.90, 2.0, 0);   // Plastic (ABS)
mat_def(21, 3,     1400,  0.022,   0.3, 0.003, 1.0, 0.45, 2.0, 0.90, 0.90, 0.86, 2.0, 0);   // PVC
mat_def(22, 12,    650,   0.007,   0.4, 0.02,  1.4, 0.6,  3.0, 0.78, 0.58, 0.36, 3, 0);     // Wood (maple)
mat_def(23, 0.1,   900,   0.04,    0.3, 0.02,  2.0, 0.2,  3.0, 0.48, 0.30, 0.17, 1.2, 0.1); // Leather
mat_def(24, 3,     700,   0.04,    0.3, 0.03,  4.0, 0.25, 3.0, 0.70, 0.54, 0.36, 1.2, 0);   // Cardboard
mat_def(25, 69,    2700,  0.02,    0.2, 0.05,  1.5, 0.6,  1.0, 0.86, 0.88, 0.91, 1.5, 0);   // Foil (crumpled aluminium)
mat_def(26, 0.2,   920,   0.05,    0.3, 0.01,  1.5, 0.1,  4.0, 0.82, 0.92, 0.96, 1.0, 0.3); // Cling film
mat_def(27, 207,   7850,  0.004,   0.1, 0.03,  1.2, 0.9,  1.0, 0.64, 0.68, 0.70, 3, 0);     // Tin (galvanised roof sheet)
mat_def(28, 207,   7850,  0.003,   0.1, 0.01,  1.0, 0.9,  1.0, 0.78, 0.12, 0.15, 2.5, 0);   // Car panel (painted steel)
mat_def(29, 200,   7850,  0.0015,  0.1, 0.03,  1.0, 1.0,  1.0, 0.62, 0.68, 0.62, 4, 0);     // Chain link (steel wire mesh)
mat_def(30, 207,   7850,  0.0022,  0.1, 0.001, 1.0, 1.0,  1.0, 0.36, 0.38, 0.44, 8, 0);     // Handpan steel (nitrided)
MAT_TAB[25*MAT_STRIDE + M_CRK] = 1;                 // foil crinkles
MAT_TAB[26*MAT_STRIDE + M_RAT] = 1;                 // film slaps and buzzes (a kazoo)
MAT_TAB[27*MAT_STRIDE + M_RAT] = 0.7;               // loose roofing fixings
MAT_TAB[28*MAT_STRIDE + M_RAT] = 0.3;               // panel clank
MAT_TAB[29*MAT_STRIDE + M_RAT] = 1;                 // fence links jangle

function mat(m, k) ( MAT_TAB[m*MAT_STRIDE + k]; );

// ---------------------------------------------------------------------------
// Mode tables
// ---------------------------------------------------------------------------
// Circular membrane: Bessel zeros j_mn and their angular order m, sorted
i = 0;
function jz(j, m) ( BESSEL_TAB[i*2] = j; BESSEL_TAB[i*2+1] = m; i += 1; );
jz(2.4048,0); jz(3.8317,1); jz(5.1356,2); jz(5.5201,0); jz(6.3802,3); jz(7.0156,1);
jz(7.5883,4); jz(8.4172,2); jz(8.6537,0); jz(8.7715,5); jz(9.7610,3); jz(9.9361,6);
jz(10.1735,1); jz(11.0647,4); jz(11.0864,7); jz(11.6198,2); jz(11.7915,0); jz(12.2251,8);
jz(12.3386,5); jz(13.0152,3); jz(13.3237,1); jz(13.3543,9); jz(13.5893,6); jz(14.4755,10);
// Free-free bar: beta_n L
BAR_TAB[0] = 4.7300; BAR_TAB[1] = 7.8532; BAR_TAB[2] = 10.9956; BAR_TAB[3] = 14.1372;
BAR_TAB[4] = 17.2788; BAR_TAB[5] = 20.4204; BAR_TAB[6] = 23.5619; BAR_TAB[7] = 26.7035;
// Clamped-free cantilever (a reed or a tine): beta_n L
CANT_TAB[0] = 1.8751; CANT_TAB[1] = 4.6941; CANT_TAB[2] = 7.8548; CANT_TAB[3] = 10.9955;
CANT_TAB[4] = 14.1372; CANT_TAB[5] = 17.2788;
// Simply supported rectangular plate, aspect 1 : 0.73: the 20 lowest (m, n)
i = 0;
i = 0; loop(60, PLATE_TAB[i] = 0; i += 1;);
begin_i = 0; mm_i = 1;
loop(8, nn_i = 1;
  loop(8,
    q = mm_i*mm_i + (nn_i/0.73)^2;
    // insertion sort into the first 20 slots
    k = min(begin_i, 20); j = k;
    while (j > 0 && PLATE_TAB[(j-1)*3] > q) ( j <= 19 ? ( PLATE_TAB[j*3] = PLATE_TAB[(j-1)*3]; PLATE_TAB[j*3+1] = PLATE_TAB[(j-1)*3+1]; PLATE_TAB[j*3+2] = PLATE_TAB[(j-1)*3+2]; ); j -= 1; );
    j < 20 ? ( PLATE_TAB[j*3] = q; PLATE_TAB[j*3+1] = mm_i; PLATE_TAB[j*3+2] = nn_i; );
    begin_i += 1; nn_i += 1;
  );
  mm_i += 1;
);

// ---------------------------------------------------------------------------
// Physics helpers (Reverberator)
// ---------------------------------------------------------------------------
// T60 of a mode of material m at frequency f: sigma = pi f eta, T60 = 2.2/(f eta),
// capped by the losses eta does not describe (mounting, air).
//
// Age: rust, cracks and tired joints add loss (more of it at high
// frequencies, as a corroded or cracked surface rubs), and shorten the
// longest ring the mounting allows.
function age_eta(f) ( 1 + age_*age_*(AGE_ETA + AGE_ETA_HF*max(0, f/2000)); );
function mat_t60(m, f) local(p, eta)
(
  p = MAT_TAB + m*MAT_STRIDE;
  eta = p[2]*(max(f, 20)/1000)^p[3]*age_eta(f);
  1/((1 + AGE_TMAX*age_)/p[11] + f*eta/2.2);
);

function gd1(w, a) ( (1 - a*a)/(1 + 2*a*cos(w) + a*a); );
function ph1(w, a) ( w - 2*atan(a*sin(w)/(1 + a*cos(w))); );
function phlp(w, p) ( atan2(p*sin(w), 1 - p*cos(w)); );
// phase lag of y = (1-k) x + k lowpass(x), the tone-hole shelf
function phshelf(w, c, k) local(p, dd, re, im)
(
  p = 1 - c; dd = 1 - 2*p*cos(w) + p*p;
  re = (1 - k) + k*c*(1 - p*cos(w))/dd; im = k*c*p*sin(w)/dd;
  atan2(im, re);
);
// phase lag of the DC blocker (1 - z^-1)/(1 - R z^-1); negative = a lead
function phdc(w, rr) ( atan2(rr*sin(w), 1 - rr*cos(w)) - 0.5*($pi - w); );

// Fit a one-pole lowpass to per-pass gains ga (DC) and gb (at wb).
function op_fit(ga, gb, wb) local(r2, cb, aa, bb, disc)
(
  ga = min(ga, 0.9999995); gb = min(gb, ga);
  r2 = (gb/ga)^2;
  r2 > 0.999999 ? ( op_p = 0; op_b = ga; ) : (
    cb = cos(wb); aa = 1 - r2; bb = 1 - r2*cb;
    disc = max(0, bb*bb - aa*aa);
    op_p = max(0, min(0.9995, (bb - sqrt(disc))/aa));
    op_b = ga*(1 - op_p);
  );
);

// The same one-pole fitted at the fundamental (wa) instead of DC, so a strong
// high-frequency loss cannot eat into the note itself. The DC gain it
// implies is capped below one, which is what keeps the loop stable.
function op_fit2(ga, wa, gb, wb) local(r2, ca, cb, aa, bb, disc)
(
  ga = min(ga, 0.9999995); gb = min(gb, ga);
  r2 = (gb/ga)^2;
  r2 > 0.999999 ? ( op_p = 0; op_b = ga; ) : (
    ca = cos(wa); cb = cos(wb); aa = 1 - r2; bb = ca - r2*cb;
    disc = max(0, bb*bb - aa*aa);
    op_p = max(0, min(0.95, (bb - sqrt(disc))/aa));
    op_b = ga*sqrt(1 - 2*op_p*ca + op_p*op_p);
    op_b = min(op_b, 0.9999995*(1 - op_p));
  );
);

function disp_diff(a) ( dd_m*(gd1(dd_wa, a) - gd1(dd_wb, a)); );
disp_lim = -0.9;
function disp_solve(dlt) local(lo, hi, mid)
(
  (dd_m <= 0 || dlt <= 0) ? 0 : (
    lo = disp_lim; hi = 0;
    disp_diff(lo) <= dlt ? lo : (
      loop(40, mid = 0.5*(lo + hi); disp_diff(mid) > dlt ? lo = mid : hi = mid;);
      0.5*(lo + hi);
    );
  );
);

// Kirchhoff boundary-layer attenuation in a tube of radius a (Trombolese)
function tube_alpha(f, a) ( sqrt($pi*f)*BLC/(a*C_AIR); );

function besj(m, x) local(s, t, k, hx)
(
  hx = 0.5*x; t = 1; k = 1;
  loop(m, t *= hx/k; k += 1;);
  s = t; k = 1;
  loop(40, t *= -hx*hx/(k*(k + m)); s += t; k += 1;);
  s;
);

function cosh_(x) ( 0.5*(exp(x) + exp(-x)); );
function sinh_(x) ( 0.5*(exp(x) - exp(-x)); );
// Free-free beam mode shape at x (0..1), magnitude 2 at the ends.
function bar_shape(n, x) local(b, u)
(
  b = BAR_TAB[n]; u = x - 0.5;
  (n & 1) == 0 ? cos(b*u)/cos(0.5*b) + cosh_(b*u)/cosh_(0.5*b)
               : sin(b*u)/sin(0.5*b) + sinh_(b*u)/sinh_(0.5*b);
);
// Clamped-free cantilever mode shape at x (0 = clamp, 1 = free tip), ~2 at the tip.
function cant_shape(n, x) local(b, sg)
(
  b = CANT_TAB[n];
  sg = (cosh_(b) + cos(b))/(sinh_(b) + sin(b));
  cosh_(b*x) - cos(b*x) - sg*(sinh_(b*x) - sin(b*x));
);

function tanh_(x) local(e2) ( x = max(-9, min(9, x)); e2 = exp(2*x); (e2 - 1)/(e2 + 1); );
// deterministic "random" in -1..1 for a seed
function hash1(s) local(x) ( x = sin(s*12.9898 + 78.233)*43758.5453; 2*(x - floor(x)) - 1; );

// RBJ biquads into a 5-slot block: b0 b1 b2 a1 a2
function bq_lp(o, fc, q) local(w, al, cw, a0)
( w = 2*$pi*min(fc, 0.45*srate)/srate; al = sin(w)/(2*q); cw = cos(w); a0 = 1 + al;
  o[0] = (1 - cw)/2/a0; o[1] = (1 - cw)/a0; o[2] = (1 - cw)/2/a0; o[3] = -2*cw/a0; o[4] = (1 - al)/a0; );
function bq_hp(o, fc, q) local(w, al, cw, a0)
( w = 2*$pi*min(fc, 0.45*srate)/srate; al = sin(w)/(2*q); cw = cos(w); a0 = 1 + al;
  o[0] = (1 + cw)/2/a0; o[1] = -(1 + cw)/a0; o[2] = (1 + cw)/2/a0; o[3] = -2*cw/a0; o[4] = (1 - al)/a0; );
function bq_pk(o, fc, q, db) local(w, al, cw, a0, ag)
( w = 2*$pi*min(fc, 0.45*srate)/srate; ag = 10^(db/40); al = sin(w)/(2*q); cw = cos(w); a0 = 1 + al/ag;
  o[0] = (1 + al*ag)/a0; o[1] = -2*cw/a0; o[2] = (1 - al*ag)/a0; o[3] = -2*cw/a0; o[4] = (1 - al/ag)/a0; );
function bq_off(o) ( o[0] = 1; o[1] = o[2] = o[3] = o[4] = 0; );
function bq(o, s, x) local(y)
( y = o[0]*x + o[1]*s[0] + o[2]*s[1] - o[3]*s[2] - o[4]*s[3];
  s[1] = s[0]; s[0] = x; s[3] = s[2]; s[2] = y; y; );

// 4-point Lagrange fractional read, delay d >= 2 samples (the sample written
// last is delay 1).
function lag_read(buf, wp, d) local(n0, fr, i0, x0, x1, x2, x3, d1, d2, d3)
(
  n0 = floor(d) - 1; fr = d - n0;
  i0 = (wp - n0 + LINE_LEN) & LINE_MASK;
  x0 = buf[i0]; x1 = buf[(i0 - 1 + LINE_LEN) & LINE_MASK];
  x2 = buf[(i0 - 2 + LINE_LEN) & LINE_MASK]; x3 = buf[(i0 - 3 + LINE_LEN) & LINE_MASK];
  d1 = fr - 1; d2 = fr - 2; d3 = fr - 3;
  -d1*d2*d3*(1/6)*x0 + fr*d2*d3*0.5*x1 - fr*d1*d3*0.5*x2 + fr*d1*d2*(1/6)*x3;
);
function lin_read(buf, wp, d) local(n0, fr)
(
  n0 = floor(d); fr = d - n0;
  (1 - fr)*buf[(wp - n0 + LINE_LEN) & LINE_MASK] + fr*buf[(wp - n0 - 1 + LINE_LEN) & LINE_MASK];
);

// ---------------------------------------------------------------------------
// Part parameters, derived from the sliders
// ---------------------------------------------------------------------------
function energy_params(en)
(
  // ep_sus: steady supply; ep_att/ep_rel: how fast it arrives and stops;
  // ep_noise: turbulence/rosin grain; ep_rate: strikes per second when a
  // steady supply drives a striking exciter; ep_width: contact softness;
  // ep_vexp: velocity response; ep_dec: how long a single burst lasts when
  // it drives a sustaining exciter.
  en == 0 ? ( ep_sus = 1; ep_att = 0.035; ep_rel = 0.06;  ep_noise = 0.035; ep_rate = 11; ep_jit = 0.25; ep_width = 1.3;  ep_vexp = 1.0; ep_dec = 0.4; ) :
  en == 1 ? ( ep_sus = 1; ep_att = 0.08;  ep_rel = 0.10;  ep_noise = 0.025; ep_rate = 15; ep_jit = 0.45; ep_width = 1.0;  ep_vexp = 1.0; ep_dec = 0.4; ) :
  en == 2 ? ( ep_sus = 0; ep_att = 0.004; ep_rel = 0.05;  ep_noise = 0.01; ep_rate = 0;  ep_jit = 0;    ep_width = 2.2;  ep_vexp = 1.3; ep_dec = 0.5; ep_hold = 0.15; ) :
  en == 3 ? ( ep_sus = 0; ep_att = 0.0015; ep_rel = 0.05; ep_noise = 0.02; ep_rate = 0;  ep_jit = 0;    ep_width = 0.55; ep_vexp = 1.2; ep_dec = 0.35; ep_hold = 0.1; ) :
  en == 4 ? ( ep_sus = 0; ep_att = 0.0008; ep_rel = 0.05; ep_noise = 0.01; ep_rate = 0;  ep_jit = 0;    ep_width = 0.8;  ep_vexp = 1.8; ep_dec = 0.25; ep_hold = 0.06; ) :
            ( ep_sus = 1; ep_att = 0.003; ep_rel = 0.012; ep_noise = 0;    ep_rate = 25; ep_jit = 0;    ep_width = 0.6;  ep_vexp = 0.7; ep_dec = 0.4; );
);


// Held-note T60 multiplier from the damping part (what touches the element
// while it plays), per frequency.
function damp_mul(f)
(
  dm_type == 1 ? 1/(1 + f/2500) :                 // mute
  dm_type == 2 ? 1/(1 + f/1500) :                 // palm (and capped below)
  dm_type == 3 ? 1/sqrt(1 + (f/600)^2) :          // felt
  dm_type == 4 ? 1/(1 + f/1200) : 1;              // hand
);
// Brightness: lets highs ring longer (+) or die faster (-), full effect by 4 kHz
function bright_mul(f) local(x) ( x = log(max(f, 1)/500)/log(8); bm^max(0, min(1, x)); );
// Tone holes: harmonics above the lattice's cutoff leak out of the holes.
function hole_mul(f) local(x) ( fc_type == 1 ? ( x = f/max(1500, 2.2*cur_f0); max(0.3, 1/(1 + x*x)); ) : 1; );
function held_t60(m, f) local(t)
(
  t = mat_t60(m, f)*decay_*drain*damp_mul(f)*bright_mul(f)*hole_mul(f);
  dm_type == 2 ? t = min(t, 0.35);
  t;
);
function release_t60()
(
  (dm_type == 0 ? 0.12 : dm_type == 1 ? 0.4 : dm_type == 2 ? 0.08 : dm_type == 3 ? 0.3 : 0.2)
    *(md_type == 1 ? 1 + 19*mw : 1);
);

// Tuning mechanism: a fixed per-note offset in cents.
function tuning_cents(note) local(d)
(
  tm_type == 0 ? 8*hash1(note) :                              // peg: never quite in tune
  tm_type == 1 ? ( d = (note - 69)/12; 2.2*d*abs(d); ) :      // tuning pin: stretched octaves
  0;                                                          // machine head, slide
);

// Age: an old instrument is out of tune, differently on every note.
function age_detune(note) ( AGE_DET*age_*hash1(note*7.31 + 3); );

// Valve instruments play some notes on valve combinations that are
// famously sharp (1+3, 1+2+3).
function valve_cents(note) local(k) ( k = (note + 2) % 12; k == 5 ? 12 : k == 6 ? 22 : k == 11 ? 6 : 0; );

// ---------------------------------------------------------------------------
// Waveguide elements: string and air column
// ---------------------------------------------------------------------------
function wg_loss(v, tlo, thi) local(ga, gb)
(
  ga = 10^(-3*v[V_TPA]/max(0.002, tlo));
  gb = 10^(-3*v[V_TPB]/max(0.002, thi));
  op_fit2(ga, 2*$pi*v[V_FBASE]/srate, gb, 2*$pi*v[V_FB]/srate);
  v[V_LB] = op_b; v[V_LP] = op_p;
);

function wg_setup(v, f0) local(sl, d, bb, fb, n, ft, ta, tb, tl, rough, a, ga, gb, lo, hi, rad)
(
  v[V_WG] = 1;
  fb = min(5000, 0.4*srate); v[V_FB] = fb;
  el == 0 ? (
    // STRING. Tension sets the pitch; the material's stiffness adds
    // inharmonicity B = pi^2 E d^2 / (64 rho L^4 f0^2). Brittle materials
    // must be thick rods, so they come out stiff and bell-like.
    v[V_TWO] = 1; v[V_SGN] = -1; v[V_LOOPK] = 2; v[V_BETA] = beta_;
    (ex_cont && ex_eff == 1) ? ( v[V_TWO] = 0; v[V_SGN] = 1; v[V_LOOPK] = LIP_LOOPK; v[V_INDC] = 1; );
    (ex_cont && ex_eff == 6) ? ( v[V_TWO] = 0; v[V_SGN] = -1; v[V_LOOPK] = 3; v[V_INDC] = 1; );
    sl = max(0.04, min(2.2, 0.65*2^(-(v[V_NOTE] - 52)/18)));
    d = 0.0008*mat(elm, M_THICK);
    bb = min(0.05, $pi*$pi*mat(elm, M_E)*10^9*d*d/(64*mat(elm, M_RHO)*sl^4*f0*f0));
    ft = min(fb, 0.3*srate);
    n = ft/f0; loop(30, n = 0.5*(n + ft/(f0*sqrt(1 + bb*n*n))););
    n = max(n, 2);
    fb = n*f0*sqrt(1 + bb*n*n); v[V_FB] = fb;
    ta = sqrt(1 + bb)/(f0*(1 + 2*bb)); tb = sqrt(1 + bb*n*n)/(f0*(1 + 2*bb*n*n));
    v[V_TPA] = ta; v[V_TPB] = tb;
    dd_m = 4; dd_wa = 2*$pi*f0*sqrt(1 + bb)/srate; dd_wb = 2*$pi*fb/srate;
    // dispersion budget: the allpasses may take at most 40% of the loop's
    // phase at the fundamental, or a short stiff string has no delay left
    disp_lim = -0.9;
    while (disp_lim < -0.02 && dd_m*ph1(dd_wa, disp_lim) > 0.4*2*$pi) ( disp_lim += 0.02; );
    v[V_APA] = disp_solve((ta - tb)*srate);
    disp_lim = -0.9;
    // a bow's stick-slip corner travels at the group delay of the highs, so
    // dispersion would drag a bowed note sharp: bowed strings stay harmonic
    v[V_APM] = (v[V_APA] < 0 && !(ex_cont && ex_eff == 3) && !DBG_NODISP) ? 4 : 0;
    v[V_TLO] = held_t60(elm, f0); v[V_THI] = held_t60(elm, fb);
  ) : (
    // AIR COLUMN. Boundary-layer loss alpha = sqrt(pi f) BLC / (a c) along
    // the bore, radiation |R| = exp(-(ka)^2/2) at the open end. Rough or
    // floppy walls (paper, rubber, jelly) lose more.
    v[V_TWO] = 0;
    ex_cont ? (
      ex_eff == 0 ? ( v[V_SGN] = -1; v[V_LOOPK] = 1; ) :                                                    // reed: cylinder (clarinet)
      ex_eff == 1 ? ( v[V_SGN] = 1; v[V_LOOPK] = LIP_LOOPK; v[V_INDC] = 1; ) :                              // lips: brass
      ex_eff == 6 ? ( v[V_SGN] = -1; v[V_LOOPK] = 3; v[V_INDC] = 1; ) :                                     // jet: flute, overblown (STK)
                    ( v[V_SGN] = BOWAIR_SGN; v[V_LOOPK] = BOWAIR_K; );                                        // bow
    ) : (
      (cp == 3 || rs == 0) ? ( v[V_SGN] = 1; v[V_LOOPK] = 2; ) : ( v[V_SGN] = -1; v[V_LOOPK] = 1; );
    );
    rough = min(2.2, mat(elm, M_ROUGH)*(1 + 0.15*min(6, 1/max(mat(elm, M_E), 0.0001))))*(1 + AGE_BORE*age_);
    a = max(0.003, min(0.03, 0.007*(262/f0)^0.3));
    tl = v[V_LOOPK]/(2*f0);
    v[V_TPA] = tl; v[V_TPB] = tl;
    rad = 2*$pi*a/C_AIR;
    ga = exp(-C_AIR*tl*rough*tube_alpha(f0, a))*exp(-0.5*(rad*f0)^2);
    gb = exp(-C_AIR*tl*rough*tube_alpha(fb, a))*exp(-0.5*(rad*fb)^2);
    lo = -6.9078*tl/log(min(ga, 0.999999));
    hi = -6.9078*tl/log(max(0.000001, min(gb, 0.999999)));
    v[V_TLO] = lo*decay_*drain*damp_mul(f0);
    v[V_THI] = min(v[V_TLO], hi*decay_*drain*damp_mul(fb)*bright_mul(fb)*hole_mul(fb));
    dm_type == 2 ? ( v[V_TLO] = min(v[V_TLO], 0.35); v[V_THI] = min(v[V_THI], 0.35); );
  );
  wg_loss(v, v[V_TLO], v[V_THI]);
  v[V_THC] = 0;
);

// ---------------------------------------------------------------------------
// Modal elements: membrane, bar, plate, reed (tine)
// ---------------------------------------------------------------------------
mode_n = 0;
function mode_put(v, f, wc, wr, t60, nn) local(m, r, th)
(
  (f < min(0.45*srate, 18000) && mode_n < MODES_MAX) ? (
    m = v + MODE_OFF + mode_n*MODE_STRIDE;
    r = exp(-6.907755/(max(0.003, t60)*srate)); r = min(r, 0.9999995);
    th = 2*$pi*f/srate;
    m[0] = 2*r*cos(th); m[1] = r*r; m[2] = 0; m[3] = 0;
    m[4] = wc/nn; m[5] = wc; m[6] = wr; m[7] = f;
    mode_n += 1;
  );
);

function modal_mode(v, f, wc, wr, nn, extra) local(irr, t)
(
  t = held_t60(elm, f)*extra;
  mode_put(v, f, wc, wr, t, nn);
  irr = mat(elm, M_IRR) + AGE_IRR*age_;
  // grain, cracks and bubbles split each mode into a beating pair
  // (buzzing lips cannot choose between two near-equal resonances, so they get one)
  (irr > 0.004 && !(ex_cont && ex_eff == 1)) ? mode_put(v, f*(1 + irr*(0.6 + 0.4*hash1(f))), 0.6*wc, 0.6*wr, t*0.8, nn);
);

function modal_setup(v, f0) local(nn, k, x, y, r, j, m, st, f, wc, wr, extra, x2)
(
  v[V_WG] = 0; mode_n = 0;
  nn = srate/f0;
  x = beta_;
  el == 1 ? (
    // MEMBRANE. Ideal circular membrane: f_mn = f01 j_mn / j01, with a
    // stiffness stretch for stiff materials. Struck at radius r: near the
    // edge rings, the centre thuds. The (0,1) mode radiates hard and dies fast.
    r = max(0, 0.95 - 1.8*x);
    st = min(0.03, mat(elm, M_E)*0.0003);
    k = 0;
    loop(16,
      j = BESSEL_TAB[k*2]; m = BESSEL_TAB[k*2+1];
      f = f0*(j/2.4048)*sqrt(1 + st*(j/2.4048)^2);
      wc = besj(m, j*r)*(m > 0 ? cos(m*0.7) : 1)*1.7;
      wr = besj(m, j*0.35)*cos(m*1.9)*1.7 + (m == 0 ? 0.4 : 0);
      extra = k == 0 ? 0.35 : 1;
      modal_mode(v, f, wc, wr, nn, extra);
      k += 1;
    );
  ) : el == 2 ? (
    // BAR. Free-free beam (xylophone, glockenspiel): 1 : 2.76 : 5.40 : 8.93 ...
    // Struck at x from the end; at the middle the odd (antisymmetric) modes vanish.
    k = 0;
    loop(8,
      f = f0*(BAR_TAB[k]/4.73)^2;
      wc = 0.5*bar_shape(k, 0.5 - 0.6*x);
      wr = 0.5*bar_shape(k, 0.12);
      modal_mode(v, f, wc, wr, nn, 1);
      k += 1;
    );
  ) : el == 3 ? (
    // PLATE. Simply supported rectangle: f_mn ~ m^2 + (n/0.73)^2 (a gong-ish
    // or bell-plate spectrum, dense and inharmonic).
    x = 0.5 - 0.8*beta_; y = 0.5 - 0.7*beta_;
    k = 0;
    loop(20,
      f = f0*PLATE_TAB[k*3]/PLATE_TAB[0];
      m = PLATE_TAB[k*3+1]; j = PLATE_TAB[k*3+2];
      wc = sin(m*$pi*x)*sin(j*$pi*y);
      wr = sin(m*$pi*0.77)*sin(j*$pi*0.31);
      modal_mode(v, f, wc, wr, nn, 1);
      k += 1;
    );
  ) : (
    // REED / TINE. Clamped-free cantilever (kalimba, music box, free reed):
    // 1 : 6.27 : 17.5 : 34.4 ... plucked near the tip by default.
    x2 = 1 - x;
    k = 0;
    loop(6,
      f = f0*(CANT_TAB[k]/1.8751)^2;
      wc = 0.5*cant_shape(k, x2);
      wr = 0.5*cant_shape(k, 1);
      modal_mode(v, f, wc, wr, nn, 1);
      k += 1;
    );
    v[V_CHOP] = ex_cont;
  );
  v[V_NM] = mode_n;
);

function modal_release(v, trel) local(m, r, rn, t)
(
  m = v + MODE_OFF;
  loop(v[V_NM],
    r = sqrt(m[1]);
    t = m[7] > 4*v[V_FBASE] ? 0.6*trel : trel;
    rn = exp(-6.907755/(max(0.003, t)*srate));
    rn < r ? ( m[0] *= rn/r; m[1] = rn*rn; );
    m += MODE_STRIDE;
  );
);

// Banded waveguides (Essl & Cook, STK BandedWG): when a sustaining exciter
// (bow, reed, lips, jet) drives a bar, membrane, plate or tine, each mode
// becomes its own delay loop one period long with a bandpass inside. That
// gives the exciter travelling waves to scatter, which is what the
// reflection-function exciters need; a plain resonator bank has none.
// Descriptors live in line B, the loops' delays in line A.
function band_tune(bd, f) local(th, rr)
(
  f = min(f, 0.45*srate);
  bd[3] = max(2, min(bd[1] - 3, srate/f));
  th = 2*$pi*f/srate;
  rr = bd[15];
  bd[6] = -2*rr*cos(th); bd[7] = rr*rr;
);
function bands_setup(v) local(m, bd, k, buf, len, f, r, t60, ww)
(
  m = v + MODE_OFF; bd = v[V_LBASE] + LINE_LEN; buf = v[V_LBASE];
  k = 0; ww = 0;
  loop(v[V_NM],
    f = m[7]; r = sqrt(m[1]);
    t60 = -6.907755/(srate*log(r));
    // a sustaining exciter needs something to push against: very lossy
    // materials (leather, film, cardboard) get a minimum ring while driven
    t60 = max(t60, BAND_T60_MIN*(v[V_FBASE]/f)^0.5);
    len = ceil(2*srate/f) + 6;
    (buf + len < v[V_LBASE] + LINE_LEN) ? (
      bd[0] = buf; bd[1] = len; bd[2] = 0; buf += len;
      bd[4] = 10^(-3/(f*t60));
      bd[15] = exp(-$pi*max(8, 0.25*f)/srate);
      bd[5] = 0.5*(1 - bd[15]*bd[15]);
      bd[8] = bd[9] = bd[10] = bd[11] = bd[16] = 0;
      // a bow, a lip or a jet touches a patch, not a point: high modes average out
      bd[12] = m[5]*(v[V_FBASE]/f)^BAND_GAMMA; bd[13] = m[6]; bd[14] = f;
      band_tune(bd, f);
      ww += bd[12]*bd[12];
      bd += BAND_STRIDE; k += 1;
    );
    m += MODE_STRIDE;
  );
  v[V_NB] = k; v[V_BANDED] = 1;
  v[V_EG] = 1/max(0.05, ww);
);
function bands_release(v, trel) local(bd, g)
(
  bd = v[V_LBASE] + LINE_LEN;
  loop(v[V_NB],
    g = 10^(-3/(bd[14]*(bd[14] > 4*v[V_FBASE] ? 0.6*trel : trel)));
    bd[4] = min(bd[4], g);
    bd += BAND_STRIDE;
  );
);

// ---------------------------------------------------------------------------
// Per-voice pitch and control-rate update (every 16 samples)
// ---------------------------------------------------------------------------
function voice_pitch(v) local(p)
(
  p = v[V_PITCH] + v[V_DETC]/100 + v[V_SETL]/100 + fine_st + bend*bend_range + mod_st + v[V_WOB];
  tm_type == 0 ? p += 0.03*sin(0.8*t_now + v[V_NOTE]);
  // age: a slow, uneven wander in pitch
  p += AGE_WOW*age_*age_*(sin(0.43*t_now + 1.7*v[V_NOTE]) + 0.5*sin(1.9*t_now + v[V_NOTE]));
  440*2^((p - 69)/12);
);

function voice_control(v) local(f, w, ph, dd, db, ratio, m, th, r, wob)
(
  v[V_PITCH] += (v[V_PTGT] - v[V_PITCH])*glide_c;
  v[V_SETL] *= settle_c;
  wob = mat(elm, M_WOB);
  wob > 0 ? v[V_WOB] = wob*(0.6*min(1, 3*v[V_LVLF]) + 0.25*sin(2.3*t_now + v[V_NOTE]))*0.5;
  f = voice_pitch(v);
  v[V_FCUR] = f;
  w = 2*$pi*f*v[V_FK]/srate;
  v[V_WG] ? (
    ph = phlp(w, v[V_LP]) + v[V_APM]*ph1(w, v[V_APA]);
    v[V_THC] > 0 ? ph += phshelf(w, v[V_THC], TH_K);
    v[V_INDC] ? ph += phdc(w, dc_r);
    dd = (v[V_LOOPK]*$pi - ph)/w;
    dd = max(4, min(LINE_LEN - 8, dd));
    v[V_TWO] ? (
      db = floor((1 - v[V_BETA])*dd);
      (v[V_DB] < 1 || abs(db - v[V_DB]) > 2 || dd - v[V_DB] < 2.5) ? v[V_DB] = floor(max(1, min(db, dd - 2.5)));
      v[V_DA] = dd - v[V_DB];
    ) : v[V_DA] = dd;
    v[V_DJ] = max(2.5, 0.32*dd);
  ) : v[V_BANDED] ? (
    abs(f/v[V_FMOD] - 1) > 0.00001 ? (
      ratio = f/v[V_FBASE];
      m = v[V_LBASE] + LINE_LEN;
      ratio *= v[V_FK];
      loop(v[V_NB], band_tune(m, m[14]*ratio); m += BAND_STRIDE;);
      v[V_FMOD] = f;
    );
    v[V_DJ] = max(2.5, 0.32*srate/f);
  ) : (
    abs(f/v[V_FMOD] - 1) > 0.00001 ? (
      ratio = f/v[V_FBASE];
      m = v + MODE_OFF;
      loop(v[V_NM],
        th = 2*$pi*min(m[7]*ratio, 0.49*srate)/srate;
        m[0] = 2*sqrt(m[1])*cos(th);
        m += MODE_STRIDE;
      );
      v[V_FMOD] = f;
    );
    v[V_DJ] = max(2.5, 0.32*srate/f);
  );
  v[V_XT] == 1 ? (
    // lip resonance follows the note (the embouchure); A1 = w/Q, A2 = w^2
    th = 2*$pi*min(f*v[V_LIPR]*(v[V_BANDED] ? v[V_FK] : 1), 0.3*srate);
    v[V_LIPA1] = th/LIP_Q; v[V_LIPA2] = th*th; v[V_LIPIM] = th*th*LIP_REST/LIP_CLOSE;
  );
  v[V_NRES] ? (
    // per-voice resonator: a bore (all harmonics) or a stopped pipe (odd ones)
    ph = phlp(w, v[V_RLP]);
    v[V_DR] = max(2, min(LINE_LEN - 4, (v[V_RES_K]*$pi - ph)/w));
  );
);

// ---------------------------------------------------------------------------
// Voices
// ---------------------------------------------------------------------------
function start_pulse(v, amp) local(dur, hard)
(
  hard = max(0.05, mat(elm, M_HARD));
  dur = (ex == 2 ? 0.0009 : ex == 4 ? 0.0014 : 0.004)*ep_width*(1.3 - 0.6*v[V_VEL])/sqrt(hard);
  dm_type == 3 ? dur *= 2;
  v[V_PDUR] = max(3, min(0.02, dur)*srate);
  v[V_PT] = 0; v[V_PA] = amp;
  ex == 4 ? v[V_PLKN] = floor(0.002*srate);
);

function voice_start(v, note, vel) local(vi, vn, f0, rlo, rhi, tl, gr, rm, lg2, pc)
(
  vi = (v - VOICE_BASE)/VOICE_STRIDE;
  memset(v, 0, VOICE_STRIDE);
  memset(LINE_BASE + vi*4*LINE_LEN, 0, 4*LINE_LEN);
  v[V_LBASE] = LINE_BASE + vi*4*LINE_LEN;
  v[V_EG] = 1;
  v[V_ON] = 1; v[V_NOTE] = note; v[V_GATE] = 1; v[V_AGE] = age_ctr; age_ctr += 1;
  v[V_REL] = -1; v[V_PT] = -1;
  vn = max(0.05, vel/127);
  v[V_VEL] = vn;
  v[V_LEVEL] = max(0.02, force*vn^ep_vexp)*(soft_ped ? 0.6 : 1);
  v[V_DETC] = tuning_cents(note) + (fc_type == 2 ? valve_cents(note) : 0) + (dm_type == 4 ? -15 : 0) + age_detune(note);
  v[V_PTGT] = note;
  v[V_PITCH] = (fc_type == 3 && last_pitch > 0) ? last_pitch : note;
  tm_type == 3 ? v[V_SETL] = -30;
  last_pitch = note;
  f0 = 440*2^((note + v[V_DETC]/100 + fine_st - 69)/12);
  cur_f0 = f0;
  v[V_FBASE] = f0; v[V_FCUR] = f0; v[V_FMOD] = f0;
  (el == 0 || el == 5) ? wg_setup(v, f0) : ( modal_setup(v, f0); (ex_cont || DEBUG_BANDED) ? bands_setup(v); );
  v[V_XT] = ex_eff; v[V_CONT] = ex_cont;
  v[V_SUSDRV] = ep_sus;
  !ex_cont ? (
    ep_sus ? v[V_STRK] = 0 : start_pulse(v, v[V_LEVEL]);
  );
  // per-voice resonator: bore or pipe, tuned to the note
  v[V_NRES] = (rs == 0 || rs == 2);
  v[V_NRES] ? (
    rm = rsm;
    v[V_RES_K] = rs == 0 ? 2 : 1;
    v[V_RSGN] = rs == 0 ? 1 : -1;
    tl = v[V_RES_K]/(2*f0);
    rlo = min(mat_t60(rm, f0), 0.5)*decay_*0.6/mat(rm, M_ROUGH);
    rhi = rlo*0.4*bright_mul(4000);
    op_fit(10^(-3*tl/rlo), 10^(-3*tl/rhi), 2*$pi*min(4000, 0.4*srate)/srate);
    v[V_RLB] = op_b; v[V_RLP] = op_p;
    gr = op_b/(1 - op_p);
    v[V_RG] = gr;
  );
  v[V_OG] = 10^(TRIM_TAB[(ep_sus ? 0 : 36) + ex*6 + el]/20);
  v[V_LIPY] = LIP_REST;
  v[V_FK] = (ex_eff == 1 && v[V_WG]) ? LIP_BORE : 1;
  // lips pull the pitch up by a measured amount on each element: lower the
  // lips and the element together by that much
  v[V_LIPR] = LIP_RATIO;
  (ex_eff == 1 && v[V_BANDED]) ? v[V_FK] = 2^(-(el == 1 ? LM_SOFT - (LM_SOFT - 50)*max(0, min(1, (min(0.03, mat(elm, M_E)*0.0003) - LM_EDGE)/0.009)) : el == 2 ? LIPC_BAR : el == 3 ? LIPC_PLATE : LIPC_TINE)/1200);
  // measured pull of the sustaining exciters on the loop's pitch (cents),
  // taken out by tuning the loop flat by the same amount
  v[V_WG] ? (
    lg2 = log(f0/261.6)/log(2);
    pc = ex_eff == 6 ? max(0, min(26, JET_C0 + JET_C1*lg2)) :
         (ex_eff == 3 && el == 0) ? max(0, min(15, BOW_C0 + BOW_C1*lg2)) : 0;
    v[V_FK] *= 2^(-pc/1200);
  );
  v[V_BANDED] ? v[V_FMOD] = 0;
  pn = 0.5 + 0.3*max(-1, min(1, (note - 60)/30));
  v[V_PANL] = cos(pn*0.5*$pi)*1.4142; v[V_PANR] = sin(pn*0.5*$pi)*1.4142;
  voice_control(v);
);

function voice_release(v) local(tr)
(
  v[V_REL] = 0;
  tr = release_t60();
  v[V_WG] ? (
    wg_loss(v, min(v[V_TLO], tr), min(v[V_THI], 0.6*tr));
  ) : v[V_BANDED] ? bands_release(v, tr) : modal_release(v, tr);
);

function find_voice() local(i, v, best, bv, sc)
(
  best = -1; bv = 10^30; i = 0;
  loop(VOICES_MAX,
    v = VOICE_BASE + i*VOICE_STRIDE;
    // free first, then the quietest released voice, then the oldest
    sc = !v[V_ON] ? -10^20 : (v[V_REL] >= 0 ? -10^10 + v[V_LVLF]*10^9 : v[V_AGE]);
    sc < bv ? ( bv = sc; best = v; );
    i += 1;
  );
  best;
);

function note_on(note, vel) local(v, lg)
(
  mono ? (
    v = VOICE_BASE;
    lg = v[V_ON] && v[V_GATE] && fc_type != 4;
    NOTE_STACK[stack_n] = note; stack_n = min(stack_n + 1, 60);
    lg ? (
      // legato: the frequency control decides how the pitch changes
      v[V_PTGT] = note; last_pitch = note;
      v[V_NOTE] = note;
      fc_type != 3 ? v[V_PITCH] = note;
      v[V_DETC] = tuning_cents(note) + (fc_type == 2 ? valve_cents(note) : 0) + (dm_type == 4 ? -15 : 0) + age_detune(note);
      fc_type == 1 ? v[V_DIP] = 0.012*srate;          // tone holes: a quick blip
      fc_type == 2 ? v[V_DIP] = 0.028*srate;          // valves: a deeper, longer one
      (fc_type == 0 && !ex_cont) ? start_pulse(v, 0.35*v[V_LEVEL]);   // fret: hammer-on
    ) : voice_start(v, note, vel);
  ) : (
    v = find_voice();
    voice_start(v, note, vel);
  );
);

function note_off(note) local(i, v, k, j)
(
  mono ? (
    // remove from the held-note stack; fall back to the previous note
    j = 0; k = 0;
    loop(stack_n, NOTE_STACK[k] != note ? ( NOTE_STACK[j] = NOTE_STACK[k]; j += 1; ); k += 1;);
    stack_n = j;
    v = VOICE_BASE;
    (v[V_ON] && v[V_NOTE] == note) ? (
      (stack_n > 0 && fc_type != 4) ? (
        k = NOTE_STACK[stack_n - 1];
        v[V_PTGT] = k; v[V_NOTE] = k; fc_type != 3 ? v[V_PITCH] = k;
        v[V_DETC] = tuning_cents(k) + (fc_type == 2 ? valve_cents(k) : 0) + (dm_type == 4 ? -15 : 0);
        fc_type == 1 ? v[V_DIP] = 0.012*srate; fc_type == 2 ? v[V_DIP] = 0.028*srate;
      ) : (
        v[V_GATE] = 0;
        sustain ? v[V_HELD] = 1 : voice_release(v);
      );
    );
  ) : (
    i = 0;
    loop(VOICES_MAX,
      v = VOICE_BASE + i*VOICE_STRIDE;
      (v[V_ON] && v[V_GATE] && v[V_NOTE] == note) ? (
        v[V_GATE] = 0;
        sustain ? v[V_HELD] = 1 : voice_release(v);
      );
      i += 1;
    );
  );
);

function all_off() local(i, v)
( i = 0; loop(VOICES_MAX, v = VOICE_BASE + i*VOICE_STRIDE; v[V_ON] = 0; i += 1;); stack_n = 0; );

function pedal_up() local(i, v)
(
  i = 0;
  loop(VOICES_MAX,
    v = VOICE_BASE + i*VOICE_STRIDE;
    (v[V_ON] && v[V_HELD]) ? ( v[V_HELD] = 0; voice_release(v); );
    i += 1;
  );
);

// ---------------------------------------------------------------------------
// The exciter: what touches the element. c is the element's motion at the
// contact point; the return value is what the exciter pushes back in.
// Sustaining exciters follow STK's reflection-function forms (clarinet reed,
// brass lips, bowed string, flute jet), which stay passive at any pressure.
// ---------------------------------------------------------------------------
function excite(v, c) local(xt, pp, e, pd, rr, inc, area, kq, flow, dp, acc, dv, bs, jin, jo, bj, x)
(
  xt = v[V_XT]; e = 0;
  v[V_CONT] ? (
    pp = v[V_DRV];
    xt == 0 ? (
      pd = c - pp;
      rr = max(-1, min(1, 0.7 - 0.3*pd));
      e = (pp - c)*(1 - rr);
    ) : xt == 1 ? (
      // Trombolese's lip valve: a mass-spring that blows open, Bernoulli
      // flow through it, solved exactly against the bore impedance.
      inc = pp - 2*c*PSCALE;
      area = LIP_WIDTH*max(v[V_LIPY], 0);
      kq = 2*area*area/RHO_AIR;
      flow = area > 0 ? 0.5*(-kq*LIP_Z + sqrt((kq*LIP_Z)^2 + 4*kq*abs(inc)))*sign(inc) : 0;
      dp = inc - LIP_Z*flow;
      acc = dp*v[V_LIPIM] - v[V_LIPA1]*v[V_LIPV] - v[V_LIPA2]*(v[V_LIPY] - LIP_REST);
      v[V_LIPV] += acc*dt; v[V_LIPY] += v[V_LIPV]*dt;
      v[V_LIPY] < 0 ? ( v[V_LIPY] = 0; v[V_LIPV] = max(0, v[V_LIPV]); );
      v[V_LIPY] > 3*LIP_REST ? ( v[V_LIPY] = 3*LIP_REST; v[V_LIPV] = min(0, v[V_LIPV]); );
      e = LIP_Z*flow/PSCALE;
    ) : xt == 3 ? (
      dv = pp - c;
      // Schelleng: nearer the bridge the bow must press harder (a lower slope)
      bs = abs((dv + 0.001)*(v[V_BANDED] ? BOW_SLOPE_B : BOW_SLOPE*(v[V_TWO] ? (max(0.02, v[V_BETA])/0.2)^BOW_FEXP : BOW_TUBE))) + 0.75;
      bs = bs*bs; bs = 1/(bs*bs);
      e = dv*max(0.01, min(0.98, bs));
    ) : (
      bj = v[V_LBASE] + 2*LINE_LEN;
      jin = pp - 0.5*c;
      jo = lin_read(bj, v[V_WP], v[V_DJ]);
      bj[v[V_WP]] = jin;
      e = max(-1, min(1, jo*(jo*jo - 1))) - 0.5*c;
    );
  ) : (
    v[V_PT] >= 0 ? (
      x = v[V_PT]/v[V_PDUR];
      x < 1 ? (
        e = xt == 4 ? v[V_PA]*x : v[V_PA]*sin($pi*x);
        v[V_PT] += 1;
      ) : v[V_PT] = -1;
    );
    xt == 5 ? ( v[V_XLP] += mallet_c*(e - v[V_XLP]); e = v[V_XLP]*1.5; );
    (xt == 4 && v[V_PLKN] > 0) ? ( e += (rand(2) - 1)*0.15*v[V_PA]; v[V_PLKN] -= 1; );
  );
  e;
);

// One sample of one voice. Leaves its direct and resonated output in
// vo_dir and vo_res.
function voice_tick(v) local(tgt, env, lvl, pp, nz, ba, bb, wp, aout, y, mm, aa, s, r1, r2, c, e, outa, out, m, cc, oo, ex2, br, rdl, res, t, ns, n0, fr, ri, rj, x, bk)
(
  t = v[V_T]; v[V_T] = t + dt;
  // --- energy: the drive envelope
  v[V_SUSDRV] ? (
    tgt = (v[V_GATE] || v[V_HELD]) ? 1 : 0;
    v[V_ENV] += (tgt - v[V_ENV])*(tgt > v[V_ENV] ? att_c : rel_c);
  ) : (
    // a single push: rises, holds briefly, then fades
    v[V_ENV] = t < ep_att ? t/ep_att : t < ep_att + ep_hold ? 1 : exp(-(t - ep_att - ep_hold)/ep_dec);
  );
  env = v[V_ENV];
  lvl = v[V_LEVEL]*expr*(1 + 0.4*at_press + (md_type == 0 ? 0.3*mw : 0));
  v[V_DIP] > 0 ? ( env *= 1 - 0.6*sin($pi*v[V_DIP]/(fc_type == 2 ? 0.028*srate : 0.012*srate)); v[V_DIP] -= 1; );
  nz = rand(2) - 1;
  v[V_CONT] ? (
    pp = v[V_XT] == 0 ? 0.6 + 0.3*lvl :
         v[V_XT] == 1 ? 1500 + 4500*lvl :
         v[V_XT] == 3 ? 0.03 + 0.2*lvl :
                        1.0 + 0.25*lvl;
    pp *= env;
    pp += pp*nz*(ep_noise + (cp == 3 ? 0.02 : 0) + AGE_LEAK*age_);
    v[V_DRV] = pp; v[V_DRVN] = env*lvl;
  ) : (
    // a steady supply keeps striking: a roll, a tremolo, a buzzer
    (v[V_SUSDRV] && env > 0.02) ? (
      v[V_STRK] -= dt;
      v[V_STRK] <= 0 ? (
        start_pulse(v, lvl*env*(0.85 + 0.3*rand(1)));
        v[V_STRK] = (1 + ep_jit*(rand(2) - 1))/(ep_rate*(0.6 + 0.8*env*lvl));
      );
    );
  );
  wp = v[V_WP];
  // --- the vibrating element
  v[V_WG] ? (
    ba = v[V_LBASE]; bb = ba + LINE_LEN;
    aout = lag_read(ba, wp, v[V_DA]);
    y = v[V_LB]*aout + v[V_LP]*v[V_LS]; v[V_LS] = y;
    mm = v[V_APM];
    mm > 0 ? (
      aa = v[V_APA]; s = v + V_AP;
      loop(mm, e = aa*(y - s[1]) + s[0]; s[0] = y; s[1] = e; y = e; s += 2;);
    );
    v[V_THC] > 0 ? ( v[V_THS] += v[V_THC]*(y - v[V_THS]); y += TH_K*(v[V_THS] - y); );
    r1 = v[V_SGN]*y;
    v[V_TWO] ? ( r2 = -bb[(wp - v[V_DB] + LINE_LEN) & LINE_MASK]; c = r1 + r2; ) : c = r1;
    e = excite(v, c);
    outa = (v[V_TWO] ? r2 : c) + e;
    v[V_INDC] ? ( y = outa - v[V_LDCX] + dc_r*v[V_LDCY]; v[V_LDCX] = outa; v[V_LDCY] = y; outa = y; );
    ba[wp] = outa;
    v[V_TWO] ? bb[wp] = r1 + e;
    out = el == 5 ? aout + r1 : aout;
  ) : v[V_BANDED] ? (
    m = v[V_LBASE] + LINE_LEN; c = 0;
    loop(v[V_NB],
      n0 = floor(m[3]); fr = m[3] - n0; ri = m[2] - n0; ri < 0 ? ri += m[1];
      rj = ri - 1; rj < 0 ? rj += m[1];
      bk = m[0]; y = (1 - fr)*bk[ri] + fr*bk[rj];
      m[16] = y; c += m[12]*y;
      m += BAND_STRIDE;
    );
    // extra grip only while driven, so the junction is passive once released
    e = excite(v, c)*v[V_EG]*(1 + (BAND_G - 1)*min(1, 2*env));
    m = v[V_LBASE] + LINE_LEN; oo = 0;
    loop(v[V_NB],
      x = m[12]*e + m[4]*m[16];
      y = m[5]*(x - m[9]) - m[6]*m[10] - m[7]*m[11];
      m[9] = m[8]; m[8] = x; m[11] = m[10]; m[10] = y;
      bk = m[0]; bk[m[2]] = y; m[2] += 1; m[2] >= m[1] ? m[2] = 0;
      oo += m[13]*y;
      m += BAND_STRIDE;
    );
    out = oo;
    v[V_CHOP] ? out += 0.6*v[V_DRVN]*tanh_(4*c);
  ) : (
    c = v[V_C];
    e = excite(v, v[V_CONT] ? tanh_(c) : c);
    ex2 = e - v[V_E2]; v[V_E2] = v[V_E1]; v[V_E1] = e;
    m = v + MODE_OFF; cc = 0; oo = 0;
    loop(v[V_NM],
      y = m[0]*m[2] - m[1]*m[3] + m[4]*ex2;
      m[3] = m[2]; m[2] = y;
      cc += m[5]*y; oo += m[6]*y;
      m += MODE_STRIDE;
    );
    v[V_C] = cc;
    out = oo;
    // a free reed chops the airflow: the buzz of a harmonica or accordion
    v[V_CHOP] ? out += 0.6*v[V_DRVN]*tanh_(4*cc);
  );
  // DC blocker on what leaves the element
  y = out - v[V_DCX] + dc_r*v[V_DCY]; v[V_DCX] = out; v[V_DCY] = y; out = y;
  // a windway hisses
  // a windway hisses, and so does a leaky old instrument
  ((cp == 3 || age_ > 0) && v[V_CONT]) ? (
    v[V_NS] += 0.3*(nz - v[V_NS]); ns = nz - v[V_NS];
    out += ((cp == 3 ? 0.02 : 0) + AGE_HISS*age_*age_)*ns*v[V_DRVN];
  );
  out *= v[V_OG];
  // rattle: past a small gap the material slaps against its fixings; crackle:
  // crumpled foil pops at random, more often the harder it vibrates. Both
  // only read the element (never feed back into it), so they cannot destabilise it.
  mat_rat > 0 ? (
    x = out - max(-RAT_GAP, min(RAT_GAP, out));
    y = 0.9*(v[V_RATS] + x - v[V_RATX]); v[V_RATX] = x; v[V_RATS] = y;
    out += mat_rat*RAT_GAIN*y;
  );
  mat_crk > 0 ? (
    x = rand(1) < mat_crk*min(1, 8*abs(out))*CRK_RATE ? (rand(2) - 1)*(0.05 + abs(out)) : 0;
    y = 0.6*(v[V_CRKS] + x - v[V_CRKX]); v[V_CRKX] = x; v[V_CRKS] = y;
    out += y;
  );
  // --- per-voice resonator
  res = out;
  v[V_NRES] ? (
    br = v[V_LBASE] + 3*LINE_LEN;
    rdl = lin_read(br, wp, v[V_DR]);
    y = v[V_RLB]*rdl + v[V_RLP]*v[V_RLS]; v[V_RLS] = y;
    res = out + v[V_RSGN]*y;
    br[wp] = res;
    res *= 0.5*(1 - min(0.97, v[V_RG]));
    res *= 2.5;
  );
  v[V_WP] = (wp + 1) & LINE_MASK;
  // --- level follower and voice freeing
  aa = abs(out);
  v[V_LVLF] = max(aa, v[V_LVLF]*lvl_decay);
  (v[V_T] > 0.05 && v[V_LVLF] < 0.00002 && env < 0.002 && v[V_PT] < 0 &&
   (v[V_REL] >= 0 || !v[V_SUSDRV])) ? v[V_ON] = 0;
  vo_dir = out; vo_res = res;
);

// ---------------------------------------------------------------------------
// Coupler, shared resonators and radiator (all voices summed: they are linear)
// ---------------------------------------------------------------------------
function setup_coupler() local(o)
(
  o = BIQ_COEF;
  cp == 0 ? ( bq_pk(o, 2500, 1.2, 6); bq_hp(o + 5, 90, 0.7); ) :             // bridge: the "bridge hill"
  cp == 1 ? ( bq_pk(o, 450, 1.0, 6); bq_lp(o + 5, 7000, 0.7); ) :            // soundpost: body-heavy
  cp == 2 ? ( bq_pk(o, 800/sqrt(size_), 2.0, 8); bq_lp(o + 5, 9000, 0.7); ) :// mouthpiece: cup formant
            ( bq_pk(o, 1800, 0.9, 3); bq_hp(o + 5, 200, 0.7); );             // windway
);

body_n = 0;
function body_mode(f, q, amp, wl, wr) local(p, r, th)
(
  (f > 20 && f < 0.45*srate && body_n < BODY_MAX) ? (
    p = BODY_BASE + body_n*BODY_STRIDE;
    r = exp(-$pi*f/(q*srate));
    th = 2*$pi*f/srate;
    p[0] = 2*r*cos(th); p[1] = r*r; p[4] = (1 - r)*amp; p[5] = wl; p[6] = wr;
    body_n += 1;
  );
);

function setup_body() local(k, f, q, sc, qm, eta, ee, rho, h, dd, fr)
(
  body_n = 0;
  memset(BODY_BASE, 0, BODY_MAX*BODY_STRIDE);
  // stiffer-for-its-weight materials push the wooden modes up
  sc = max(0.35, min(2.5, sqrt((mat(rsm, M_E)*10^9/mat(rsm, M_RHO))/(11*10^9/440))));
  eta = mat(rsm, M_ETA);
  rs == 1 ? (
    // SOUNDBOX: a guitar-like body (air mode ~98 Hz, top/back modes above),
    // measured frequencies scaled by the material and the Size control
    k = 0;
    loop(12,
      f = k==0?98:k==1?204:k==2?226:k==3?381:k==4?437:k==5?552:k==6?650:k==7?780:k==8?920:k==9?1100:k==10?1450:2000;
      f = (k == 0 ? f : f*sc)/size_;
      q = k == 0 ? 20/(1 + age_) : 1/(mat(rsm, M_ETA)*(f/1000)^mat(rsm, M_SLOPE)*age_eta(f) + 0.018);
      body_mode(f, q, 1/sqrt(1 + 0.5*k), sin(k*2.1 + 0.4), cos(k*1.3 + 0.9));
      k += 1;
    );
  ) : rs == 3 ? (
    // CAVITY: a Helmholtz resonator (a gourd, a bottle) and a few cavity
    // modes, with the walls ringing in the chosen material
    body_mode(140/size_, 14, 1.4, 1, 1);
    body_mode(640/size_, 22, 0.6, 0.8, -0.5);
    body_mode(1060/size_, 25, 0.45, -0.4, 0.8);
    body_mode(1480/size_, 25, 0.35, 0.6, 0.6);
    k = 2;
    loop(6,
      f = 520*sc*k*(k*k - 1)/sqrt(k*k + 1)/(3*size_);
      q = 1/(eta*(f/1000)^mat(rsm, M_SLOPE)*age_eta(f) + 0.004);
      body_mode(f, q, 0.35/sqrt(k), cos(k*0.5), sin(k*2.2));
      k += 1;
    );
  ) : rs == 4 ? (
    // BODY: a solid block of the material; plate-like modes that give the
    // instrument the material's own ring (stone clink, glass shimmer)
    k = 0;
    loop(16,
      f = 280*sc*PLATE_TAB[k*3]/PLATE_TAB[0]/size_;
      q = 1/(eta*(f/1000)^mat(rsm, M_SLOPE)*age_eta(f) + 0.003);
      body_mode(f, q, 0.9/sqrt(1 + 0.3*k), sin(PLATE_TAB[k*3+1]*2.2), cos(PLATE_TAB[k*3+2]*1.7));
      k += 1;
    );
  );
);

function setup_radiator() local(o, k, j, f, r, th, p)
(
  o = BIQ_COEF + 10;
  rd == 0 ? ( bq_hp(o, 180, 0.6); bq_pk(o + 5, 1500, 0.8, 4); bq_off(o + 10); ) :                 // bell
  rd == 1 ? ( bq_pk(o, 250, 0.9, 3); bq_lp(o + 5, 7500, 0.7); bq_off(o + 10); ) :                 // soundboard
  rd == 2 ? ( bq_hp(o, 120, 0.7); bq_pk(o + 5, 2200, 1.5, 6); bq_lp(o + 10, 9000, 0.7); ) :      // drumhead
            ( bq_hp(o, 90, 0.8); bq_lp(o + 5, 5000, 0.9); bq_pk(o + 10, 2800, 3, 4); );           // cone
  // drumhead: its own few membrane modes ring along (like a banjo's head)
  memset(HEAD_BASE, 0, HEAD_MAX*8);
  k = 0;
  loop(HEAD_MAX,
    p = HEAD_BASE + k*8;
    f = 170/size_*BESSEL_TAB[k*2]/2.4048;
    r = exp(-6.9078/(0.25*srate));
    th = 2*$pi*min(f, 0.45*srate)/srate;
    p[0] = 2*r*cos(th); p[1] = r*r; p[4] = (1 - r)*0.8/sqrt(1 + k); p[5] = cos(k*1.1); p[6] = sin(k*1.1 + 0.6);
    k += 1;
  );
  // soundboard: allpass diffusion lengths (ms)
  k = 0;
  loop(8,
    DIFF_TMP[k] = floor(min(DIFF_LEN - 2, (k==0?3.1:k==1?5.3:k==2?7.9:k==3?11.3:k==4?3.7:k==5?5.9:k==6?8.3:12.1)*0.001*srate*size_));
    k += 1;
  );
);
DIFF_TMP = 5900; DIFF_W = 5950;

function blown_now() ( (slider2|0) <= 1; );
function update_globals()
(
  en = slider1|0; ex = slider2|0; el = slider3|0; elm = slider4|0;
  rs = slider5|0; rsm = slider6|0; cp = slider7|0; rd = slider8|0;
  fc_type = slider9|0; tm_type = slider10|0; dm_type = slider11|0; md_type = slider12|0;
  force = slider13/100; size_ = slider14/100; bright = slider15; decay_ = slider16/100;
  beta_ = slider17/100; res_amt = slider18/100; mono = slider19|0;
  glide_ms = slider20; fine_st = slider21/100; out_g = 10^(slider22/20);
  energy_params(en);
  // an old instrument is quieter when struck (it rings less); give some back.
  // Reeds and lips keep blowing at their own level, so they get none.
  age_ = slider23/100; age_gain = blown_now() ? 1 : 10^(AGE_MAKEUP*age_/20);
  // age loosens every fixing (rattle) and leaves rust grit (crackle)
  mat_rat = max(mat(elm, M_RAT), AGE_RAT*age_^1.5); mat_crk = max(mat(elm, M_CRK), AGE_CRK*age_*age_);
  ex_cont = (ex == 0 || ex == 1 || ex == 3);
  // a windway turns lips or a bow into an air jet (a flute); a reed stays a reed (a windcap)
  ex_eff = (cp == 3 && (ex == 1 || ex == 3)) ? 6 : ex;
  bend_range = fc_type == 3 ? 7 : 2;
  bm = 2^(bright/50);
  // couplers drain energy from the element into the body
  drain = cp == 0 ? 0.9 : cp == 1 ? 0.75 : 1;
  att_c = 1 - exp(-1/(max(0.0005, ep_att)*srate));
  rel_c = 1 - exp(-1/(max(0.002, ep_rel)*srate));
  glide_c = fc_type == 3 ? 1 - exp(-16*3/(max(5, glide_ms)*0.001*srate)) : 1;
  settle_c = exp(-16/(0.09*srate));
  mallet_c = 1 - exp(-2*$pi*900/srate);
  setup_coupler(); setup_body(); setup_radiator();
  master_trim = 10^((PART_TRIM[rs] + PART_TRIM[5 + cp] + PART_TRIM[9 + rd])/20);
  globals_ok = 1;
);

dc_r = 1 - 2*$pi*10/srate;
master_trim = 1;
// Loudness trims (dB), measured with tools/trims.py: exciter x element, for a
// steady energy source (row 0) and a single push (row 1); then per part.
TRIM_TAB = 6400; PART_TRIM = 6480;
function trim_row(c, ex, t0, t1, t2, t3, t4, t5) local(p)
( p = TRIM_TAB + c*36 + ex*6; p[0] = t0; p[1] = t1; p[2] = t2; p[3] = t3; p[4] = t4; p[5] = t5; );
memset(TRIM_TAB, 0, 100);
//TRIMS_BEGIN
trim_row(0, 0, -10.1, -19.1, -14.5, -12.6, -20.0, -2.5);
trim_row(0, 1, 1.1, -10.4, -2.7, -2.0, -11.3, -4.3);
trim_row(0, 2, -7.7, -3.8, 8.5, 1.1, -2.1, -1.4);
trim_row(0, 3, -5.2, -1.7, 3.4, -1.9, -6.1, 11.0);
trim_row(0, 4, -4.0, -0.8, 12.5, 4.5, 2.0, 1.9);
trim_row(0, 5, -6.2, -3.7, 8.4, 2.2, -2.1, -0.2);
trim_row(1, 0, -8.7, -14.5, -10.7, -7.7, -18.0, 0.6);
trim_row(1, 1, 2.6, -5.6, 0.0, -1.9, -8.1, -2.7);
trim_row(1, 2, 2.0, 5.1, 18.3, 11.0, 7.7, 8.9);
trim_row(1, 3, -3.1, 3.7, 8.7, 4.1, -0.7, 14.8);
trim_row(1, 4, 3.1, 6.5, 19.3, 11.8, 8.8, 9.6);
trim_row(1, 5, 14.3, 16.7, 20.0, 20.0, 19.5, 19.4);
// PART_TRIM_VALUES = [0.0, 5.3, 0.2, 5.0, 5.3, 2.0, 0.6, 0.0, -0.1, 0.0, -3.6, -2.5, -0.5]
i = 0; loop(13, PART_TRIM[i] = 0; i += 1;);
PART_TRIM[0] = 0.0;
PART_TRIM[1] = 5.3;
PART_TRIM[2] = 0.2;
PART_TRIM[3] = 5.0;
PART_TRIM[4] = 5.3;
PART_TRIM[5] = 2.0;
PART_TRIM[6] = 0.6;
PART_TRIM[7] = 0.0;
PART_TRIM[8] = -0.1;
PART_TRIM[9] = 0.0;
PART_TRIM[10] = -3.6;
PART_TRIM[11] = -2.5;
PART_TRIM[12] = -0.5;
//TRIMS_END
// lip valve (Trombolese reed.py: brass end of the morph)
LIP_WIDTH = 0.012; LIP_REST = 0.0003; LIP_CLOSE = 12000; LIP_Q = 15; LIP_Z = 2700000;
LIP_RATIO = 0.92; LIP_LOOPK = 2; LIP_BORE = 0.88; PSCALE = 4000;
TH_K = 0.6;
AGE_ETA = 2; AGE_ETA_HF = 3; AGE_TMAX = 1.5; AGE_MAKEUP = 6; AGE_BORE = 0.8; AGE_IRR = 0.015; AGE_DET = 25; AGE_WOW = 0.12;
AGE_LEAK = 0.06; AGE_HISS = 0.04; AGE_RAT = 0.6; AGE_CRK = 0.25; age_ = 0; age_gain = 1; RAT_GAP = 0.2; RAT_GAIN = 2.5; DEBUG_BANDED = 0; DBG_NODISP = 0; BOW_SLOPE_B = 3; BAND_G = 3; BAND_GAMMA = 0.7; BOWAIR_SGN = -1; BOWAIR_K = 1;
LM_SOFT = 100; LM_EDGE = 0.0045; LIPC_BAR = 124; LIPC_PLATE = 113; LIPC_TINE = 148; BOW_SLOPE = 1.5; BOW_FEXP = 0.5; BOW_TUBE = 1.333; BAND_T60_MIN = 0.3;
JET_C0 = 16; JET_C1 = 7; BOW_C0 = 6; BOW_C1 = 5;
dt = 1/srate;
lvl_decay = exp(-1/(0.05*srate));
CRK_RATE = 900/srate;
vis_dec = exp(-1/(0.3*srate)); vis_lvl = 0;
lim_att = 1 - exp(-1/(0.0005*srate)); lim_rel = exp(-1/(0.15*srate)); lim_env = 0;
expr = 1; cc11 = 1; cc2 = 1; breath_seen = 0; at_press = 0; mw = 0; bend = 0; mod_st = 0;
sustain = 0; soft_ped = 0; last_pitch = 0; stack_n = 0; age_ctr = 0; t_now = 0; ctl_ctr = 0;
lfo_ph = 0; trem = 1;
memset(BIQ_STATE, 0, 100);
memset(DIFF_BASE, 0, 8*DIFF_LEN);
memset(DIFF_W, 0, 8);
scope_w = 0;
all_off();
update_globals();

// ===========================================================================
// GUI: part names, descriptions and presets
// ===========================================================================
function cat_count(c) ( c==0?6 : c==1?6 : c==2?6 : c==3?MAT_N : c==4?5 : c==5?MAT_N : c==6?4 : c==7?4 : c==8?5 : c==9?4 : 5; );
function cat_short(c)
(
  c==0?"ENERGY" : c==1?"EXCITER" : c==2?"ELEMENT" : c==4?"RESONATOR" : c==6?"COUPLER" : c==7?"RADIATOR" :
  c==8?"FREQUENCY" : c==9?"TUNING" : c==10?"DAMPING" : c==11?"MODULATION" : "MATERIAL";
);
function cat_title(c)
(
  c==0?"ENERGY SOURCE" : c==1?"EXCITER" : c==2?"VIBRATING ELEMENT" : c==3?"ELEMENT MATERIAL" :
  c==4?"RESONATOR" : c==5?"RESONATOR MATERIAL" : c==6?"COUPLER" : c==7?"RADIATOR" :
  c==8?"FREQUENCY CONTROL" : c==9?"TUNING MECHANISM" : c==10?"DAMPING" : "MODULATION / CONTROL";
);
function mat_name(i)
(
  i==0?"Steel":i==1?"Brass":i==2?"Bronze":i==3?"Aluminium":i==4?"Gold":i==5?"Glass":i==6?"Crystal":
  i==7?"Ice":i==8?"Marble":i==9?"Clay":i==10?"Spruce":i==11?"Rosewood":i==12?"Bamboo":i==13?"Bone":
  i==14?"Gut":i==15?"Nylon":i==16?"Carbon Fibre":i==17?"Rubber":i==18?"Paper":i==19?"Jelly":
  i==20?"Plastic":i==21?"PVC":i==22?"Wood":i==23?"Leather":i==24?"Cardboard":i==25?"Foil":
  i==26?"Cling Film":i==27?"Tin":i==28?"Car Panel":i==29?"Chain Link":"Handpan Steel";
);
function opt_name(c, i)
(
  c==0 ? (i==0?"Breath":i==1?"Bow":i==2?"Finger":i==3?"Plectrum":i==4?"Hammer":"Electricity") :
  c==1 ? (i==0?"Reed":i==1?"Lips":i==2?"Hammer":i==3?"Bow":i==4?"Plectrum":"Mallet") :
  c==2 ? (i==0?"String":i==1?"Membrane":i==2?"Bar":i==3?"Plate":i==4?"Reed":"Air Column") :
  (c==3 || c==5) ? mat_name(i) :
  c==4 ? (i==0?"Bore":i==1?"Soundbox":i==2?"Pipe":i==3?"Cavity":"Body") :
  c==6 ? (i==0?"Bridge":i==1?"Soundpost":i==2?"Mouthpiece":"Windway") :
  c==7 ? (i==0?"Bell":i==1?"Soundboard":i==2?"Drumhead":"Cone") :
  c==8 ? (i==0?"Fret":i==1?"Tone Hole":i==2?"Valve":i==3?"Slide":"Key") :
  c==9 ? (i==0?"Peg":i==1?"Tuning Pin":i==2?"Machine Head":"Slide") :
  c==10 ? (i==0?"Damper":i==1?"Mute":i==2?"Palm":i==3?"Felt":"Hand") :
          (i==0?"Keywork":i==1?"Pedals":i==2?"Valves":i==3?"Levers":"Electronics");
);
function mat_desc(i)
(
  i==0?"Stiff and dense. Rings for a very long time, bright and pure." :
  i==1?"Warm metal with a little more internal loss than steel." :
  i==2?"Bell metal: rings long, with a slightly uneven, shimmering decay." :
  i==3?"Light and stiff for its weight: a clear, glassy-metal ring." :
  i==4?"Very heavy and soft for a metal: rich but dull, it stops quickly." :
  i==5?"Stiff and light with very low loss: bright, glassy and long." :
  i==6?"Quartz crystal: almost no internal loss, so it rings for ages." :
  i==7?"Frozen water: fairly soft, and bubbles and cracks split every resonance into a beating pair." :
  i==8?"Stone: stiff, heavy and a little lossy. Short, stony and pitched." :
  i==9?"Fired clay: rough and porous, earthy and quick to fade." :
  i==10?"Light, stiff wood with the grain: the classic soundboard wood." :
  i==11?"Dense hardwood (marimba bars): warm, woody, medium decay." :
  i==12?"Light and springy wood: soft and breathy." :
  i==13?"Hard but lossy: dry and clicky." :
  i==14?"Soft and lossy string material: warm and mellow." :
  i==15?"Soft, smooth plastic string: gentle and round." :
  i==16?"Very stiff and light: bright and precise." :
  i==17?"Absurdly soft and lossy: thuds, and wobbles in pitch." :
  i==18?"Light, rough and floppy: a papery buzz that dies at once." :
  i==19?"Hardly a solid at all: very lossy, and it wobbles in pitch." :
  i==20?"Everyday hard plastic: light, soft and quite lossy. A dull, toy-like knock." :
  i==21?"Plumbing pipe plastic: smooth inside, so a PVC air column still speaks well; dull when struck." :
  i==22?"Plain hardwood: warm and woody, medium decay." :
  i==23?"A hide: very soft and lossy, a dead, thumpy thud, sagging a little in pitch." :
  i==24?"Paperboard, like a toilet roll tube: rough and porous, a honky, papery thud." :
  i==25?"Crumpled aluminium foil: every crease splits the ring, and it crackles when it vibrates hard." :
  i==26?"Stretched polyethylene film: floppy and lossy, and it slaps and buzzes like a kazoo when played hard." :
  i==27?"Galvanised roofing sheet: metallic and uneven, and its loose fixings rattle." :
  i==28?"Painted car-body steel: the paint damps it, so it clanks rather than rings." :
  i==29?"Steel wire mesh: a metallic twang with a jangle as the links rattle." :
        "Nitrided steel, as hammered into a handpan: sweet, pure and long-ringing.";
);
function opt_desc(c, i)
(
  c==0 ? (
    i==0?"A steady stream of air. Notes sustain while held; a breath controller (CC2), expression (CC11) or key pressure sets how hard you blow." :
    i==1?"A bow drawn at steady speed. Sustains while held, with a little rosin grit." :
    i==2?"A single soft push from a fingertip. Each note is played once, gently." :
    i==3?"A single sharp flick. Bright and quick." :
    i==4?"A single hard blow. Very sensitive to how hard you play." :
         "A steady, noiseless electric drive. Sustains forever; with a striking exciter it becomes a buzzer.") :
  c==1 ? (
    i==0?"A cane reed that chops the airflow into pulses, like a clarinet. Needs a push to get going." :
    i==1?"Buzzing lips: a valve that blows open, like a trumpet (Trombolese’s lip model). Through a windway it becomes a flute’s air jet." :
    i==2?"A hard, short strike, like a piano hammer." :
    i==3?"Stick-slip friction, like a violin bow. Keeps the element singing while it is driven. Through a windway it becomes an air jet." :
    i==4?"Pulls the element aside and lets go, like a guitar pick." :
         "A soft, padded strike, like a marimba mallet.") :
  c==2 ? (
    i==0?"A stretched string. Tension sets the pitch; stiff materials (stone, glass, ice) must be thick rods, so they ring like bells." :
    i==1?"A stretched circular skin, like a drum. Inharmonic: rings near the edge, thuds at the centre." :
    i==2?"A free bar, like a xylophone key. Its partials sit at 1 : 2.76 : 5.40 : 8.93." :
    i==3?"A flat sheet, like a bell plate or gong: dense, shimmering and inharmonic." :
    i==4?"A clamped tongue, like a kalimba tine or harmonica reed. Blown, it buzzes." :
         "A column of air in a tube, like a clarinet or trumpet. Its losses come from Trombolese’s physics.") :
  (c==3 || c==5) ? mat_desc(i) :
  c==4 ? (
    i==0?"A cone-shaped tube tuned to each note. Reinforces every harmonic, like a saxophone." :
    i==1?"A hollow box, like a guitar body: resonances from about 100 to 2000 Hz, scaled by its material and Size." :
    i==2?"A stopped tube under each note, like a marimba resonator. Reinforces the odd harmonics." :
    i==3?"An enclosed pocket of air, like a gourd or bottle: a hollow boom with ringing walls." :
         "A solid block of the material. Adds the material’s own ring: stone clinks, glass shimmers.") :
  c==6 ? (
    i==0?"Carries the vibration into the body, with the bright “bridge hill” around 2.5 kHz." :
    i==1?"A post that couples strongly into the body: warm and woody, with a shorter ring." :
    i==2?"A small cup between exciter and element: a vocal, brassy formant." :
         "A narrow air duct, like a recorder’s: breathy. Turns lips or a bow into a flute’s air jet.") :
  c==7 ? (
    i==0?"A flared bell. Throws the high frequencies forward, and gets brassy when loud." :
    i==1?"A wide board that spreads and softens the sound." :
    i==2?"A skin that rings along, like a banjo head: twangy, with a low boom." :
         "A loudspeaker cone: electric-instrument tone with a little amplifier grit.") :
  c==8 ? (
    i==0?"Fixed semitone stops. In Mono mode, a new note hammers on instead of re-plucking." :
    i==1?"Holes along the element. Harmonics above about 1.5 kHz leak out, like a woodwind. In Mono mode notes change with a quick key blip." :
    i==2?"Switches lengths of tube in and out. A few notes are famously a little sharp, as on a real trumpet." :
    i==3?"A continuous length: every note glides from the last one, like a trombone. Pitch bend covers 7 semitones." :
         "One element per key, like a piano: every note is fresh and independent.") :
  c==9 ? (
    i==0?"Friction pegs: never quite in tune, and drifting a little." :
    i==1?"Piano-style stretched octaves: the bass a little flat, the treble a little sharp." :
    i==2?"Geared tuners: exact equal temperament." :
         "A tuning slide: each note starts a little flat and settles into tune.") :
  c==10 ? (
    i==0?"A felt damper stops the note when you let go, like a piano. The sustain pedal (CC64) lifts it." :
    i==1?"A mute: darker and more nasal, with a softer release." :
    i==2?"A palm resting on it: short, chunky notes." :
    i==3?"Felt against the element: soft, dark and intimate. Strikes are softer too." :
         "A hand in the bell: darker and slightly flat, like a horn.") :
  (
    i==0?"Plain keys. The mod wheel blows or bows harder." :
    i==1?"Sustain (CC64) and soft (CC67) pedals. The mod wheel lifts the dampers, so released notes ring on." :
    i==2?"The mod wheel half-presses a valve: the pitch sags and the tone gets stuffy." :
    i==3?"The mod wheel bends notes up by as much as a whole tone, like a B-bender." :
         "The mod wheel adds vibrato and tremolo, like a vibraphone motor."
  );
);
function combo_hint()
(
  (cp == 3 && (ex == 1 || ex == 3)) ? "The windway turns this exciter into an air jet: it plays like a flute." :
  (ep_sus && ex_cont) ? "Notes sustain while you hold the key. Play harder, or push the mod wheel, for more." :
  (!ep_sus && ex_cont) ? "A single push drives a sustaining exciter: each note swells, then fades." :
  (ep_sus && !ex_cont) ? "A steady supply keeps striking while you hold the key: a roll, a tremolo, a buzz." :
                         "Each note is struck once and rings.";
);

// ===========================================================================
// The instrument as one line drawing (ADR 0024). Every part is a few
// polylines in a drawing space 900 wide and 360 tall (y down); the twelve
// choices decide which. The coupler decides the build: a mouthpiece or a
// windway joins the parts end to end, like a wind instrument ("in a line");
// a bridge or a soundpost holds the element over the body, like a guitar or a
// marimba ("in layers"). The other parts sit where they act: tone holes and
// frets on the element, the tuning at its end, a mute or a hand in the bell,
// pedals and electronics underneath. Window only: built into a list of
// segments when a part changes, then drawn by @gfx each frame.
// ===========================================================================
WF_AUX = 690000;                  // window only: transform stack, smoothing buffers, the parts being drawn
WF_STK = WF_AUX; WF_CHA = WF_AUX + 100; WF_CHB = WF_AUX + 1200; WF_P = WF_AUX + 2400;
WF_LAST = WF_AUX + 2420;          // the twelve choices the drawing was built from
WF_OBB = WF_AUX + 2440;           // the picker: each option's part, bounding box (6 x 4)
WF_GEO = 700000; WF_GEO_MAX = 4000;          // the instrument: count, then x1 y1 x2 y2 part hidden
WF_OPT = 725000; WF_OPT_STRIDE = 25000;      // the picker's six versions of it, one per option
CAT_TAB = 14200; CAT_STRIDE = 16;            // per part: box, anchor, label (12 x 16)

// ---- the pen: an affine transform (a stack of eight) and the current point
function wf_reset() ( tf_a = 1; tf_b = 0; tf_c = 0; tf_d = 1; tf_e = 0; tf_f = 0; tf_sp = 0; wfhid = 0; );
// draw what follows translated to (ox, oy), turned by ang, mirrored if sx = -1
function wf_push(ox, oy, ang, sx) local(p, ca, sa, a, b, c, d, ta, tb, tc, td)
(
  p = WF_STK + tf_sp*6; p[0] = tf_a; p[1] = tf_b; p[2] = tf_c; p[3] = tf_d; p[4] = tf_e; p[5] = tf_f; tf_sp += 1;
  ca = cos(ang); sa = sin(ang); a = sx*ca; b = sx*sa; c = -sa; d = ca;
  tf_e += tf_a*ox + tf_c*oy; tf_f += tf_b*ox + tf_d*oy;
  ta = tf_a; tb = tf_b; tc = tf_c; td = tf_d;
  tf_a = ta*a + tc*b; tf_b = tb*a + td*b; tf_c = ta*c + tc*d; tf_d = tb*c + td*d;
);
function wf_pop() local(p)
(
  tf_sp -= 1; p = WF_STK + tf_sp*6;
  tf_a = p[0]; tf_b = p[1]; tf_c = p[2]; tf_d = p[3]; tf_e = p[4]; tf_f = p[5];
);
function wf_seg(x1, y1, x2, y2) local(p)
(
  wfn < WF_GEO_MAX ? ( p = wfbuf + 1 + wfn*6; p[0] = x1; p[1] = y1; p[2] = x2; p[3] = y2; p[4] = wfcat; p[5] = wfhid; wfn += 1; );
);
function wf_mv(x, y) ( wflx = tf_a*x + tf_c*y + tf_e; wfly = tf_b*x + tf_d*y + tf_f; wffx = wflx; wffy = wfly; );
function wf_to(x, y) local(nx, ny)
(
  nx = tf_a*x + tf_c*y + tf_e; ny = tf_b*x + tf_d*y + tf_f;
  wf_seg(wflx, wfly, nx, ny); wflx = nx; wfly = ny;
);
function wf_close() ( wf_seg(wflx, wfly, wffx, wffy); wflx = wffx; wfly = wffy; );
function wf_line(x1, y1, x2, y2) ( wf_mv(x1, y1); wf_to(x2, y2); );
// a hidden edge (drawn dashed)
function wf_lineh(x1, y1, x2, y2) ( wfhid = 1; wf_mv(x1, y1); wf_to(x2, y2); wfhid = 0; );
function wf_rect(x, y, w, h) ( wf_mv(x, y); wf_to(x + w, y); wf_to(x + w, y + h); wf_to(x, y + h); wf_close(); );
function wf_arc(cx, cy, rx, ry, a0, a1) local(n, i, a)
(
  n = max(6, ceil(abs(a1 - a0)/(2*$pi)*32)); i = 0;
  loop(n + 1,
    a = a0 + (a1 - a0)*i/n;
    i == 0 ? wf_mv(cx + rx*cos(a), cy + ry*sin(a)) : wf_to(cx + rx*cos(a), cy + ry*sin(a));
    i += 1;
  );
);
function wf_arch(cx, cy, rx, ry, a0, a1) ( wfhid = 1; wf_arc(cx, cy, rx, ry, a0, a1); wfhid = 0; );
function wf_ell(cx, cy, rx, ry) ( wf_arc(cx, cy, rx, ry, 0, 2*$pi); );
// a box seen from the front, a little from above and the right
function wf_box(x, y, w, h, dep) local(dx, dy)
(
  dx = dep*0.55; dy = -dep*0.45;
  wf_rect(x, y, w, h);
  wf_mv(x, y); wf_to(x + dx, y + dy); wf_to(x + w + dx, y + dy); wf_to(x + w, y);
  wf_mv(x + w + dx, y + dy); wf_to(x + w + dx, y + h + dy); wf_to(x + w, y + h);
  wfhid = 1;
  wf_mv(x + dx, y + dy); wf_to(x + dx, y + h + dy); wf_to(x + w + dx, y + h + dy);
  wf_mv(x, y + h); wf_to(x + dx, y + h + dy);
  wfhid = 0;
);
// a tube lying along x, radius r0 at x0 to r1 at x1; capl/capr: draw its ends
function wf_tube(x0, x1, cy, r0, r1, capl, capr)
(
  wf_line(x0, cy - r0, x1, cy - r1); wf_line(x0, cy + r0, x1, cy + r1);
  capl ? ( wf_arc(x0, cy, r0*0.3, r0, 0.5*$pi, 1.5*$pi); wf_arch(x0, cy, r0*0.3, r0, -0.5*$pi, 0.5*$pi); );
  capr ? wf_ell(x1, cy, r1*0.3, r1) : ( wf_arc(x1, cy, r1*0.3, r1, -0.5*$pi, 0.5*$pi); wf_arch(x1, cy, r1*0.3, r1, 0.5*$pi, 1.5*$pi); );
);
// a tube standing upright
function wf_vtube(cx, y0, y1, r, captop)
(
  wf_line(cx - r, y0, cx - r, y1); wf_line(cx + r, y0, cx + r, y1);
  captop ? wf_ell(cx, y0, r, r*0.32);
  wf_arc(cx, y1, r, r*0.32, 0, $pi); wf_arch(cx, y1, r, r*0.32, $pi, 2*$pi);
);
function wf_ring(cx, cy, r) ( wf_arc(cx, cy, r*0.3, r, -0.5*$pi, 0.5*$pi); wf_arch(cx, cy, r*0.3, r, 0.5*$pi, 1.5*$pi); );
function wf_arrow(x, y, a, s)
(
  wf_mv(x - s*cos(a - 0.45), y - s*sin(a - 0.45)); wf_to(x, y); wf_to(x - s*cos(a + 0.45), y - s*sin(a + 0.45));
);
// smooth outlines (Chaikin's corner cutting): add points, run, draw
function wf_chs() ( wf_chn = 0; );
function wf_ch(x, y) ( WF_CHA[wf_chn*2] = x; WF_CHA[wf_chn*2 + 1] = y; wf_chn += 1; );
function wf_chrun(n, closed) local(m, o, i, j, ax, ay, bx, by)
(
  loop(n,
    m = wf_chn; o = 0;
    !closed ? ( WF_CHB[0] = WF_CHA[0]; WF_CHB[1] = WF_CHA[1]; o = 1; );
    i = 0;
    loop(closed ? m : m - 1,
      j = (i + 1) % m; ax = WF_CHA[i*2]; ay = WF_CHA[i*2 + 1]; bx = WF_CHA[j*2]; by = WF_CHA[j*2 + 1];
      WF_CHB[o*2] = 0.75*ax + 0.25*bx; WF_CHB[o*2 + 1] = 0.75*ay + 0.25*by; o += 1;
      WF_CHB[o*2] = 0.25*ax + 0.75*bx; WF_CHB[o*2 + 1] = 0.25*ay + 0.75*by; o += 1;
      i += 1;
    );
    !closed ? ( WF_CHB[o*2] = WF_CHA[(m - 1)*2]; WF_CHB[o*2 + 1] = WF_CHA[(m - 1)*2 + 1]; o += 1; );
    i = 0; loop(o*2, WF_CHA[i] = WF_CHB[i]; i += 1;);
    wf_chn = o;
  );
);
function wf_chdraw(closed, s) local(i)
(
  i = 0;
  loop(wf_chn, i == 0 ? wf_mv(s*WF_CHA[0], s*WF_CHA[1]) : wf_to(s*WF_CHA[i*2], s*WF_CHA[i*2 + 1]); i += 1;);
  closed ? wf_close();
);
// a flat hand, fingers pointing along +x
function wf_hand(x, y, s, a) local(i, fy, l)
(
  wf_push(x, y, a, 1);
  wf_chs(); wf_ch(-30, -14); wf_ch(-4, -16); wf_ch(0, -12); wf_ch(0, 12); wf_ch(-4, 18); wf_ch(-30, 16); wf_ch(-38, 2);
  wf_chrun(2, 1); wf_chdraw(1, s);
  i = 0;
  loop(4,
    fy = (-11 + i*7.3)*s; l = (i == 0 ? 22 : i == 1 ? 26 : i == 2 ? 25 : 20)*s;
    wf_chs(); wf_ch(0, fy - 3*s); wf_ch(l, fy - 2.6*s); wf_ch(l + 3*s, fy); wf_ch(l, fy + 2.6*s); wf_ch(0, fy + 3*s);
    wf_chrun(2, 0); wf_chdraw(0, 1);
    i += 1;
  );
  wf_chs(); wf_ch(-14*s, -15*s); wf_ch(-2*s, -26*s); wf_ch(8*s, -30*s); wf_ch(10*s, -26*s); wf_ch(0, -14*s);
  wf_chrun(2, 0); wf_chdraw(0, 1);
  wf_pop();
);
// a guitar's outline: half its width at x (0 to 1 along it)
function wf_gh(x) local(a, b, h)
(
  a = max(0, 0.09 - (x - 0.68)*(x - 0.68)); b = max(0, 0.0529 - (x - 0.24)*(x - 0.24));
  h = max(sqrt(a), 0.92*sqrt(b));
  max(h, (x > 0.3 && x < 0.55) ? 0.16 : 0);
);

// ---- the parts. md: 0 in a line, 1 in layers. The element leaves where it
// lies (el_*), the resonator where a radiator can join it (rz_*).
function wf_element(opt, md) local(x0, x1, y, r, n, i, dx, dy, cx, rx, ry, yt, hg, a, lx, n1, n2, dep, w, xs, yf, bl, lt, xa, ya)
(
  x0 = lay_ex0; x1 = lay_ex1; y = lay_ey; el_x0 = x0; el_x1 = x1; el_y = y;
  r = md == 0 ? 22 : 16;
  opt == 0 ? (
    // strings between a nut and a saddle (on a neck when in a line)
    n = md == 0 ? 3 : 4;
    md == 0 ? wf_box(x0, y + 6, x1 - x0, 9, 26);
    wf_box(x0 + 4, y - 6, 8, 12, 14); wf_box(x1 - 14, y - 6, 8, 12, 14);
    i = 0; loop(n, dx = i*6*0.55*1.4; dy = -i*6*0.45*1.4; wf_line(x0 + 8 + dx, y - 5 + dy, x1 - 10 + dx, y - 5 + dy); i += 1;);
    el_top = y - 12; el_bot = md == 0 ? y + 15 : y; el_r = 6;
  ) : opt == 1 ? (
    // a skin: a drum in a line, a head over the body in layers
    cx = 0.5*(x0 + x1); rx = min(130, 0.5*(x1 - x0)); ry = rx*0.26;
    md == 0 ? (
      yt = y - 22; hg = 50;
      wf_ell(cx, yt, rx, ry); wf_ell(cx, yt, rx*0.95, ry*0.92);
      wf_line(cx - rx, yt, cx - rx, yt + hg); wf_line(cx + rx, yt, cx + rx, yt + hg);
      wf_arc(cx, yt + hg, rx, ry, 0, $pi); wf_arch(cx, yt + hg, rx, ry, $pi, 2*$pi);
      i = 1; loop(5, a = $pi*i/6; lx = cx - rx*cos(a); wf_line(lx, yt + ry*sin(a), lx, yt + ry*sin(a) + 0.5*hg); i += 1;);
      el_top = yt - ry; el_bot = yt + hg + ry;
    ) : (
      wf_ell(cx, y + 12, rx, ry); wf_ell(cx, y + 12, rx*1.04, ry*1.1);
      i = 0; loop(10, a = 2*$pi*i/10; wf_line(cx + rx*1.04*cos(a), y + 12 + ry*1.1*sin(a), cx + rx*1.1*cos(a), y + 12 + ry*1.2*sin(a)); i += 1;);
      el_top = y + 12 - ry; el_bot = y + 12 + ry;
    );
    el_x0 = cx - rx; el_x1 = cx + rx; el_r = ry;
  ) : opt == 2 ? (
    // a bar on two supports at its nodes
    wf_box(x0 + 8, y - 7, x1 - x0 - 16, 14, md == 0 ? 30 : 34);
    n1 = x0 + 8 + 0.224*(x1 - x0 - 16); n2 = x0 + 8 + 0.776*(x1 - x0 - 16);
    md == 0 ? (
      wf_mv(n1 - 8, y + 22); wf_to(n1, y + 7); wf_to(n1 + 8, y + 22); wf_close();
      wf_mv(n2 - 8, y + 22); wf_to(n2, y + 7); wf_to(n2 + 8, y + 22); wf_close();
    ) : (
      wf_lineh(n1, y + 7, n1 + 12, y - 4); wf_ell(n1 + 6, y - 13, 2.5, 1.5);
      wf_lineh(n2, y + 7, n2 + 12, y - 4); wf_ell(n2 + 6, y - 13, 2.5, 1.5);
    );
    el_top = y - 22; el_bot = y + 7; el_r = 7;
  ) : opt == 3 ? (
    // a flat sheet, with its thickness
    dep = md == 0 ? 70 : 64; w = x1 - x0 - 20; xs = x0 + 10; yf = y + 14;
    dx = dep*0.55; dy = -dep*0.45;
    wf_mv(xs, yf); wf_to(xs + w, yf); wf_to(xs + w + dx, yf + dy); wf_to(xs + dx, yf + dy); wf_close();
    wf_mv(xs, yf); wf_to(xs, yf + 4); wf_to(xs + w, yf + 4); wf_to(xs + w, yf);
    wf_line(xs + w, yf + 4, xs + w + dx, yf + dy + 4); wf_line(xs + w + dx, yf + dy, xs + w + dx, yf + dy + 4);
    el_top = yf + dy; el_bot = yf + 4; el_r = 10;
  ) : opt == 4 ? (
    // tines clamped in a block, a comb of them in layers
    n = md == 0 ? 4 : 7; bl = md == 0 ? 30 : 40;
    wf_box(x0, y - 12, bl, 24, n*8 + 6);
    i = 0;
    loop(n,
      lt = (x1 - x0 - bl - 10)*(1 - i*(md == 0 ? 0.16 : 0.1));
      dx = (i*8 + 4)*0.55; dy = -(i*8 + 4)*0.45; xa = x0 + bl + dx; ya = y + dy;
      wf_mv(xa, ya - 3); wf_to(xa + lt - 4, ya - 2); wf_to(xa + lt, ya); wf_to(xa + lt - 4, ya + 2); wf_to(xa, ya + 3);
      i += 1;
    );
    el_top = y - 12 - (n*8 + 6)*0.45; el_bot = y + 12; el_r = 12; el_x1 = x0 + bl + (x1 - x0 - bl - 10);
  ) : (
    // a tube of air
    wf_tube(x0, x1, y, r, r, 1, 1);
    wf_ring(x0 + (x1 - x0)*0.36, y, r); wf_ring(x0 + (x1 - x0)*0.68, y, r);
    el_top = y - r; el_bot = y + r; el_r = r;
  );
);

function wf_res(opt, md) local(x0, x1, y, r0, w, sy, dep, i, t, cx, rr, bx0, bx1, by0, by1, cy, yt, cyy)
(
  rz_cone = 0;
  md == 0 ? (
    x0 = lay_rx0; x1 = lay_rx1; y = lay_ey; r0 = el_r > 4 ? min(el_r, 22) : 14;
    opt == 0 ? (
      wf_tube(x0, x1, y, r0, 40, 0, 0);
      wf_ring(x0 + 70, y, r0 + (40 - r0)*70/(x1 - x0)); wf_ring(x0 + 140, y, r0 + (40 - r0)*140/(x1 - x0));
      rz_x = x1; rz_y = y; rz_r = 40;
    ) : opt == 1 ? (
      w = x1 - x0; sy = 0.42*w; dep = 22;
      i = 0; loop(41, t = i/40; i == 0 ? wf_mv(x0 + t*w, y - wf_gh(t)*sy) : wf_to(x0 + t*w, y - wf_gh(t)*sy); i += 1;);
      i = 40; loop(41, t = i/40; wf_to(x0 + t*w, y + wf_gh(t)*sy); i -= 1;); wf_close();
      i = 40; loop(41, t = i/40; i == 40 ? wf_mv(x0 + t*w, y + wf_gh(t)*sy + dep) : wf_to(x0 + t*w, y + wf_gh(t)*sy + dep); i -= 1;);
      wf_line(x0 + w*0.98, y, x0 + w*0.98, y + dep); wf_lineh(x0 + 2, y, x0 + 2, y + dep);
      wf_ell(x0 + w*0.46, y, w*0.08, w*0.08);
      rz_x = x1; rz_y = y; rz_r = 20;
    ) : opt == 2 ? (
      wf_tube(x0, x1, y, r0, r0, 0, 1); wf_ell(x1, y, r0*0.24, r0*0.8); wf_lineh(x1 - 8, y - r0, x1 - 8, y + r0);
      rz_x = x1; rz_y = y; rz_r = r0;
    ) : opt == 3 ? (
      cx = x0 + (x1 - x0)*0.6; rr = (x1 - x0)*0.36;
      wf_tube(x0, cx - rr*0.92, y, 9, 9, 1, 0);
      wf_ell(cx, y, rr, rr); wf_arc(cx, y, rr, rr*0.3, 0, $pi); wf_arch(cx, y, rr, rr*0.3, $pi, 2*$pi);
      wf_arc(cx, y, rr*0.4, rr, -0.5*$pi, 0.5*$pi);
      rz_x = cx + rr; rz_y = y; rz_r = 14;
    ) : (
      wf_box(x0, y - 42, x1 - x0 - 24, 84, 40); rz_x = x1 - 24; rz_y = y; rz_r = 26;
    );
  ) : (
    bx0 = lay_bx0; bx1 = lay_bx1; by0 = lay_by0; by1 = lay_by1; cy = 0.5*(by0 + by1);
    opt == 0 ? (
      wf_tube(bx0, bx1, cy + 10, 16, 46, 1, 1);
      wf_ring(bx0 + 150, cy + 10, 16 + 30*150/(bx1 - bx0)); wf_ring(bx0 + 300, cy + 10, 16 + 30*300/(bx1 - bx0));
      rz_fx = bx1; rz_fy = cy + 10; rz_fr = 46; rz_top = cy - 36;
    ) : opt == 1 ? (
      w = bx1 - bx0; sy = 1.05*(by1 - by0); dep = 30; yt = by0 + 22;
      i = 0; loop(49, t = i/48; i == 0 ? wf_mv(bx0 + t*w, yt + 8 - wf_gh(t)*sy) : wf_to(bx0 + t*w, yt + 8 - wf_gh(t)*sy); i += 1;);
      i = 48; loop(49, t = i/48; wf_to(bx0 + t*w, yt + 8 + wf_gh(t)*sy); i -= 1;); wf_close();
      i = 48; loop(49, t = i/48; i == 48 ? wf_mv(bx0 + t*w, yt + 8 + wf_gh(t)*sy + dep) : wf_to(bx0 + t*w, yt + 8 + wf_gh(t)*sy + dep); i -= 1;);
      wf_line(bx0 + w*0.98, yt + 8, bx0 + w*0.98, yt + 8 + dep);
      wf_ell(bx0 + w*0.42, yt + 8, w*0.07, w*0.07*0.42);
      rz_fx = bx1; rz_fy = yt + 30; rz_fr = 22; rz_top = yt + 8 - 0.3*sy; rz_cone = 1; rz_cx = bx0 + w*0.7; rz_cy = yt + 8 + 0.18*sy;
    ) : opt == 2 ? (
      i = 0; loop(7, cx = bx0 + 20 + i*(bx1 - bx0 - 40)/6; wf_vtube(cx, by0 + 6, by0 + 126 - i*11, 13, 1); i += 1;);
      wf_lineh(bx0 + 4, by0 + 18, bx1 - 4, by0 + 18);
      rz_fx = bx1 + 14; rz_fy = by0 + 40; rz_fr = 16; rz_top = by0;
    ) : opt == 3 ? (
      cx = 0.5*(bx0 + bx1); rr = 58; cyy = by0 + 66;
      wf_vtube(cx, lay_ey + 6, cyy - rr*0.94, 9, 0);
      wf_ell(cx, cyy, rr*1.25, rr); wf_arc(cx, cyy, rr*1.25, rr*0.3, 0, $pi); wf_arch(cx, cyy, rr*1.25, rr*0.3, $pi, 2*$pi);
      wf_arc(cx, cyy, rr*0.45, rr, -0.5*$pi, 0.5*$pi);
      rz_fx = cx + rr*1.25; rz_fy = cyy; rz_fr = 16; rz_top = cyy - rr; rz_cone = 1; rz_cx = cx + rr*0.55; rz_cy = cyy + rr*0.35;
    ) : (
      wf_box(bx0, by0 + 14, bx1 - bx0 - 40, by1 - by0 - 18, 60);
      rz_fx = bx1 - 40; rz_fy = cy + 12; rz_fr = 24; rz_top = by0 + 14; rz_cone = 1; rz_cx = bx1 - 110; rz_cy = cy + 12;
    );
  );
);

function wf_coupler(opt) local(a, b, x, yt, yb, y)
(
  y = lay_ey;
  opt == 2 ? (
    a = lay_cx0; b = lay_cx1;
    wf_tube(a, a + 26, y, 9, 5, 1, 0); wf_tube(a + 26, b, y, 5, min(el_r > 4 ? el_r : 14, 22), 0, 0); wf_lineh(a + 26, y - 5, a + 26, y + 5);
  ) : opt == 3 ? (
    a = lay_cx0; b = lay_cx1; wf_box(a, y - 13, b - a, 26, 20);
    wf_mv(b - 26, y - 13); wf_to(b - 18, y - 20); wf_to(b - 6, y - 20); wf_to(b - 12, y - 13); wf_close();
    wf_lineh(a + 4, y, b - 22, y - 9);
  ) : opt == 0 ? (
    x = lay_cpx; yt = el_bot + 1; yb = lay_cpy;
    wf_mv(x - 22, yb); wf_to(x - 14, yt); wf_to(x + 14, yt); wf_to(x + 22, yb); wf_to(x + 12, yb); wf_to(x + 6, yb - 7); wf_to(x - 6, yb - 7); wf_to(x - 12, yb); wf_close();
    wf_line(x + 14, yt, x + 22, yt - 6); wf_line(x + 22, yt - 6, x + 30, yb - 6); wf_line(x + 22, yb, x + 30, yb - 6);
  ) : (
    x = lay_cpx; yt = el_bot + 1; yb = lay_cpy + 4; wf_vtube(x, yt, yb, 5, 1);
  );
);

// a flared bell from (x0, y, radius r0) to x1, mouth radius r1
function wf_bell(x0, x1, y, r0, r1) local(i, t, x, r)
(
  i = 0; loop(25, t = i/24; x = x0 + t*(x1 - x0); r = r0 + (r1 - r0)*t*t*t; i == 0 ? wf_mv(x, y - r) : wf_to(x, y - r); i += 1;);
  i = 0; loop(25, t = i/24; x = x0 + t*(x1 - x0); r = r0 + (r1 - r0)*t*t*t; i == 0 ? wf_mv(x, y + r) : wf_to(x, y + r); i += 1;);
  wf_ell(x1, y, r1*0.28, r1);
);
function wf_rad(opt, md) local(x0, y, r0, x1, i, a, aa, xa, xb, yf, dx, dy, cx, yy)
(
  md == 0 ? (
    x0 = rz_x; y = rz_y; r0 = rz_r; x1 = lay_dx1;
    opt == 0 ? (
      wf_bell(x0, x1, y, r0, 78); wf_ell(x1, y, 78*0.24, 78*0.88);
    ) : opt == 1 ? (
      wf_tube(x0, x0 + 30, y, 8, 8, 0, 0); wf_box(x0 + 30, y - 85, 12, 150, 70);
    ) : opt == 2 ? (
      a = x0 + 50; wf_tube(x0, a, y, min(r0, 12), min(r0, 12), 0, 0);
      wf_line(a, y - 70, x1 - 20, y - 70); wf_line(a, y + 70, x1 - 20, y + 70);
      wf_arc(a, y, 22, 70, 0.5*$pi, 1.5*$pi); wf_arch(a, y, 22, 70, -0.5*$pi, 0.5*$pi);
      wf_ell(x1 - 20, y, 22, 70); wf_ell(x1 - 20, y, 19, 64);
      i = 1; loop(4, aa = -0.5*$pi + $pi*i/5; wf_line(a + 22*cos(aa) + 10, y + 70*sin(aa), x1 - 20 + 22*cos(aa) - 10, y + 70*sin(aa)); i += 1;);
    ) : (
      a = x0 + 30; wf_box(x0, y - 16, 30, 32, 16);
      wf_ell(x1 - 20, y, 22, 72); wf_ell(x1 - 20, y, 17, 60); wf_ell(x1 - 44, y, 7, 22);
      wf_line(x1 - 20, y - 60, x1 - 44, y - 22); wf_line(x1 - 20, y + 60, x1 - 44, y + 22);
      wf_lineh(a, y - 16, x1 - 44, y - 22); wf_lineh(a, y + 16, x1 - 44, y + 22);
    );
  ) : (
    opt == 0 ? (
      wf_bell(rz_fx, 880, rz_fy, min(rz_fr, 16), 62);
    ) : opt == 1 ? (
      xa = lay_bx0 + 30; xb = lay_bx1 - 60; yf = rz_top - 2; dx = 50*0.55; dy = -50*0.45;
      wf_mv(xa, yf); wf_to(xb, yf); wf_to(xb + dx, yf + dy); wf_to(xa + dx, yf + dy); wf_close();
      wf_mv(xa, yf); wf_to(xa, yf + 4); wf_to(xb, yf + 4); wf_to(xb, yf);
      wf_line(xb, yf + 4, xb + dx, yf + dy + 4); wf_line(xb + dx, yf + dy, xb + dx, yf + dy + 4);
      wf_ell(xa + (xb - xa)*0.35 + 0.5*dx, yf + 0.5*dy, 22, 7);
    ) : opt == 2 ? (
      cx = 0.5*(lay_bx0 + lay_bx1) - 10; yy = rz_top + 2;
      wf_ell(cx, yy, 150, 30); wf_ell(cx, yy, 158, 34);
      i = 0; loop(12, a = 2*$pi*i/12; wf_line(cx + 158*cos(a), yy + 34*sin(a), cx + 158*cos(a), yy + 34*sin(a) + 10); i += 1;);
    ) : (
      cx = rz_cone ? rz_cx : lay_bx1 - 100; yy = rz_cone ? rz_cy : 0.5*(lay_by0 + lay_by1);
      wf_ell(cx, yy, 34, 34); wf_ell(cx, yy, 26, 26); wf_ell(cx, yy, 9, 9);
      i = 0; loop(4, a = 0.25*$pi + 0.5*$pi*i; wf_ell(cx + 30*cos(a), yy + 30*sin(a), 1.8, 1.8); i += 1;);
    );
  );
);

// the exciter, touching the element at the origin, coming from -x
function wf_exc(opt)
(
  opt == 0 ? (
    wf_mv(-88, -10); wf_to(-22, -12); wf_to(0, -5); wf_to(0, 5); wf_to(-22, 10); wf_to(-88, 10);
    wf_arc(-88, 0, 3, 10, 0.5*$pi, 1.5*$pi);
    wf_line(-70, 12, -2, 7); wf_line(-70, 15, -2, 9);
    wf_ring(-58, 0, 14); wf_ring(-48, 0, 14);
  ) : opt == 1 ? (
    wf_chs(); wf_ch(-44, -30); wf_ch(-30, -26); wf_ch(-12, -20); wf_ch(0, -10); wf_ch(-3, -3); wf_ch(-24, -6); wf_ch(-44, -10); wf_chrun(2, 1); wf_chdraw(1, 1);
    wf_chs(); wf_ch(-44, 30); wf_ch(-30, 28); wf_ch(-12, 20); wf_ch(0, 10); wf_ch(-3, 3); wf_ch(-24, 7); wf_ch(-44, 12); wf_chrun(2, 1); wf_chdraw(1, 1);
    wf_chs(); wf_ch(-46, -42); wf_ch(-36, -36); wf_ch(-44, -30); wf_chrun(1, 0); wf_chdraw(0, 1);
  ) : opt == 2 ? (
    wf_chs(); wf_ch(-30, -14); wf_ch(-6, -12); wf_ch(0, 0); wf_ch(-6, 12); wf_ch(-30, 14); wf_ch(-36, 0); wf_chrun(2, 1); wf_chdraw(1, 1);
    wf_line(-24, 12, -24, 70); wf_line(-14, 13, -14, 70); wf_rect(-30, 70, 22, 10);
  ) : opt == 3 ? (
    wf_line(28, -70, -12, 78); wf_line(18, -72, -20, 70); wf_line(28, -70, 18, -72); wf_box(-26, 64, 16, 18, 10);
  ) : opt == 4 ? (
    wf_chs(); wf_ch(0, 0); wf_ch(-38, -20); wf_ch(-44, 0); wf_ch(-38, 20); wf_chrun(2, 1); wf_chdraw(1, 1);
  ) : (
    wf_ell(-16, 0, 16, 16); wf_arc(-16, 0, 16, 5, 0, $pi); wf_arch(-16, 0, 16, 5, $pi, 2*$pi);
    wf_line(-24, 14, -66, 82); wf_line(-18, 16, -60, 84);
  );
);
// the energy source, ending at the origin, coming from -x
function wf_energy(opt) local(k, i, x)
(
  opt == 0 ? (
    k = -1;
    loop(3,
      i = 0; loop(25, x = -84 + i*3; i == 0 ? wf_mv(x, k*13 + 4*sin(i*0.7 + k)) : wf_to(x, k*13 + 4*sin(i*0.7 + k)); i += 1;);
      wf_arrow(-12, k*13 + 4*sin(16.8 + k), 0.3*cos(16.8 + k), 6);
      k += 1;
    );
  ) : opt == 1 ? (
    wf_line(-40, -38, -40, 38); wf_arrow(-40, -38, -0.5*$pi, 8); wf_arrow(-40, 38, 0.5*$pi, 8);
    wf_lineh(-56, -26, -56, 26); wf_lineh(-24, -26, -24, 26);
  ) : opt == 2 ? (
    wf_chs(); wf_ch(-90, -8); wf_ch(-18, -8); wf_ch(-6, -5); wf_ch(-2, 0); wf_ch(-6, 6); wf_ch(-18, 8); wf_ch(-90, 8); wf_chrun(2, 0); wf_chdraw(0, 1);
    wf_chs(); wf_ch(-26, -8); wf_ch(-10, -6); wf_ch(-6, 0); wf_chrun(1, 0); wf_chdraw(0, 1);
    wf_lineh(-50, -8, -50, 8);
  ) : opt == 3 ? (
    wf_arc(-44, 30, 40, 40, -0.95*$pi, -0.15*$pi); wf_arrow(-44 + 40*cos(-0.15*$pi), 30 + 40*sin(-0.15*$pi), 0.35*$pi, 8);
  ) : opt == 4 ? (
    wf_push(-36, 6, -0.5, 1);
    wf_line(-50, 0, 0, 0); wf_line(-50, 6, 0, 6); wf_box(0, -14, 14, 34, 10); wf_line(0, -14, -8, -22);
    wf_pop();
  ) : (
    wf_mv(-50, -40); wf_to(-28, -40); wf_to(-38, -6); wf_to(-20, -6); wf_to(-52, 40); wf_to(-42, 4); wf_to(-60, 4); wf_close();
  );
);

function wf_freq(opt, md) local(x0, x1, k, x, a, b, yb, d, ky, kw)
(
  x0 = el_x0 + (el_x1 - el_x0)*0.18; x1 = el_x0 + (el_x1 - el_x0)*0.86;
  opt == 0 ? (
    // frets, closer together up the neck
    k = 0;
    while (x = x0 + (x1 - x0)*(1 - 2^(-k/7))*1.6; k < 9 && x <= x1) ( wf_line(x, el_bot + 3, x + 10, el_top - 2); k += 1; );
  ) : opt == 1 ? (
    k = 0; loop(6, x = x0 + (x1 - x0)*k/5; wf_ell(x, el_top + 4, 6, 2.6); wf_ell(x, el_top + 4, 3.5, 1.4); k += 1;);
  ) : opt == 2 ? (
    k = 0;
    loop(3,
      x = x0 + 30 + k*32; wf_vtube(x, el_top - 42, el_top, 8, 1); wf_vtube(x, el_top - 52, el_top - 44, 5, 1);
      wf_line(x - 8, el_bot, x - 8, el_bot + 16); wf_line(x + 8, el_bot, x + 8, el_bot + 16); wf_arc(x, el_bot + 16, 8, 2.6, 0, $pi);
      k += 1;
    );
  ) : opt == 3 ? (
    a = x0 + 40; b = x1 - 30; yb = el_bot + 4; d = 58;
    wf_line(a, yb, a, yb + d); wf_line(a + 10, yb, a + 10, yb + d - 10); wf_line(b, yb, b, yb + d); wf_line(b - 10, yb, b - 10, yb + d - 10);
    wf_line(a, yb + d, b, yb + d); wf_line(a + 10, yb + d - 10, b - 10, yb + d - 10);
    wf_line(a - 6, yb + d*0.45, a + 16, yb + d*0.45); wf_line(b - 16, yb + d*0.45, b + 6, yb + d*0.45);
  ) : (
    // a keyboard: under the element in a line, in front of the body in layers
    ky = el_bot + 14; md == 1 ? ( x0 = 28; x1 = 222; ky = el_y + 74; );
    kw = (x1 - x0)/10;
    k = 0; loop(10, wf_box(x0 + k*kw, ky, kw - 1.5, 9, 22); k += 1;);
    k = 0; loop(9, (k != 2 && k != 6) ? wf_box(x0 + (k + 0.68)*kw + 5, ky - 6, kw*0.55, 6, 13); k += 1;);
  );
);

function wf_tune(opt, x, y) local(k, px, py, a, b, yt)
(
  opt == 0 ? (
    wf_box(x - 22, y - 10, 26, 20, 16);
    wf_line(x - 14, y - 10, x - 14, y - 30); wf_ell(x - 14, y - 36, 7, 9);
    wf_line(x - 2, y - 6, x - 2, y - 30); wf_ell(x - 2, y - 36, 7, 9);
  ) : opt == 1 ? (
    wf_box(x - 30, y - 6, 36, 12, 18);
    k = 0; loop(4, px = x - 22 + k*8; py = y - 6 - k*2.5; wf_line(px, py, px, py - 16); wf_ell(px, py - 17, 2.4, 1.2); k += 1;);
  ) : opt == 2 ? (
    wf_box(x - 26, y - 8, 30, 10, 18); wf_vtube(x - 12, y - 30, y - 8, 4, 1); wf_ell(x - 12, y - 18, 9, 3);
    wf_line(x - 4, y - 14, x + 10, y - 14); wf_ell(x + 16, y - 14, 4, 8);
  ) : (
    a = x - 24; b = x + 6; yt = y - 40;
    wf_line(a, y - 4, a, yt); wf_line(a + 8, y - 4, a + 8, yt + 8); wf_line(b, y - 4, b, yt); wf_line(b - 8, y - 4, b - 8, yt + 8);
    wf_arc(0.5*(a + b), yt, 0.5*(b - a), 10, $pi, 2*$pi); wf_arc(0.5*(a + b), yt + 8, 0.5*(b - a) - 8, 6, $pi, 2*$pi);
  );
);

// mouth: the bell's mouth is at (mx, my), where a mute or a hand goes
function wf_damp(opt, mouth, mx, my) local(x, a)
(
  x = el_x0 + (el_x1 - el_x0)*0.9;
  opt == 0 ? (
    wf_line(x, el_top - 60, x, el_top - 16); wf_box(x - 10, el_top - 16, 20, 14, 14);
  ) : opt == 1 ? (
    mouth ? ( wf_ell(mx - 14, my, 6, 24); wf_ell(mx + 18, my, 12, 46); wf_line(mx - 14, my - 24, mx + 18, my - 46); wf_line(mx - 14, my + 24, mx + 18, my + 46); ) :
            ( wf_box(x - 12, el_top - 14, 24, 14, 16); wf_line(x - 12, el_top - 7, x - 20, el_top + 4); );
  ) : opt == 2 ? (
    wf_hand(x - 10, el_top - 10, 0.9, 0.08);
  ) : opt == 3 ? (
    a = el_x0 + (el_x1 - el_x0)*0.06; wf_box(a, el_top - 6, (el_x1 - el_x0)*0.1, 6, 18); wf_line(a + 10, el_top - 10, a + 10, el_top - 40);
  ) : (
    mouth ? wf_hand(mx - 10, my + 6, 1.1, -1.35) : wf_hand(x - 10, el_top - 10, 0.9, 0.08);
  );
);

// ytop: where the modulation part reaches up to (under the element, or the body)
function wf_mod(opt, ytop) local(base, k, x, a, b, ry, cx, yy, i, bx, by, t)
(
  base = lay_floor;
  opt == 0 ? (
    a = el_x0 + (el_x1 - el_x0)*0.25; b = el_x0 + (el_x1 - el_x0)*0.8; ry = max(ytop + 30, base - 34);
    wf_line(a, ry, b, ry);
    k = 0; loop(3, x = a + 20 + k*(b - a - 40)/2; wf_line(x, ry, x, ytop + 2); wf_ell(x, ry + 10, 9, 3); wf_line(x, ry, x, ry + 10); k += 1;);
  ) : opt == 1 ? (
    cx = lay_pedx; wf_box(cx - 50, base - 10, 100, 10, 30);
    k = 0; loop(3, x = cx - 34 + k*28; wf_mv(x, base - 10); wf_to(x + 10, base - 10); wf_to(x + 20, base - 36); wf_to(x + 10, base - 36); wf_close(); k += 1;);
    wf_lineh(cx, base - 30, cx, lay_pedtop);
  ) : opt == 2 ? (
    x = el_x0 + (el_x1 - el_x0)*0.55; wf_vtube(x, ytop + 4, ytop + 40, 7, 1); wf_line(x, ytop + 40, x + 40, ytop + 52); wf_ell(x + 44, ytop + 53, 6, 2.4);
  ) : opt == 3 ? (
    x = el_x0 + (el_x1 - el_x0)*0.4; yy = max(ytop + 34, base - 30);
    wf_line(x - 50, yy, x + 50, yy - 14); wf_mv(x - 6, yy + 10); wf_to(x, yy - 7); wf_to(x + 6, yy + 10); wf_close();
    i = 0; loop(9, i == 0 ? wf_mv(x + 28, yy - 12) : wf_to(x + 34 + (i % 2 ? 6 : -6), yy - 12 + i*(base - yy + 6)/8); i += 1;);
    wf_lineh(x - 50, yy, x - 50, ytop + 2);
  ) : (
    bx = lay_elx; by = base - 34; wf_box(bx, by, 80, 30, 26);
    wf_ell(bx + 20, by + 15, 6, 6); wf_ell(bx + 42, by + 15, 6, 6); wf_rect(bx + 58, by + 11, 12, 8);
    i = 0; loop(17, t = i/16; x = bx + 2 - t*60; yy = by + 15 + sin(t*$pi)*22 - t*t*(by + 15 - ytop - 4); i == 0 ? wf_mv(x, yy) : wf_to(x, yy); i += 1;);
  );
);

// The whole instrument from the twelve choices in WF_P, into buf: buf[0] is
// the number of segments, then six values each.
function wf_build(buf) local(md, cx, cxx, cyy)
(
  wf_reset(); wfbuf = buf; wfn = 0;
  md = WF_P[6] >= 2 ? 0 : 1; wf_mode = md;
  md == 0 ? (
    lay_ey = 176; lay_cx0 = 196; lay_cx1 = 262; lay_ex0 = 262; lay_ex1 = 520; lay_rx0 = 520; lay_rx1 = 712; lay_dx1 = 872;
    lay_floor = 352; lay_pedx = 640; lay_pedtop = 216; lay_elx = 610;
  ) : (
    lay_ey = 150; lay_ex0 = 176; lay_ex1 = 770; lay_bx0 = 240; lay_bx1 = 700; lay_by0 = 186; lay_by1 = 300; lay_cpx = 600; lay_cpy = 188;
    lay_floor = 352; lay_pedx = 470; lay_pedtop = 300; lay_elx = 740;
  );
  wfcat = 2; wf_element(WF_P[2], md);
  wfcat = 4; wf_res(WF_P[4], md);
  md == 1 ? lay_cpy = max(el_bot + 12, rz_top);
  wfcat = 6; wf_coupler(WF_P[6]);
  wfcat = 7; wf_rad(WF_P[7], md);
  md == 0 ? (
    cx = lay_cx0;
    wfcat = 1; WF_P[1] == 3 ? wf_push(cx - 30, lay_ey, 0, 1) : wf_push(cx, lay_ey, 0, 1); wf_exc(WF_P[1]); wf_pop();
    wfcat = 0; wf_push(cx - 100, lay_ey, 0, 1); wf_energy(WF_P[0]); wf_pop();
  ) : (
    cxx = el_x0 + (el_x1 - el_x0)*0.22; cyy = el_top + 2;
    wfcat = 1; WF_P[1] == 3 ? wf_push(cxx, el_y - 36, 0, 1) : wf_push(cxx, cyy, 0.5*$pi, 1); wf_exc(WF_P[1]); wf_pop();
    // the energy comes in from the upper right, mirrored, clear of the exciter
    wfcat = 0; wf_push(cxx + 34, max(48, el_top - 62), 0, -1); wf_energy(WF_P[0]); wf_pop();
  );
  wfcat = 8; wf_freq(WF_P[8], md);
  wfcat = 9; md == 0 ? wf_tune(WF_P[9], el_x0 + 26, el_top) : wf_tune(WF_P[9], el_x0 - 4, el_y);
  wfcat = 10; wf_damp(WF_P[10], WF_P[7] == 0, md == 0 ? lay_dx1 : 880, md == 0 ? lay_ey : rz_fy);
  wfcat = 11; wf_mod(WF_P[11], md == 0 ? max(el_bot, lay_ey + 22) : lay_by1);
  buf[0] = wfn;
);
// the bounding box of part c in buf, into (wbx0, wby0) - (wbx1, wby1)
function wf_bbox(buf, c) local(n, p, k)
(
  wbx0 = wby0 = 1000000; wbx1 = wby1 = -1000000; n = buf[0]; p = buf + 1; k = 0;
  loop(n,
    p[4] == c ? (
      wbx0 = min(wbx0, min(p[0], p[2])); wbx1 = max(wbx1, max(p[0], p[2]));
      wby0 = min(wby0, min(p[1], p[3])); wby1 = max(wby1, max(p[1], p[3]));
    );
    p += 6;
  );
);

// Word-wrapped text; returns the y below the last line.
// every word in the window is drawn through say(): it draws s at gfx_x, gfx_y
// in the current colour, as gfx_drawstr does. When the test host sets
// hig_audit it also writes down the colour and the box of each string, and
// with hig_notext it leaves the words out, so the host can measure the ground
// under every string (tools/hig.cpp, ADR 0023).
function say(s) local(tw, th, p)
(
  gfx_measurestr(s, tw, th);
  hig_audit && HIG_TXT[0] < HIG_TXT_MAX ? (
    p = HIG_TXT + 1 + HIG_TXT[0]*8;
    p[0] = gfx_r; p[1] = gfx_g; p[2] = gfx_b; p[3] = gfx_x; p[4] = gfx_y; p[5] = tw; p[6] = th;
    HIG_TXT[0] += 1;
  );
  hig_notext ? gfx_x += tw : gfx_drawstr(s);
);
function draw_wrapped(s, x, y, w, lh) local(n, k, ch, tw, th, cy)
(
  n = strlen(s); k = 0; cy = y;
  strcpy(#wl, ""); strcpy(#ww, "");
  while (k <= n) (
    ch = k < n ? str_getchar(s, k) : 32;
    ch == 32 ? (
      strcpy(#wt, #wl); strlen(#wt) ? strcat(#wt, " "); strcat(#wt, #ww);
      gfx_measurestr(#wt, tw, th);
      (tw > w && strlen(#wl)) ? ( cy + lh <= wrap_ymax ? ( gfx_x = x; gfx_y = cy; say(#wl); ) : wrap_ymax >= 0 ? wrap_cut += 1; cy += lh; strcpy(#wl, #ww); ) : strcpy(#wl, #wt);
      strcpy(#ww, "");
    ) : (
      strcpy_substr(#wc, s, k, 1); strcat(#ww, #wc);
    );
    k += 1;
  );
  strlen(#wl) ? ( cy + lh <= wrap_ymax ? ( gfx_x = x; gfx_y = cy; say(#wl); ) : wrap_ymax >= 0 ? wrap_cut += 1; );
  strlen(#wl) ? cy += lh;
  cy;
);

// ---- presets: the ten parts and two materials, then force, size,
// brightness, decay, position, resonator amount, play mode
PRESET_TAB = 13100; PRESET_STRIDE = 20; PRESET_N = 19;
function preset_name(k)
(
  k==0?"Bamboo Saxophone":k==1?"Ice Violin":k==2?"Marble Marimba":k==3?"Glass Trumpet":
  k==4?"Crystal Music Box":k==5?"Rubber Tuba":k==6?"Electric Bone Harp":k==7?"Clay Drum":
  k==8?"Jelly Gong":k==9?"Steel Flute":k==10?"Bowed Ice Bar":k==11?"Golden Piano":
  k==12?"Paper Accordion":k==13?"Carbon Trombone":k==14?"Buzzing Glockenspiel":k==15?"Bronze Bell Plate":
  k==16?"Plastic Recorder":k==17?"Cling Film Kazoo":"Tin Roof Banjo";
);
function pdef(k, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, f, sz, br, dc, ps, ra, mo) local(p)
(
  p = PRESET_TAB + k*PRESET_STRIDE;
  p[0] = a0; p[1] = a1; p[2] = a2; p[3] = a3; p[4] = a4; p[5] = a5; p[6] = a6; p[7] = a7;
  p[8] = a8; p[9] = a9; p[10] = a10; p[11] = a11; p[12] = f; p[13] = sz; p[14] = br; p[15] = dc;
  p[16] = ps; p[17] = ra; p[18] = mo;
);
//     en ex el elm rs rsm cp rd fc tm dm md  force size bright decay pos res mono
pdef( 0, 0, 0, 5, 12, 0, 12, 2, 0, 1, 2, 0, 0,  70, 100,   0, 100, 20, 50, 0);
pdef( 1, 1, 3, 0,  7, 1,  7, 0, 1, 0, 0, 0, 4,  70, 100,  10, 100, 15, 60, 0);
pdef( 2, 4, 5, 2,  8, 2,  8, 0, 1, 4, 2, 0, 1,  70, 100,   0, 100, 12, 60, 0);
pdef( 3, 0, 1, 5,  5, 0,  5, 2, 0, 2, 3, 0, 2,  75, 100,   0, 100, 20, 50, 0);
pdef( 4, 3, 4, 4,  6, 4,  6, 0, 1, 4, 2, 0, 1,  60, 100,  20, 100, 10, 50, 0);
pdef( 5, 0, 1, 5, 17, 0, 17, 2, 0, 2, 2, 0, 0,  80, 200,   0, 100, 20, 50, 0);
pdef( 6, 2, 4, 0, 13, 3, 13, 0, 3, 4, 1, 0, 4,  70, 100,   0, 100, 20, 40, 0);
pdef( 7, 4, 5, 1,  9, 3,  9, 1, 2, 4, 0, 2, 0,  80, 100,   0, 100, 30, 60, 0);
pdef( 8, 1, 5, 3, 19, 4, 19, 0, 1, 4, 0, 0, 1,  80, 150,   0, 150, 25, 50, 0);
pdef( 9, 0, 1, 5,  0, 2,  0, 3, 1, 1, 2, 0, 0,  70, 100,   0, 100, 20, 40, 0);
pdef(10, 1, 3, 2,  7, 2,  7, 0, 1, 4, 2, 0, 4,  70, 100,   0, 100,  8, 50, 0);
pdef(11, 2, 2, 0,  4, 1, 10, 0, 1, 4, 1, 0, 1,  70, 100,   0, 100, 12, 50, 0);
pdef(12, 0, 0, 4, 18, 3, 18, 3, 1, 4, 2, 0, 4,  70, 100,   0, 100, 20, 50, 0);
pdef(13, 0, 1, 5, 16, 0, 16, 2, 0, 3, 3, 0, 0,  75, 100,   0, 100, 20, 50, 1);
pdef(14, 5, 2, 2,  3, 2,  3, 0, 3, 4, 2, 0, 4,  60, 100,   0, 100, 15, 50, 0);
pdef(15, 4, 2, 3,  2, 4,  2, 0, 1, 4, 2, 0, 1,  80, 100,   0, 200, 20, 50, 0);
pdef(16, 0, 1, 5, 20, 2, 20, 3, 1, 1, 2, 0, 0,  65, 100,   0, 100, 20, 40, 0);
pdef(17, 0, 1, 1, 26, 3, 24, 2, 1, 4, 2, 0, 0,  90, 100,   0, 100, 20, 50, 0);
pdef(18, 3, 4, 0,  0, 3, 27, 0, 2, 0, 0, 0, 3,  75, 100,   0, 100, 12, 50, 0);

function apply_preset(k) local(p, j)
(
  p = PRESET_TAB + k*PRESET_STRIDE; j = 0;
  loop(19, slider(j + 1) = p[j]; j += 1;);
  slider_automate(2^19 - 1);
  gui_dirty = 1; cur_preset = k;
);
function set_part(c, val)
(
  val = max(0, min(cat_count(c) - 1, val));
  slider(c + 1) = val;
  slider_automate(2^c);
  gui_dirty = 1; last_cat = c; cur_preset = -1;
);
function randomise() local(c)
(
  c = 0; loop(12, slider(c + 1) = floor(rand(cat_count(c))); c += 1;);
  slider_automate(2^12 - 1);
  gui_dirty = 1; cur_preset = -1;
);
cur_preset = 0; last_cat = 2; aud_note = 60; wrap_ymax = 1000000; drag_k = -1; pop_c = -1; wf_optc = -1;

@slider
update_globals();

@block
// MIDI into a queue, handled at the right sample in @sample
nq = 0;
while (midirecv(mofs, m1, m2, m3)) (
  nq < MIDIQ_MAX ? ( MIDIQ[nq*4] = mofs; MIDIQ[nq*4+1] = m1; MIDIQ[nq*4+2] = m2; MIDIQ[nq*4+3] = m3; nq += 1; );
);
// audition request from the GUI
aud_req ? (
  nq < MIDIQ_MAX ? ( MIDIQ[nq*4] = 0; MIDIQ[nq*4+1] = 0x90; MIDIQ[nq*4+2] = aud_note; MIDIQ[nq*4+3] = 100; nq += 1; );
  aud_req = 0; aud_left = 1.2*srate; aud_on = 1;
);
aud_on ? (
  aud_left -= samplesblock;
  aud_left <= 0 ? ( nq < MIDIQ_MAX ? ( MIDIQ[nq*4] = 0; MIDIQ[nq*4+1] = 0x80; MIDIQ[nq*4+2] = aud_note; MIDIQ[nq*4+3] = 0; nq += 1; ); aud_on = 0; );
);
gui_dirty ? ( update_globals(); gui_dirty = 0; );
qi = 0; spos = 0;
expr = cc11*(breath_seen ? cc2 : 1);

@sample
while (qi < nq && MIDIQ[qi*4] <= spos) (
  st = MIDIQ[qi*4+1] & 0xF0; d1 = MIDIQ[qi*4+2]; d2 = MIDIQ[qi*4+3];
  st == 0x90 && d2 > 0 ? note_on(d1, d2) :
  (st == 0x80 || (st == 0x90 && d2 == 0)) ? note_off(d1) :
  st == 0xE0 ? bend = ((d2*128 + d1) - 8192)/8192 :
  st == 0xD0 ? at_press = d1/127 :
  st == 0xB0 ? (
    d1 == 1 ? mw = d2/127 :
    d1 == 2 ? ( cc2 = d2/127; breath_seen = 1; expr = cc11*cc2; ) :
    d1 == 11 ? ( cc11 = d2/127; expr = cc11*(breath_seen ? cc2 : 1); ) :
    d1 == 64 ? ( sustain = d2 >= 64; !sustain ? pedal_up(); ) :
    d1 == 67 ? soft_ped = d2 >= 64 :
    (d1 == 120 || d1 == 123) ? all_off();
  );
  qi += 1;
);
spos += 1;

// control rate: every 16 samples
ctl_ctr -= 1;
ctl_ctr <= 0 ? (
  ctl_ctr = 16;
  t_now += 16*dt;
  lfo_ph += 16*dt*5.5; lfo_ph >= 1 ? lfo_ph -= 1;
  mod_st = md_type == 2 ? -0.4*mw : md_type == 3 ? 2*mw : md_type == 4 ? 0.3*mw*sin(2*$pi*lfo_ph) : 0;
  trem = md_type == 4 ? 1 - 0.3*mw*(0.5 + 0.5*sin(2*$pi*lfo_ph + 1.2)) : md_type == 2 ? 1 - 0.3*mw : 1;
  vi = 0;
  loop(VOICES_MAX, vv = VOICE_BASE + vi*VOICE_STRIDE; vv[V_ON] ? voice_control(vv); vi += 1;);
);

sel = 0; ser = 0; srl = 0; srr = 0; nact = 0;
vi = 0;
loop(VOICES_MAX,
  vv = VOICE_BASE + vi*VOICE_STRIDE;
  vv[V_ON] ? (
    voice_tick(vv);
    sel += vo_dir*vv[V_PANL]; ser += vo_dir*vv[V_PANR];
    srl += vo_res*vv[V_PANL]; srr += vo_res*vv[V_PANR];
    nact += 1;
  );
  vi += 1;
);

// coupler and resonator
(rs == 0 || rs == 2) ? (
  xl = sel + res_amt*(srl - sel); xr = ser + res_amt*(srr - ser);
  xl = bq(BIQ_COEF + 5, BIQ_STATE + 4, bq(BIQ_COEF, BIQ_STATE, xl));
  xr = bq(BIQ_COEF + 5, BIQ_STATE + 12, bq(BIQ_COEF, BIQ_STATE + 8, xr));
) : (
  xl = bq(BIQ_COEF + 5, BIQ_STATE + 4, bq(BIQ_COEF, BIQ_STATE, sel));
  xr = bq(BIQ_COEF + 5, BIQ_STATE + 12, bq(BIQ_COEF, BIQ_STATE + 8, ser));
  xm = 0.5*(xl + xr); xm2 = xm - bx2; bx2 = bx1; bx1 = xm;
  bl = 0; br_ = 0; p = BODY_BASE;
  loop(body_n, y = p[0]*p[2] - p[1]*p[3] + p[4]*xm2; p[3] = p[2]; p[2] = y; bl += y*p[5]; br_ += y*p[6]; p += BODY_STRIDE;);
  xl += res_amt*(3*bl - xl); xr += res_amt*(3*br_ - xr);
);

// radiator
o = BIQ_COEF + 10;
yl = bq(o + 10, BIQ_STATE + 36, bq(o + 5, BIQ_STATE + 32, bq(o, BIQ_STATE + 28, xl)));
yr = bq(o + 10, BIQ_STATE + 48, bq(o + 5, BIQ_STATE + 44, bq(o, BIQ_STATE + 40, xr)));
rd == 0 ? (
  yl = tanh_(1.3*yl)/1.3; yr = tanh_(1.3*yr)/1.3;
) : rd == 1 ? (
  // soundboard: four allpass diffusers per side spread the sound out
  dl = yl; dr = yr; dk = 0;
  loop(4,
    bufd = DIFF_BASE + dk*DIFF_LEN; w = DIFF_W[dk];
    z = bufd[(w - DIFF_TMP[dk] + DIFF_LEN) % DIFF_LEN];
    u = dl + 0.6*z; bufd[w] = u; dl = z - 0.6*u;
    DIFF_W[dk] = (w + 1) % DIFF_LEN;
    bufd = DIFF_BASE + (dk + 4)*DIFF_LEN; w = DIFF_W[dk + 4];
    z = bufd[(w - DIFF_TMP[dk + 4] + DIFF_LEN) % DIFF_LEN];
    u = dr + 0.6*z; bufd[w] = u; dr = z - 0.6*u;
    DIFF_W[dk + 4] = (w + 1) % DIFF_LEN;
    dk += 1;
  );
  yl = 0.6*yl + 0.55*dl; yr = 0.6*yr + 0.55*dr;
) : rd == 2 ? (
  hm = 0.5*(yl + yr); hm2 = hm - hx2; hx2 = hx1; hx1 = hm;
  hl = 0; hr = 0; p = HEAD_BASE;
  loop(HEAD_MAX, y = p[0]*p[2] - p[1]*p[3] + p[4]*hm2; p[3] = p[2]; p[2] = y; hl += y*p[5]; hr += y*p[6]; p += 8;);
  yl += 2*hl; yr += 2*hr;
) : (
  yl = tanh_(2*yl)*0.5; yr = tanh_(2*yr)*0.5;
);

// age make-up gain (see update_globals)
gl = out_g*trem*master_trim*age_gain;
yl *= gl; yr *= gl;
// safety limiter: instant attack, slow release, only acts above -3 dBFS
sab = max(abs(yl), abs(yr));
lim_env = sab > lim_env ? sab : lim_env*lim_rel;
lim_g = lim_env > 0.7 ? 0.7/lim_env : 1;
yl *= lim_g; yr *= lim_g;
// soft ceiling
sab = abs(yl); sab > 0.9 ? yl = sign(yl)*(0.9 + 0.1*tanh_((sab - 0.9)*10));
sab = abs(yr); sab > 0.9 ? yr = sign(yr)*(0.9 + 0.1*tanh_((sab - 0.9)*10));
spl0 = yl; spl1 = yr;
vis_lvl = max(abs(yl), vis_lvl*vis_dec);
SCOPE_BUF[scope_w] = 0.5*(yl + yr); scope_w = (scope_w + 1) & (SCOPE_LEN - 1);

@serialize
// The window's own preferences, kept with the project (ADR 0023): the
// interface size and Reduce Motion. Nothing the sound reads is here, and the
// sliders are saved by REAPER as before. An older project has neither and
// reads back as 100% with motion on.
file_var(0, ui_zoom);
file_var(0, calm);
(ui_zoom != 1.25 && ui_zoom != 1.5 && ui_zoom != 2) ? ui_zoom = 1;
calm = calm > 0.5;

@gfx 940 720

// ---- one scale for every size in the window: Retina (ADR 0021) times the
// interface size chosen under Options (ADR 0023)
ui_zoom < 1 ? ui_zoom = 1;
// A size the window cannot hold is drawn as large as the window allows (the
// layout needs 800 x 480 points at 100%), never below 100%: nothing is pushed
// off the window, which cannot scroll. Options still ticks the size chosen,
// and it comes back when the window is made larger (final sweep, ADR 0023).
ret_ = max(1, gfx_ext_retina);
zoom_fit = max(1, min(ui_zoom, min(gfx_w/(800*ret_), gfx_h/(480*ret_))));
gsc = ret_*zoom_fit;
// Reduce Motion stills the sounding element's tremble
calm ? anim_ph = 0 : ( anim_ph += 0.3; anim_ph > 628.3 ? anim_ph -= 628.3; );
gw = gfx_w; gh = gfx_h;

// ---- colours (0xRRGGBB). Every word is at least 7:1 on what it sits on
// (ADR 0023); tools/hig_check.py measures each one on the real pixels.
C_WIN = 0x1B1C20; C_TILE = 0x25262D; C_TILE_HOV = 0x30333D; C_PREV = 0x212228; C_SUNK = 0x17181C;
C_BTN = 0x2E303B; C_BTN_HOV = 0x404552; C_ON = 0x2B4C80; C_EDGE = 0x6D7581; C_SEG = 0x1C1D21; C_MAT_HOV = 0x3D424F;
C_POP = 0x30323C;    // the picker: a raised surface, lighter than the window (ADR 0024)
C_CTX = 0x5C626E;    // the rest of the instrument behind a part in the picker
T_MAIN = 0xF2F2F7;   // names, values, button labels: 11:1 or more
T_BODY = 0xCCD1DE;   // descriptions and messages: 10:1 on the close-up
T_DIM = 0xB0B6C0;    // secondary words on the window and the close-up: 7.8:1 or more
T_LABEL = 0xC4C9D2;  // captions and control names on a label, cell or the picker: 7.6:1 even hovered
T_HINT = 0x8CD999;   // the hint and a control's value in the close-up: 9.4:1
T_AGE = 0xF5B48A;    // the age note: 9.5:1
T_ELEM = 0x7FD8F5; T_RES = 0x8EE29A;  // a material's name, in its group's hue: 7.8:1 hovered
C_RING = 0xF2F4F7;   // the keyboard focus ring
// edges (final sweep): C_EDGE outlines every button, label and control
// cell, 3.7:1 on the window; C_TRACK outlines what sits inside a cell (a
// slider's track, Play Mode's two halves), 3.5:1 on the cell even hovered
C_TRACK = 0x80879A;
function col(c) ( gfx_set(((c >> 16) & 255)/255, ((c >> 8) & 255)/255, (c & 255)/255, 1); );
// an outline in colour c, inside (x, y, w, h), thicker at larger sizes
function edge(c, x, y, w, h) local(k)
(
  col(c); k = 0;
  loop(max(1, floor(gsc + 0.5)), gfx_rect(x + k, y + k, w - 2*k, h - 2*k, 0); k += 1;);
);
// a filled rectangle with round corners (antialiased)
function rfill(x, y, w, h, r) local(rr)
(
  rr = floor(min(r, 0.5*min(w, h)));
  rr < 1 ? gfx_rect(x, y, w, h, 1) : (
    gfx_rect(x + rr, y, w - 2*rr, h, 1);
    gfx_rect(x, y + rr, rr, h - 2*rr, 1); gfx_rect(x + w - rr, y + rr, rr, h - 2*rr, 1);
    gfx_circle(x + rr, y + rr, rr, 1, 1); gfx_circle(x + w - 1 - rr, y + rr, rr, 1, 1);
    gfx_circle(x + rr, y + h - 1 - rr, rr, 1, 1); gfx_circle(x + w - 1 - rr, y + h - 1 - rr, rr, 1, 1);
  );
);
// the shape of every button, label and cell: rounded, filled, and edged in
// ec, 3:1 on the window (final sweep), thicker at larger sizes
function rbox(x, y, w, h, r, fill, ec) local(t)
(
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  t = max(1, floor(gsc + 0.5));
  col(ec); rfill(x, y, w, h, r);
  col(fill); rfill(x + t, y + t, w - 2*t, h - 2*t, max(0, r - t));
);
col(C_WIN); gfx_rect(0, 0, gw, gh, 1);

// ---- the system's own typeface: Segoe UI on Windows, San Francisco on a
// Mac, else Arial. gfx_getfont names the face actually given, so a missing
// font is caught rather than guessed. Nothing is under 10 px at 100%.
function pick_font()
(
  gfx_setfont(1, "Segoe UI", 13, 0); gfx_getfont(#fgot);
  matchi("Segoe UI*", #fgot) ? ( strcpy(#ui_font, "Segoe UI"); font_kind = 1; ) : (
    gfx_setfont(1, ".AppleSystemUIFont", 13, 0); gfx_getfont(#fgot);
    (matchi("*System*", #fgot) || matchi("*SF*", #fgot)) ? ( strcpy(#ui_font, ".AppleSystemUIFont"); font_kind = 2; ) :
                                                           ( strcpy(#ui_font, "Arial"); font_kind = 3; );
  );
  font_ready = 1;
);
!font_ready ? pick_font();
gfx_setfont(1, #ui_font, 13*gsc);
gfx_setfont(2, #ui_font, 15*gsc, 'b');
gfx_setfont(3, #ui_font, 19*gsc, 'b');
gfx_setfont(4, #ui_font, 10*gsc, 'b');
gfx_setfont(5, #ui_font, 19*gsc, 'b');

clicked = (mouse_cap & 1) && !(last_cap & 1);
last_cap = mouse_cap;
wheel = mouse_wheel; mouse_wheel = 0;
hov = -1; hovc = -1; focc = -1;
// one key a frame; Tab, Return, Space, the arrows, Delete and Esc are used
key = gfx_getchar(); key < 0 ? key = 0;
clicked ? focus_id = 0;     // pointing takes over from the keyboard
fl_n = 0; fr_on = 0; wrap_cut = 0;   // lines of a wrapped text that did not fit (none should)
hig_audit ? HIG_TXT[0] = 0;
// While the picker is open it has the mouse and the keyboard to itself: a
// click anywhere else only closes it (ADR 0024). inbox() and focusable()
// below ignore everything else while ui_block is set.
ui_block = pop_c >= 0;
pclick = clicked; pwheel = wheel;
// A preset or Surprise Me replaces the whole instrument. The frame that asks
// for it adds a REAPER undo point (sliderchange(-1) from @gfx); this one makes
// the change and adds another, so Edit -> Undo puts back the instrument as it
// was, controls included (final sweep, ADR 0023).
want_preset || want_rand ? (
  want_preset ? apply_preset(want_preset - 1) : randomise();
  sliderchange(-1); want_preset = 0; want_rand = 0;
);

function inbox(x, y, w, h) ( !ui_block && mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h; );
// the same for the picker, which is not blocked by itself
function pinbox(x, y, w, h) ( mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h; );

// ---- keyboard focus (ADR 0023). Every control registers itself as it is
// drawn, so Tab and Shift+Tab move through them in the order they are drawn:
// top to bottom, then the parts in the order the energy flows. While the
// picker is open only its own controls take part (ids 70 and up). The ring is
// drawn last, over everything, round the focused control.
function focusable(id, x, y, w, h) local(p)
(
  (ui_block && id < 70) ? 0 : (
    fl_n < FOCUS_MAX ? ( p = FOCUS_TAB + fl_n*5; p[0] = id; p[1] = x; p[2] = y; p[3] = w; p[4] = h; fl_n += 1; );
    focus_id == id ? ( fr_on = 1; fr_x = x; fr_y = y; fr_w = w; fr_h = h; );
    focus_id == id;
  );
);
// Return or Space presses the focused control
function activated(id) ( (focus_id == id && (key == 13 || key == 32)) ? ( key = 0; 1; ) : 0; );

// a button 28 px tall, never narrower than its label. On (Playing…), it is
// blue and has a bar under its label, so colour is not the only sign.
function bwidth(s) local(tw, th) ( gfx_setfont(2); gfx_measurestr(s, tw, th); max(72*gsc, tw + 28*gsc); );
function button(id, x, y, w, h, s, on) local(hv, tw, th, f)
(
  f = focusable(id, x, y, w, h);
  hv = id >= 70 ? pinbox(x, y, w, h) : inbox(x, y, w, h);
  // (inside the picker the edge is the lighter grey, 3:1 on its raised surface)
  rbox(x, y, w, h, 6*gsc, on ? C_ON : hv ? C_BTN_HOV : C_BTN, id >= 70 ? C_TRACK : C_EDGE);
  gfx_setfont(2); col(T_MAIN);
  gfx_measurestr(s, tw, th); gfx_x = x + 0.5*(w - tw); gfx_y = y + 0.5*(h - th) - (on ? gsc : 0); say(s);
  on ? gfx_rect(x + 0.5*(w - tw), y + h - 5*gsc, tw, max(1, 2*gsc), 1);
  (hv && (id >= 70 ? pclick : clicked)) || activated(id);
);
// the four kinds of part have a colour each: energy and exciter orange, the
// element blue, resonator, coupler and radiator green, the controls purple
function group_hex(c) ( c <= 1 ? 0xF29940 : c <= 3 ? 0x59CCF2 : c <= 7 ? 0x73D980 : 0xB88CF2; );
function group_col(c) ( col(group_hex(c)); );
// the material category (3 or 5) that a part is made of, or -1
function mat_cat(c) ( c == 2 ? 3 : (c == 4 || c == 6 || c == 7) ? 5 : -1; );
function is_metal(m) ( m <= 4 || m == 25 || m >= 27; );
// A part's colour in the drawing: its group's, turning towards rust as Age
// goes up when it is made of a material (metals most), as the pictures did
// (ADR 0018). Every shade stays 3:1 or more on the window.
function part_col(c) local(h, r, g, b, m, a)
(
  h = group_hex(c); r = ((h >> 16) & 255)/255; g = ((h >> 8) & 255)/255; b = (h & 255)/255;
  m = mat_cat(c);
  (m >= 0 && age_ > 0.02) ? (
    m = slider(m + 1)|0; a = age_*(is_metal(m) ? 0.8 : 0.45);
    r += a*(0.80 - r); g += a*(0.50 - g); b += a*(0.33 - b);
  );
  gfx_set(r, g, b, 1);
);
// a part's kind in title style, for the picker's heading
function cat_name(c)
(
  c==0?"Energy Source" : c==1?"Exciter" : c==2?"Vibrating Element" : c==3?"Element Material" :
  c==4?"Resonator" : c==5?"Resonator Material" : c==6?"Coupler" : c==7?"Radiator" :
  c==8?"Frequency Control" : c==9?"Tuning Mechanism" : c==10?"Damping" : "Modulation / Control";
);
// the 31 materials, for a part made of one, opened at (mx, my)
function mat_menu(mc, mx, my) local(k, r)
(
  strcpy(#menu, ""); k = 0;
  loop(MAT_N, k > 0 ? strcat(#menu, "|"); (slider(mc + 1)|0) == k ? strcat(#menu, "!"); strcat(#menu, mat_name(k)); k += 1;);
  gfx_x = mx; gfx_y = my;
  r = gfx_showmenu(#menu);
  r > 0 ? set_part(mc, r - 1);
);

// ---- the drawing (ADR 0024): the segments built by wf_build, drawn with
// antialiased lines that grow with the interface size
function wline(x1, y1, x2, y2, t) local(dx, dy, l, nx, ny, n, o, s)
(
  dx = x2 - x1; dy = y2 - y1; l = max(0.001, sqrt(dx*dx + dy*dy)); nx = -dy/l; ny = dx/l;
  n = max(1, floor(t + 0.5)); s = t/n; o = -0.5*(n - 1)*s;
  loop(n, gfx_line(x1 + nx*o, y1 + ny*o, x2 + nx*o, y2 + ny*o, 1); o += s;);
);
// an edge hidden behind the part, dashed; the dashes carry on round a curve
function wdash(x1, y1, x2, y2, t) local(dx, dy, l, on, per, a, m, sl, n)
(
  (abs(x1 - wd_lx) > 0.5 || abs(y1 - wd_ly) > 0.5) ? wd_ph = 0;
  dx = x2 - x1; dy = y2 - y1; l = sqrt(dx*dx + dy*dy); on = 4*gsc; per = 7*gsc; a = 0; n = 0;
  // (every step moves at least a hundredth of a pixel, so rounding can't stall it)
  while (a < l - 0.01 && n < 1000) (
    m = wd_ph - floor(wd_ph/per)*per;
    m < on - 0.01 ? (
      sl = min(on - m, l - a);
      wline(x1 + dx*a/l, y1 + dy*a/l, x1 + dx*(a + sl)/l, y1 + dy*(a + sl)/l, t);
    ) : sl = min(per - m, l - a);
    sl = max(sl, 0.01); a += sl; wd_ph += sl; n += 1;
  );
  wd_lx = x2; wd_ly = y2;
);
// keep the part of (x0, y0)-(x1, y1) inside a box (Liang-Barsky): 1 if any is
function wclip(x0, y0, x1, y1, xa, ya, xb, yb) local(t0, t1, dx, dy, p, q, r, k, ok)
(
  t0 = 0; t1 = 1; dx = x1 - x0; dy = y1 - y0; ok = 1; k = 0;
  loop(4,
    p = k == 0 ? -dx : k == 1 ? dx : k == 2 ? -dy : dy;
    q = k == 0 ? x0 - xa : k == 1 ? xb - x0 : k == 2 ? y0 - ya : yb - y0;
    p == 0 ? ( q < 0 ? ok = 0; ) : (
      r = q/p;
      p < 0 ? ( r > t1 ? ok = 0 : r > t0 ? t0 = r; ) : ( r < t0 ? ok = 0 : r < t1 ? t1 = r; );
    );
    k += 1;
  );
  ok ? ( wcx0 = x0 + t0*dx; wcy0 = y0 + t0*dy; wcx1 = x0 + t1*dx; wcy1 = y0 + t1*dy; );
  ok;
);
// Draw buf at scale s from (ox, oy). The instrument (one < 0): every part in
// its colour, part hl heavier, the element trembling while it sounds. The
// picker (one = a part): that part in its colour and the rest faint, clipped
// to the cell.
function wf_draw(buf, s, ox, oy, hl, one, xa, ya, xb, yb) local(n, p, c, x1, y1, x2, y2, t, u1, u2, ok)
(
  n = buf[0]; p = buf + 1; wd_lx = -1000000;
  loop(n,
    c = p[4]; x1 = p[0]; y1 = p[1]; x2 = p[2]; y2 = p[3];
    (one < 0 && c == 2 && wf_vib != 0) ? (
      u1 = max(0, min(1, (x1 - wm_ex0)/max(1, wm_ex1 - wm_ex0))); u2 = max(0, min(1, (x2 - wm_ex0)/max(1, wm_ex1 - wm_ex0)));
      y1 += wf_vib*sin($pi*u1); y2 += wf_vib*sin($pi*u2);
    );
    x1 = ox + s*x1; y1 = oy + s*y1; x2 = ox + s*x2; y2 = oy + s*y2;
    ok = one < 0 ? 1 : wclip(x1, y1, x2, y2, xa, ya, xb, yb);
    one >= 0 && ok ? ( x1 = wcx0; y1 = wcy0; x2 = wcx1; y2 = wcy1; );
    ok ? (
      one >= 0 ? ( c == one ? part_col(c) : col(C_CTX); t = (c == one ? 1.6 : 1)*gsc; ) :
                 ( part_col(c); t = (c == hl ? 2.4 : 1.4)*gsc; );
      p[5] ? wdash(x1, y1, x2, y2, t) : ( wline(x1, y1, x2, y2, t); wd_lx = -1000000; );
    );
    p += 6;
  );
);
// the part whose lines pass within r px of the mouse, or -1
function wf_hit(buf, s, ox, oy, r) local(n, p, best, bc, x1, y1, dx, dy, t, ex, ey, d)
(
  n = buf[0]; p = buf + 1; best = r*r; bc = -1;
  loop(n,
    x1 = ox + s*p[0]; y1 = oy + s*p[1]; dx = s*(p[2] - p[0]); dy = s*(p[3] - p[1]);
    t = max(0, min(1, ((mouse_x - x1)*dx + (mouse_y - y1)*dy)/max(0.0001, dx*dx + dy*dy)));
    ex = x1 + t*dx - mouse_x; ey = y1 + t*dy - mouse_y; d = ex*ex + ey*ey;
    d < best ? ( best = d; bc = p[4]; );
    p += 6;
  );
  bc;
);
// each part's anchor for its label's line: its own point nearest the middle
// of its side facing the label's row (target at +12, +13; anchor to +4, +5)
function wf_anchors(buf, s, ox, oy) local(n, p, c, q, x, y, d, j)
(
  c = 0; loop(12, CAT_TAB[c*CAT_STRIDE + 14] = 1000000000; c += 1;);
  n = buf[0]; p = buf + 1;
  loop(n,
    q = CAT_TAB + p[4]*CAT_STRIDE; j = 0;
    loop(2,
      x = ox + s*p[j*2]; y = oy + s*p[j*2 + 1];
      d = 0.15*(x - q[12])*(x - q[12]) + (y - q[13])*(y - q[13]);
      d < q[14] ? ( q[14] = d; q[4] = x; q[5] = y; );
      j += 1;
    );
    p += 6;
  );
);

// ---- the labels round the drawing. Each part's label sits above the drawing
// (row 0) or below it (row 1), as near over its part as the others allow,
// with a line to the part. lv says how much each label holds when a row is
// short of room: 0 the full caption, 1 a short one, 2 a short one and the
// name in the smaller font, 3 no caption. A name is never cut short.
LAB_ORD = WF_AUX + 2470;
function lab_rows() local(c)
(
  c = 0; loop(12, CAT_TAB[c*CAT_STRIDE + 6] = -1; c += 1;);
  c = 0;
  loop(12,
    (c != 3 && c != 5) ? CAT_TAB[c*CAT_STRIDE + 6] =
      wm_mode == 0 ? ((c == 0 || c == 1 || c == 9 || c == 8 || c == 10) ? 0 : 1) :
                     ((c == 0 || c == 1 || c == 9 || c == 2 || c == 10 || (c == 8 && (slider(9)|0) != 4)) ? 0 : 1);
    c += 1;
  );
);
function lab_w(c, lv) local(tw, th, w, mc)
(
  w = 0;
  lv < 3 ? ( gfx_setfont(4); gfx_measurestr(lv == 0 ? cat_title(c) : cat_short(c), tw, th); w = tw; );
  gfx_setfont(lv < 2 ? 2 : 1); gfx_measurestr(opt_name(c, slider(c + 1)|0), tw, th); w = max(w, tw);
  mc = mat_cat(c); mc >= 0 ? ( gfx_setfont(1); gfx_measurestr(mat_name(slider(mc + 1)|0), tw, th); w = max(w, tw); );
  ceil(w + 24*gsc);
);
function row_w(row, lv) local(c, s, n)
(
  s = 0; n = 0; c = 0;
  loop(12, CAT_TAB[c*CAT_STRIDE + 6] == row ? ( s += lab_w(c, lv); n += 1; ); c += 1;);
  s + max(0, n - 1)*12*gsc;
);
function lab_place(row, y, lv, lh) local(n, i, j, c, t, x, mr, q)
(
  n = 0; c = 0;
  loop(12, CAT_TAB[c*CAT_STRIDE + 6] == row ? ( LAB_ORD[n] = c; n += 1; ); c += 1;);
  // in order of their anchors, left to right
  i = 1;
  loop(max(0, n - 1),
    t = LAB_ORD[i]; j = i - 1;
    while (j >= 0 && CAT_TAB[LAB_ORD[j]*CAT_STRIDE + 4] > CAT_TAB[t*CAT_STRIDE + 4]) ( LAB_ORD[j + 1] = LAB_ORD[j]; j -= 1; );
    LAB_ORD[j + 1] = t; i += 1;
  );
  x = pad; i = 0;
  loop(n,
    q = CAT_TAB + LAB_ORD[i]*CAT_STRIDE;
    q[8] = lab_w(LAB_ORD[i], lv); q[7] = max(x, floor(q[4] - 0.5*q[8])); q[9] = y; q[10] = lh;
    x = q[7] + q[8] + 12*gsc; i += 1;
  );
  mr = gw - pad; i = n - 1;
  loop(n, q = CAT_TAB + LAB_ORD[i]*CAT_STRIDE; q[7] + q[8] > mr ? q[7] = mr - q[8]; mr = q[7] - 12*gsc; i -= 1;);
);
// open the picker for part c (kb: from the keyboard, so its focus goes in)
function pop_open(c, kb) ( pop_c = c; pop_kb = kb; focus_id = kb ? 70 + (slider(c + 1)|0) : 0; wf_optc = -1; );
// one label: a coloured tab, the kind of part, the option and (for parts
// made of one) the material. Click for the picker; scroll to step (over the
// material: step the material). From the keyboard: Return or Space opens the
// picker, the arrow keys step.
function label(c, lv) local(q, x, y, w, h, v, mc, m, f, hv, onm, tw, th, tx, ty, s, t1, t2, t4, bh, on)
(
  q = CAT_TAB + c*CAT_STRIDE; x = q[7]; y = q[9]; w = q[8]; h = q[10];
  v = slider(c + 1)|0; mc = mat_cat(c); on = c == hl;
  f = focusable(10 + c, x, y, w, h); f ? focc = c;
  hv = inbox(x, y, w, h);
  rbox(x, y, w, h, 6*gsc, hv ? C_TILE_HOV : C_TILE, on ? group_hex(c) : C_EDGE);
  // the tab: longer on the part lit up in the drawing
  group_col(c); rfill(x + 10*gsc, y + 4*gsc, on ? w - 20*gsc : 18*gsc, 3*gsc, 1.5*gsc);
  gfx_setfont(4); gfx_measurestr("A", tw, t4); gfx_setfont(lv < 2 ? 2 : 1); gfx_measurestr("A", tw, t2); gfx_setfont(1); gfx_measurestr("A", tw, t1);
  bh = (lv < 3 ? t4 + gsc : 0) + t2 + (mc >= 0 ? t1 : 0);
  tx = x + 12*gsc; ty = y + 9*gsc + 0.5*(h - 14*gsc - bh);
  lv < 3 ? ( gfx_setfont(4); col(T_LABEL); gfx_x = tx; gfx_y = ty; say(lv == 0 ? cat_title(c) : cat_short(c)); ty += t4 + gsc; );
  gfx_setfont(lv < 2 ? 2 : 1); col(T_MAIN); gfx_x = tx; gfx_y = ty; say(opt_name(c, v)); ty += t2;
  onm = 0;
  mc >= 0 ? (
    m = slider(mc + 1)|0; s = mat_name(m); gfx_setfont(1); gfx_measurestr(s, tw, th);
    onm = inbox(tx - 4*gsc, ty, tw + 8*gsc, t1); onm ? hov = mc;
    col(mc == 3 ? T_ELEM : T_RES); gfx_x = tx; gfx_y = ty; say(s);
  );
  hv && clicked ? pop_open(c, 0);
  hv && wheel != 0 ? (
    onm ? set_part(mc, (m + (wheel > 0 ? MAT_N - 1 : 1)) % MAT_N) :
          set_part(c, (v + (wheel > 0 ? cat_count(c) - 1 : 1)) % cat_count(c));
  );
  f ? (
    (key == 'rght' || key == 'down') ? ( key = 0; set_part(c, (v + 1) % cat_count(c)); ) :
    (key == 'left' || key == 'up') ? ( key = 0; set_part(c, (v + cat_count(c) - 1) % cat_count(c)); );
    activated(10 + c) ? pop_open(c, 1);
  );
);
// strings the picker covers can't be seen: the test host's audit forgets them
function hig_forget(x, y, w, h) local(n, i, j, k, p, q)
(
  n = HIG_TXT[0]; i = 0; j = 0;
  loop(n,
    p = HIG_TXT + 1 + i*8;
    (p[3] + p[5] > x && p[3] < x + w && p[4] + p[6] > y && p[4] < y + h) ? 0 : (
      q = HIG_TXT + 1 + j*8; k = 0; loop(8, q[k] = p[k]; k += 1;); j += 1;
    );
    i += 1;
  );
  HIG_TXT[0] = j;
);
// The picker (ADR 0024): every option of a part, each drawn on this
// instrument, beside its label. Click one (or Return on it) to use it; it
// stays open so you can play and compare. Done, Esc or a click elsewhere
// closes it. For a part made of a material, a menu of the 31 materials.
function chooser() local(c, n, mc, v, cols, rows, cw, chh, g, ip, hh, pw, ph, px, py, q, i, cx, cy, fi, hvc, on, tx0, ty0, tx1, ty1, bw, bh, s, ox, oy, tw, th, my, mw, k, inside, dw)
(
  c = pop_c; n = cat_count(c); mc = mat_cat(c); v = slider(c + 1)|0;
  cols = min(3, n); rows = ceil(n/cols);
  cw = 132*gsc; chh = 92*gsc; g = 12*gsc; ip = 16*gsc; hh = 28*gsc;
  pw = cols*cw + (cols - 1)*g + 2*ip;
  ph = ip + hh + g + rows*chh + (rows - 1)*g + (mc >= 0 ? g + hh : 0) + ip;
  q = CAT_TAB + c*CAT_STRIDE;
  px = floor(max(pad, min(gw - pad - pw, q[7] + 0.5*q[8] - 0.5*pw)));
  py = q[6] == 0 ? q[9] + q[10] + 8*gsc : q[9] - 8*gsc - ph;
  py = floor(max(pad, min(gh - pad - ph, py)));
  hig_audit ? hig_forget(px, py, pw, ph);
  // a soft shadow, then the raised surface
  k = 3; loop(3, gfx_set(0, 0, 0, 0.12); rfill(px - k*gsc, py - k*gsc + 3*gsc, pw + 2*k*gsc, ph + 2*k*gsc, (10 + k)*gsc); k -= 1;);
  rbox(px, py, pw, ph, 10*gsc, C_POP, C_EDGE);
  gfx_setfont(2); col(T_MAIN); gfx_measurestr(cat_name(c), tw, th);
  gfx_x = px + ip; gfx_y = py + ip + 0.5*(hh - th); say(cat_name(c));
  dw = bwidth("Done");
  button(81, px + pw - ip - dw, py + ip, dw, hh, "Done", 0) ? ( pop_c = -1; focus_id = pop_kb && focus_id > 0 ? 10 + c : 0; );
  pop_hv = -1;
  i = 0;
  loop(n,
    cx = px + ip + (i % cols)*(cw + g); cy = py + ip + hh + g + floor(i/cols)*(chh + g);
    fi = focusable(70 + i, cx, cy, cw, chh);
    hvc = pinbox(cx, cy, cw, chh);
    (hvc || fi) ? pop_hv = i;
    on = i == v;
    rbox(cx, cy, cw, chh, 8*gsc, hvc ? C_TILE_HOV : C_TILE, on ? group_hex(c) : C_TRACK);
    // the option, drawn on this instrument, framed on its part
    tx0 = cx + 8*gsc; ty0 = cy + 8*gsc; tx1 = cx + cw - 8*gsc; ty1 = cy + chh - 30*gsc;
    bw = max(WF_OBB[i*4 + 2] - WF_OBB[i*4] + 40, 120); bh = max(WF_OBB[i*4 + 3] - WF_OBB[i*4 + 1] + 30, 64);
    s = min((tx1 - tx0)/bw, (ty1 - ty0)/bh);
    ox = 0.5*(tx0 + tx1) - s*0.5*(WF_OBB[i*4] + WF_OBB[i*4 + 2]); oy = 0.5*(ty0 + ty1) - s*0.5*(WF_OBB[i*4 + 1] + WF_OBB[i*4 + 3]);
    wf_draw(WF_OPT + i*WF_OPT_STRIDE, s, ox, oy, -1, c, tx0, ty0, tx1, ty1);
    gfx_setfont(1); col(T_MAIN); gfx_measurestr(opt_name(c, i), tw, th);
    gfx_x = cx + 0.5*(cw - tw); gfx_y = cy + chh - 25*gsc; say(opt_name(c, i));
    // the one in use: an edge in its colour and a bar under its name
    on ? ( col(T_MAIN); gfx_rect(floor(cx + 0.5*(cw - tw)), floor(cy + chh - 25*gsc + th) + gsc, tw, max(1, floor(1.5*gsc)), 1); );
    (ui_block && hvc && pclick) || activated(70 + i) ? set_part(c, i);
    i += 1;
  );
  // the arrow keys move between the options
  (focus_id >= 70 && focus_id < 70 + n) ? (
    i = focus_id - 70;
    key == 'rght' ? ( key = 0; i = min(n - 1, i + 1); ) : key == 'left' ? ( key = 0; i = max(0, i - 1); ) :
    key == 'down' ? ( key = 0; i = min(n - 1, i + cols); ) : key == 'up' ? ( key = 0; i = max(0, i - cols); );
    focus_id = 70 + i;
  );
  mc >= 0 ? (
    my = py + ip + hh + g + rows*chh + (rows - 1)*g + g;
    gfx_setfont(1); col(T_LABEL); gfx_measurestr("Made of", tw, th);
    gfx_x = px + ip; gfx_y = my + 0.5*(hh - th); say("Made of");
    cx = px + ip + tw + 12*gsc;
    gfx_measurestr(mat_name(slider(mc + 1)|0), tw, th); mw = max(130*gsc, tw + 40*gsc);
    fi = focusable(80, cx, my, mw, hh); hvc = pinbox(cx, my, mw, hh);
    rbox(cx, my, mw, hh, 6*gsc, hvc ? C_BTN_HOV : C_BTN, C_TRACK);
    col(T_MAIN); gfx_x = cx + 12*gsc; gfx_y = my + 0.5*(hh - th); say(mat_name(slider(mc + 1)|0));
    tx0 = cx + mw - 20*gsc; ty0 = my + 0.5*hh;
    gfx_triangle(tx0, ty0 - 2*gsc, tx0 + 8*gsc, ty0 - 2*gsc, tx0 + 4*gsc, ty0 + 2*gsc);
    (ui_block && hvc && pclick) || activated(80) ? mat_menu(mc, cx, my + hh);
    (c == 6 || c == 7) ? (
      gfx_measurestr("Shared with the resonator", tw, th);
      cx + mw + 12*gsc + tw <= px + pw - ip ? ( col(T_LABEL); gfx_x = cx + mw + 12*gsc; gfx_y = my + 0.5*(hh - th); say("Shared with the resonator"); );
    );
  );
  pop_x = px; pop_y = py; pop_w = pw; pop_h = ph;
  // a click outside closes it (and does nothing else)
  inside = pinbox(px, py, pw, ph);
  ui_block && pclick && !inside ? pop_c = -1;
);

// ---- the eleven controls (sliders 13-23, control k is slider 13 + k). They
// are hidden from REAPER's slider list (which would sit above the window and
// take its height) and drawn here; they stay automatable.
function ctl_title(k)
(
  k==0?"Force":k==1?"Size":k==2?"Brightness":k==3?"Decay":k==4?"Excite Position":k==5?"Resonator Amount":
  k==6?"Play Mode":k==7?"Glide Time":k==8?"Fine Tune":k==9?"Output":"Age / Rust";
);
function ctl_desc(k)
(
  k==0?"How hard it is blown, bowed or struck.":
  k==1?"Scales the resonator, coupler and radiator: bigger is lower and boomier.":
  k==2?"Lets the high frequencies ring longer (right) or die faster (left).":
  k==3?"A longer or shorter ring, without changing anything else.":
  k==4?"Where the exciter touches: near the end (thin, bright) or towards the middle (full, round).":
  k==5?"How much of the resonator you hear against the bare vibrating element.":
  k==6?"Poly plays chords. Mono (Legato) plays one note at a time, so frets, tone holes, valves and slides change pitch the way they do on the real thing.":
  k==7?"How long a Slide takes to reach the next note.":
  k==8?"Moves the whole instrument up or down, by up to a semitone.":
  k==9?"The overall level.":
  "How old and neglected it is, from new to found in a skip: duller, shorter, out of tune, rattly and leaky. Applies from the next note.";
);
function ctl_short(k) ( k==4?"Position":k==5?"Resonator":k==7?"Glide":k==10?"Age":ctl_title(k); );
// the widest value a control can show, so a row can be laid out once
function ctl_widest(k) ( k==2?"+100":k==4?"50%":k==6?"":k==7?"1000 ms":k==8?"+100 cents":k==9?"-36.0 dB":"400%"; );
// can every control in a row show its short name and its widest value side
// by side in cells w wide? (k0, n: the row is controls k0 .. k0+n-1, 6 meaning Age)
function ctl_row_fits(k0, n, w) local(j, k, a, b, th, ok)
(
  gfx_setfont(1); ok = 1; j = 0;
  loop(n, k = k0 + j; k == 6 && k0 == 0 ? k = 10;
    gfx_measurestr(ctl_short(k), a, th); gfx_measurestr(ctl_widest(k), b, th);
    a + b + 26*gsc > w ? ok = 0; j += 1;);
  ok;
);
function ctl_min(k) ( k==1?25:k==2?-100:k==3?10:k==4?2:k==7?5:k==8?-100:k==9?-36:0; );
function ctl_max(k) ( k==1?400:k==3?400:k==4?50:k==6?1:k==7?1000:k==9?12:100; );
function ctl_def(k) ( k==0?70:k==1?100:k==3?100:k==4?20:k==5?50:k==7?120:0; );
// log controls: the value at the middle of the track (0 = linear)
function ctl_mid(k) ( k==1?100:k==3?100:k==7?150:0; );
function ctl_step(k) ( k==9?0.1:1; );
// the part whose colour the control takes
function ctl_part(k) ( k==0?0:k==1?4:k==2?2:k==3?10:k==4?1:k==5?4:k==6?11:k==7?8:k==8?9:k==9?7:2; );
function ctl_col(k) ( k == 10 ? gfx_set(0.85, 0.5, 0.3, 1) : group_col(ctl_part(k)); );
function ctl_pos(k, v) local(a, b, m)
(
  a = ctl_min(k); b = ctl_max(k); m = ctl_mid(k);
  m > 0 ? ( v <= m ? 0.5*log(v/a)/log(m/a) : 0.5 + 0.5*log(v/m)/log(b/m); ) : (v - a)/(b - a);
);
function ctl_val(k, p) local(a, b, m, s, v)
(
  a = ctl_min(k); b = ctl_max(k); m = ctl_mid(k); s = ctl_step(k);
  p = max(0, min(1, p));
  v = m > 0 ? ( p <= 0.5 ? a*(m/a)^(2*p) : m*(b/m)^(2*p - 1); ) : a + p*(b - a);
  max(a, min(b, floor(v/s + 0.5)*s));
);
// one step of the wheel or an arrow key (z = +1 or -1), finer with Shift
function ctl_nudge(k, v, z, fine) local(d)
(
  ctl_mid(k) > 0 ? ( d = ctl_val(k, ctl_pos(k, v) + z*(fine ? 0.005 : 0.02)); d == v ? d = v + z*ctl_step(k); ) :
                   d = v + z*(fine ? ctl_step(k) : max(ctl_step(k), floor(0.02*(ctl_max(k) - ctl_min(k)) + 0.5)));
  d;
);
function ctl_text(k) local(v)
(
  v = slider(13 + k);
  k == 6 ? strcpy(#cv, v >= 0.5 ? "Mono" : "Poly") :
  k == 7 ? sprintf(#cv, "%d ms", v) :
  k == 8 ? sprintf(#cv, v > 0 ? "+%d cents" : "%d cents", v) :
  k == 9 ? sprintf(#cv, v > 0.04 ? "+%.1f dB" : "%.1f dB", v) :
  k == 2 ? sprintf(#cv, v > 0 ? "+%d" : "%d", v) :
  sprintf(#cv, "%d%%", v);
  #cv;
);
function set_ctl(k, v)
(
  v = max(ctl_min(k), min(ctl_max(k), v));
  slider(13 + k) = v;
  slider_automate(2^(12 + k));
  gui_dirty = 1; last_cat = 100 + k;
);
// one control, 44 px tall: drag the track (Shift for fine steps), roll the
// wheel, double-click to reset; Play mode is a two-way switch. From the
// keyboard: the arrow keys step (Shift finer), Delete resets, and Return or
// Space flips Play mode. The name is never cut short: with vin the value
// sits beside it, else at the end of the track, and the name has the width.
function control(k, x, y, w, h, vin) local(v, p, hv, x0, x1, ty, hx, tw, th, tw1, tw2, z, s, d, f, segy, segh, sw_, on, vw)
(
  v = slider(13 + k);
  f = focusable(40 + k, x, y, w, h); f ? focc = 100 + k;
  hv = inbox(x, y, w, h) && drag_k < 0; hv ? hovc = k;
  rbox(x, y, w, h, 6*gsc, hv || drag_k == k ? C_TILE_HOV : C_TILE, C_EDGE);
  ctl_col(k); rfill(floor(x + 4*gsc), floor(y + 9*gsc), max(2, floor(3*gsc)), floor(h - 18*gsc), 1.5*gsc);
  gfx_setfont(1);
  s = ctl_text(k); gfx_measurestr(s, tw, th); k == 6 ? tw = 0;
  gfx_measurestr(ctl_widest(k), vw, th);
  // the full name where it fits, else the short one
  gfx_measurestr(ctl_title(k), tw1, th); gfx_measurestr(ctl_short(k), tw2, th);
  col(T_LABEL); gfx_x = x + 10*gsc; gfx_y = y + 6*gsc;
  say(tw1 + (vin ? vw + 26*gsc : 20*gsc) <= w ? ctl_title(k) : ctl_short(k));
  x0 = x + 12*gsc; x1 = x + w - 12*gsc; ty = y + h - 13*gsc;
  k != 6 ? (
    col(T_MAIN);
    vin ? ( gfx_x = x + w - 9*gsc - tw; gfx_y = y + 6*gsc; ) :
          ( x1 -= vw + 8*gsc; gfx_x = x + w - 9*gsc - tw; gfx_y = ty - 0.5*th; );
    say(s);
  );
  k == 6 ? (
    // Poly | Mono: the chosen half is blue, its word white and underlined
    segy = y + 23*gsc; segh = h - 27*gsc; sw_ = 0.5*(x1 - x0) - 2*gsc;
    z = 0;
    loop(2,
      d = x0 + z*0.5*(x1 - x0); on = (v >= 0.5) == z;
      rbox(d, segy, sw_, segh, 4*gsc, on ? C_ON : C_SEG, C_TRACK);
      gfx_setfont(4); col(on ? T_MAIN : T_DIM);
      s = z ? "MONO" : "POLY"; gfx_measurestr(s, tw, th);
      // (clear of the half's edge, which sits on whole pixels)
      wy_ = floor(segy + 0.5) + max(1, floor(gsc + 0.5)) + 0.5*gsc;
      gfx_x = d + 0.5*(sw_ - tw); gfx_y = wy_; say(s);
      // (on whole pixels below the word's box, whatever the size)
      on ? gfx_rect(d + 0.5*(sw_ - tw), ceil(wy_ + th) + floor(0.5*gsc), tw, max(1, floor(1.5*gsc)), 1);
      z += 1;
    );
    hv && clicked ? set_ctl(k, mouse_x >= x + 0.5*w);
    hv && wheel != 0 ? set_ctl(k, v < 0.5);
  ) : (
    p = ctl_pos(k, v); hx = x0 + p*(x1 - x0);
    col(C_SUNK); gfx_rect(x0, ty - 2*gsc, x1 - x0, 4*gsc, 1);
    edge(C_TRACK, x0, ty - 2*gsc, x1 - x0, 4*gsc);
    ctl_col(k);
    // bipolar controls fill from the middle
    d = (k == 2 || k == 8) ? 0.5*(x0 + x1) : x0;
    gfx_rect(min(d, hx), ty - 2*gsc, abs(hx - d), 4*gsc, 1);
    col(T_MAIN); gfx_circle(hx, ty, (hv || drag_k == k ? 6 : 5)*gsc, 1, 1);
    hv && clicked ? (
      (time_precise() - ctl_t < 0.35 && ctl_last == k) ? (
        set_ctl(k, ctl_def(k)); ctl_t = 0;
      ) : (
        ctl_t = time_precise(); ctl_last = k;
        // clicking away from the handle moves it there first
        (abs(mouse_x - hx) > 8*gsc && !(mouse_cap & 8)) ? ( p = max(0, min(1, (mouse_x - x0)/(x1 - x0))); set_ctl(k, ctl_val(k, p)); );
        drag_k = k; drag_p = drag_p0 = p; drag_x0 = mouse_x; drag_sh = (mouse_cap & 8) > 0;
        // a drag is as fine as the whole cell is wide, even with the value at the end of the track
        drag_w = w - 24*gsc;
      );
    );
    hv && wheel != 0 ? set_ctl(k, ctl_nudge(k, v, wheel > 0 ? 1 : -1, (mouse_cap & 8) > 0));
  );
  f ? (
    z = (key == 'rght' || key == 'up') ? 1 : (key == 'left' || key == 'down') ? -1 : 0;
    z != 0 ? ( key = 0; set_ctl(k, k == 6 ? z > 0 : ctl_nudge(k, v, z, (mouse_cap & 8) > 0)); );
    k == 6 ? ( activated(40 + k) ? set_ctl(k, v < 0.5); ) :
             ( (key == 8 || key == 'del') ? ( key = 0; set_ctl(k, ctl_def(k)); ); );
  );
);
// More / Less, at the end of the first row of controls
function more_button(x, y, w, h) local(hv, f, tw, th, s, tx, ty)
(
  f = focusable(60, x, y, w, h);
  hv = inbox(x, y, w, h) && drag_k < 0;
  rbox(x, y, w, h, 6*gsc, hv ? C_TILE_HOV : C_TILE, C_EDGE);
  s = more_ctl ? "Less" : "More";
  gfx_setfont(1); col(T_BODY); gfx_measurestr(s, tw, th);
  gfx_x = x + 0.5*(w - tw) - 6*gsc; gfx_y = y + 0.5*(h - th); say(s);
  tx = gfx_x + 6*gsc; ty = y + 0.5*h;
  more_ctl ? gfx_triangle(tx, ty + 2*gsc, tx + 8*gsc, ty + 2*gsc, tx + 4*gsc, ty - 2*gsc) :
             gfx_triangle(tx, ty - 2*gsc, tx + 8*gsc, ty - 2*gsc, tx + 4*gsc, ty + 2*gsc);
  ((hv && clicked) || activated(60)) ? more_ctl = !more_ctl;
);

// ---- header: the instrument's name and the buttons, all at the top (Apple:
// nothing that matters along a window's bottom edge, which can end up off
// the screen). REAPER's title bar already says "Instrument Creator".
pad = 12*gsc; bh_ = 28*gsc; bgap = 12*gsc;
// is this still the chosen preset, or has a part been changed (here or by automation)?
cur_preset >= 0 ? ( k = 0; pm = PRESET_TAB + cur_preset*PRESET_STRIDE; loop(12, (slider(k + 1)|0) != pm[k] ? cur_preset = -1; k += 1;); );
wP = bwidth("Presets"); wS = bwidth("Surprise Me"); wA = max(bwidth("Play C4"), bwidth("Playing…")); wO = bwidth("Options");
bws = wP + wS + wA + wO + 3*bgap;
nm_ = cur_preset >= 0 ? preset_name(cur_preset) : "Your Own Instrument";
gfx_setfont(3); gfx_measurestr(nm_, nw_, nh_);
// one row while the name and the buttons fit side by side, else two
one_row = pad + nw_ + 24*gsc + bws + pad <= gw;
bxx = one_row ? gw - pad - bws : pad; byy = one_row ? pad : pad + max(nh_, bh_) + 8*gsc;
nw_ > gw - 2*pad ? gfx_setfont(2);
col(T_MAIN); gfx_x = pad; gfx_y = pad + 0.5*(bh_ - nh_); say(nm_);
nmr = one_row ? bxx - 24*gsc : gw - pad;
// the age note, shortened (or left out) when it would run under the buttons
age_ > 0 ? (
  gfx_setfont(1);
  sprintf(#agestr, age_ < 0.34 ? "  (a little worn: age %d%%)" : age_ < 0.67 ? "  (old and rusty: age %d%%)" : "  (found in a skip: age %d%%)", age_*100);
  gfx_measurestr(#agestr, aw_, ah_); gfx_x + aw_ > nmr ? sprintf(#agestr, "  (age %d%%)", age_*100);
  gfx_measurestr(#agestr, aw_, ah_); gfx_y = pad + 0.5*(bh_ - ah_);
  gfx_x + aw_ <= nmr ? ( col(T_AGE); say(#agestr); );
);
button(1, bxx, byy, wP, bh_, "Presets", 0) ? (
  strcpy(#menu, ""); k = 0;
  loop(PRESET_N, k > 0 ? strcat(#menu, "|"); k == cur_preset ? strcat(#menu, "!"); strcat(#menu, preset_name(k)); k += 1;);
  strcat(#menu, "||#Edit → Undo Puts Your Instrument Back");
  gfx_x = bxx; gfx_y = byy + bh_;
  r = gfx_showmenu(#menu);
  r > 0 && r <= PRESET_N ? ( sliderchange(-1); want_preset = r; );
);
bxx += wP + bgap;
button(2, bxx, byy, wS, bh_, "Surprise Me", 0) ? ( sliderchange(-1); want_rand = 1; );
bxx += wS + bgap;
button(3, bxx, byy, wA, bh_, aud_on ? "Playing…" : "Play C4", aud_on) ? ( aud_note = 60; aud_req = 1; );
bxx += wA + bgap;
button(4, bxx, byy, wO, bh_, "Options", 0) ? (
  sprintf(#menu, "%sInterface Size 100%%|%sInterface Size 125%%|%sInterface Size 150%%|%sInterface Size 200%%||%sReduce Motion",
          ui_zoom == 1 ? "!" : "", ui_zoom == 1.25 ? "!" : "", ui_zoom == 1.5 ? "!" : "", ui_zoom == 2 ? "!" : "", calm ? "!" : "");
  // a size the window cannot hold says so, greyed, at the end (it takes no number)
  zoom_fit < ui_zoom - 0.005 ? ( sprintf(#zf, "||#Shown at %d%% Until the Window Is Larger", floor(100*zoom_fit + 0.5)); strcat(#menu, #zf); );
  gfx_x = bxx; gfx_y = byy + bh_;
  r = gfx_showmenu(#menu);
  r >= 1 && r <= 4 ? ui_zoom = (r == 1 ? 1 : r == 2 ? 1.25 : r == 3 ? 1.5 : 2);
  r == 5 ? calm = !calm;
);
top_ = byy + bh_;

// ---- the controls: the seven that shape the sound, then More, which shows
// the four that are usually set once (play mode, glide, fine tune, output).
// Cells 44 px tall and 12 apart; they wrap onto more rows when the window is
// narrow for the interface size.
cth = 44*gsc; cgp = 12*gsc; cty = top_ + 12*gsc; cw_all = gw - 2*pad;
gfx_setfont(1); gfx_measurestr("More", tww, thh); mbw = max(64*gsc, tww + 34*gsc);
// a cell is never narrower than its short name needs, with the value at the
// end of the track
cmin = 86*gsc; j = 0;
loop(11, gfx_measurestr(ctl_short(j), tww, thh); cmin = max(cmin, tww + 20*gsc); j += 1;);
cpr = max(1, min(7, floor((cw_all - mbw)/(cmin + cgp))));
cw2 = (cw_all - mbw - cgp - (cpr - 1)*cgp)/cpr;
vin1 = ctl_row_fits(0, 7, cw2);
j = 0;
loop(7,
  control(j < 6 ? j : 10, pad + (j % cpr)*(cw2 + cgp), cty + floor(j/cpr)*(cth + cgp), cw2, cth, vin1);
  j == min(cpr, 7) - 1 ? more_button(gw - pad - mbw, cty, mbw, cth);
  j += 1;
);
y2 = cty + ceil(7/cpr)*(cth + cgp);
more_ctl ? (
  cpr2 = max(1, min(4, floor((cw_all + cgp)/(cmin + cgp)))); cw3 = (cw_all - (cpr2 - 1)*cgp)/cpr2; j = 0;
  vin2 = ctl_row_fits(6, 4, cw3);
  loop(4, control(6 + j, pad + (j % cpr2)*(cw3 + cgp), y2 + floor(j/cpr2)*(cth + cgp), cw3, cth, vin2); j += 1;);
  y2 += ceil(4/cpr2)*(cth + cgp);
);
// a drag carries on wherever the mouse goes, until the button is let go
drag_k >= 0 ? (
  (mouse_cap & 1) ? (
    dsh = (mouse_cap & 8) > 0;
    dsh != drag_sh ? ( drag_p0 = drag_p; drag_x0 = mouse_x; drag_sh = dsh; );
    drag_p = max(0, min(1, drag_p0 + (mouse_x - drag_x0)/drag_w*(dsh ? 0.1 : 1)));
    dv = ctl_val(drag_k, drag_p); dv != slider(13 + drag_k) ? set_ctl(drag_k, dv);
  ) : (
    slider_automate(2^(12 + drag_k), 1); drag_k = -1;
  );
);

// ---- the instrument (ADR 0024): one drawing of the whole thing, built again
// whenever a part changes (here, by a preset or by automation)
k = 0; wf_dirty = !wf_built; loop(12, (slider(k + 1)|0) != WF_LAST[k] ? wf_dirty = 1; k += 1;);
wf_dirty ? (
  k = 0; loop(12, WF_P[k] = WF_LAST[k] = slider(k + 1)|0; k += 1;);
  wf_build(WF_GEO); wm_ex0 = el_x0; wm_ex1 = el_x1; wm_mode = wf_mode;
  k = 0; loop(12, wf_bbox(WF_GEO, k); q = CAT_TAB + k*CAT_STRIDE; q[0] = wbx0; q[1] = wby0; q[2] = wbx1; q[3] = wby1; k += 1;);
  wf_built = 1; wf_optc = -1;
);
// the picker's drawings: the instrument once per option of its part
pop_c >= 0 && wf_optc != pop_c ? (
  i = 0;
  loop(cat_count(pop_c),
    k = 0; loop(12, WF_P[k] = slider(k + 1)|0; k += 1;); WF_P[pop_c] = i;
    wf_build(WF_OPT + i*WF_OPT_STRIDE); wf_bbox(WF_OPT + i*WF_OPT_STRIDE, pop_c);
    WF_OBB[i*4] = wbx0; WF_OBB[i*4 + 1] = wby0; WF_OBB[i*4 + 2] = wbx1; WF_OBB[i*4 + 3] = wby1;
    i += 1;
  );
  wf_optc = pop_c;
);

// where everything goes: the labels' rows, the drawing between them, and the
// close-up under them while there is room for it (it gives way first)
ax = pad; aw = gw - 2*pad;
gfx_setfont(4); gfx_measurestr("A", tww, t4_); gfx_setfont(2); gfx_measurestr("A", tww, t2_); gfx_setfont(1); gfx_measurestr("A", tww, t1_);
// (a fixed height, so 200% is 100% doubled; taller only if a font needs it)
lh_ = max(ceil(62*gsc), ceil(14*gsc + t4_ + gsc + t2_ + t1_));
lty = y2;
avail = gh - pad - lty;
ph_ = max(124*gsc, 0.24*avail);
prev_on = avail - (2*lh_ + 28*gsc + 110*gsc) - 12*gsc >= ph_;
py_ = gh - pad - ph_;
lby = prev_on ? py_ - 12*gsc - lh_ : gh - pad - lh_;
dtop = lty + lh_ + 14*gsc; dbot = lby - 14*gsc;
// the drawing's own space is 900 x 360. What it reaches (measured over
// 20,000 random instruments) is shown, so the scale stays the same whatever
// the parts, and changes only between the two builds
wm_mode == 0 ? ( WX0 = 0; WY0 = 56; WX1 = 906; WY1 = 356; ) : ( WX0 = 20; WY0 = 4; WX1 = 915; WY1 = 358; );
ws_ = max(0.05, min(aw/(WX1 - WX0), (dbot - dtop)/(WY1 - WY0)));
wox = ax + 0.5*(aw - ws_*(WX1 + WX0)); woy = dtop + 0.5*(dbot - dtop) - ws_*0.5*(WY0 + WY1);
lab_rows();
k = 0;
loop(12,
  q = CAT_TAB + k*CAT_STRIDE;
  q[12] = wox + ws_*0.5*(q[0] + q[2]); q[13] = q[6] == 0 ? dtop : dbot;
  k += 1;
);
wf_anchors(WF_GEO, ws_, wox, woy);
lv_ = 0;
while (lv_ < 3 && (row_w(0, lv_) > aw + 0.5 || row_w(1, lv_) > aw + 0.5)) ( lv_ += 1; );
lab_place(0, lty, lv_, lh_); lab_place(1, lby, lv_, lh_);

// what the mouse is over: a label, or a part of the drawing
k = 0;
loop(12, q = CAT_TAB + k*CAT_STRIDE; q[6] >= 0 && inbox(q[7], q[9], q[8], q[10]) ? hov = k; k += 1;);
whit = (!ui_block && hov < 0 && drag_k < 0 && inbox(ax, dtop - 8*gsc, aw, dbot - dtop + 16*gsc)) ? wf_hit(WF_GEO, ws_, wox, woy, 7*gsc) : -1;
whit >= 0 ? hov = whit;
// the part shown in the close-up and lit up in the drawing: the picker's, the
// focused, the hovered, else the last changed
pfoc = (focus_id >= 10 && focus_id < 22) ? focus_id - 10 : -1;
pc0 = pop_c >= 0 ? pop_c : pfoc >= 0 ? pfoc : hov >= 0 ? hov : last_cat;
hl = pc0 >= 100 ? -1 : pc0 == 3 ? 2 : pc0 == 5 ? 4 : pc0;
// the sounding element trembles (Reduce Motion holds anim_ph at 0, which stills it)
wf_vib = min(4, 30*vis_lvl)*sin(anim_ph);
wf_draw(WF_GEO, ws_, wox, woy, hl, -1, 0, 0, 0, 0);
// a click on a part opens its picker; scrolling over it steps it
whit >= 0 && clicked ? pop_open(whit, 0);
whit >= 0 && wheel != 0 ? set_part(whit, ((slider(whit + 1)|0) + (wheel > 0 ? cat_count(whit) - 1 : 1)) % cat_count(whit));
// each label's line to its part
k = 0;
loop(12,
  q = CAT_TAB + k*CAT_STRIDE;
  q[6] >= 0 ? (
    sx = floor(q[7] + 0.5*q[8]) + 0.5; sy = q[6] == 0 ? q[9] + q[10] : q[9]; my_ = q[6] == 0 ? sy + 6*gsc : sy - 6*gsc;
    k == hl ? group_col(k) : col(C_EDGE);
    wline(sx, sy, sx, my_, (k == hl ? 1.5 : 1)*gsc); wline(sx, my_, q[4], q[5], (k == hl ? 1.5 : 1)*gsc);
    col(T_DIM); gfx_circle(q[4], q[5], 2.5*gsc, 1, 1);
  );
  k += 1;
);
// the labels, in the order the energy flows (so Tab goes that way too)
label(0, lv_); label(1, lv_); label(2, lv_); label(6, lv_); label(4, lv_); label(7, lv_);
label(8, lv_); label(9, lv_); label(10, lv_); label(11, lv_);

// ---- the close-up of the part or control in hand: the picker's (the option
// under the mouse or the focus), the focused, the hovered, else the last changed
pc = pop_c >= 0 ? pop_c : focus_id > 0 && focc >= 0 ? focc : hov >= 0 ? hov : drag_k >= 0 ? 100 + drag_k : hovc >= 0 ? 100 + hovc : last_cat;
prev_on ? (
  col(C_PREV); rfill(ax, py_, aw, ph_, 8*gsc);
  v = pc >= 100 ? 0 : slider(pc + 1)|0;
  pop_c >= 0 && pop_hv >= 0 ? v = pop_hv;
  sw = aw > 560*gsc ? min(200*gsc, 0.22*aw) : 0;
  tx = ax + 18*gsc; tw2 = aw - 36*gsc - (sw > 0 ? sw + 16*gsc : 0);
  wrap_ymax = py_ + ph_ - 6*gsc;
  // the kind, with a dot in its colour
  pc >= 100 ? ctl_col(pc - 100) : group_col(pc); gfx_circle(tx + 3*gsc, py_ + 16*gsc, 3*gsc, 1, 1);
  gfx_setfont(4); col(T_DIM); gfx_x = tx + 12*gsc; gfx_y = py_ + 10*gsc; say(pc >= 100 ? "CONTROL" : cat_title(pc));
  gfx_setfont(5); col(T_MAIN); gfx_x = tx; gfx_y = py_ + 24*gsc;
  pc >= 100 ? (
    say(ctl_title(pc - 100)); say("   "); col(T_HINT); say(ctl_text(pc - 100));
  ) : (
    say(opt_name(pc, v));
    mat_cat(pc) >= 0 ? ( say("   "); col(pc == 2 ? T_ELEM : T_RES); say(mat_name(slider(mat_cat(pc) + 1)|0)); );
  );
  gfx_setfont(1); col(T_BODY);
  yy = draw_wrapped(pc >= 100 ? ctl_desc(pc - 100) : opt_desc(pc, v), tx, py_ + 52*gsc, tw2, 17*gsc);
  // how to use it: with the mouse, or (when the keyboard is in use) the keys
  strcpy(#info,
    pop_c >= 0 ? (focus_id > 0 ? "The arrow keys move between them; Return uses one; Esc closes." :
                                 "Click one to use it, then play to hear it. Click Done when you’re finished.") :
    focus_id > 0 ? (pc >= 100 ? (pc == 106 ? "Return or the arrow keys switch it." : "The arrow keys change it (hold Shift for small steps); Delete resets it.") :
                                "Return shows every choice; the arrow keys step through them.") :
    pc >= 100 ? (pc == 106 ? "Click either side to choose." : "Drag to change it (hold Shift for small steps), scroll, or double-click to reset.") :
    (pc == 3 || pc == 5) ? "Scroll over it to step through the materials." :
                           "Click it, or its name, to see every choice; scroll over it to step through them.");
  wlim = wrap_ymax; wrap_ymax = -1; hy = draw_wrapped(#info, tx, yy + 4*gsc, tw2, 17*gsc); wrap_ymax = wlim;
  hy <= wrap_ymax ? ( col(T_DIM); yy = draw_wrapped(#info, tx, yy + 4*gsc, tw2, 17*gsc); );
  // the coupler decides how the instrument is built
  pc == 6 ? (
    strcpy(#info, v >= 2 ? (v == 2 ? "Built in a line: the mouthpiece joins the parts end to end, like a wind instrument." :
                                     "Built in a line: the windway joins the parts end to end, like a wind instrument.") :
                           (v == 0 ? "Built in layers: the bridge holds the element over the body, like a guitar or a marimba." :
                                     "Built in layers: the soundpost holds the element over the body, like a guitar or a marimba."));
    wlim = wrap_ymax; wrap_ymax = -1; hy = draw_wrapped(#info, tx, yy + 4*gsc, tw2, 17*gsc); wrap_ymax = wlim;
    hy <= wrap_ymax ? ( col(T_DIM); yy = draw_wrapped(#info, tx, yy + 4*gsc, tw2, 17*gsc); );
  );
  (pc == 3 || pc == 5) ? (
    t60 = mat_t60(v, 440);
    ee = mat(v, M_E);
    ee >= 1 ? sprintf(#stf, "%g GPa", ee) : ee >= 0.001 ? sprintf(#stf, "%g MPa", ee*1000) : sprintf(#stf, "%g kPa", ee*1000000);
    t60 >= 1 ? sprintf(#rng, "%.1f s", t60) : sprintf(#rng, "%d ms", t60*1000);
    sprintf(#info, "Stiffness %s, density %d kg/m³. A 440 Hz ring lasts about %s.", #stf, mat(v, M_RHO), #rng);
    wlim = wrap_ymax; wrap_ymax = -1; hy = draw_wrapped(#info, tx, yy + 4*gsc, tw2, 17*gsc); wrap_ymax = wlim;
    hy <= wrap_ymax ? ( col(T_DIM); yy = draw_wrapped(#info, tx, yy + 4*gsc, tw2, 17*gsc); );
  );
  // the hint only if it fits whole (measure it first by drawing nothing)
  wlim = wrap_ymax; wrap_ymax = -1; hy = draw_wrapped(combo_hint(), tx, yy + 6*gsc, tw2, 17*gsc); wrap_ymax = wlim;
  hy <= wrap_ymax ? ( col(T_HINT); yy = draw_wrapped(combo_hint(), tx, yy + 6*gsc, tw2, 17*gsc); );
  wrap_ymax = 1000000;
  // what it sounds like right now, in its own column (real audio, so it
  // moves with Reduce Motion too)
  sh = min(90*gsc, ph_ - 20*gsc);
  (sw > 0 && sh > 16*gsc) ? (
    sx = ax + aw - sw - 12*gsc; sy = py_ + 0.5*(ph_ - sh);
    col(C_SUNK); rfill(sx, sy, sw, sh, 6*gsc);
    st0 = (scope_w - 1024 + SCOPE_LEN) & (SCOPE_LEN - 1); k = 0;
    while (k < 400 && !(SCOPE_BUF[(st0 + k) & (SCOPE_LEN - 1)] <= 0 && SCOPE_BUF[(st0 + k + 1) & (SCOPE_LEN - 1)] > 0)) ( k += 1; );
    st0 += k; sc_ = 0.45*sh/max(0.05, vis_lvl);
    gfx_set(0.45, 0.9, 0.6, 1); k = 0;
    loop(sw - 1,
      y0 = SCOPE_BUF[(st0 + floor(k*512/sw)) & (SCOPE_LEN - 1)]; y1 = SCOPE_BUF[(st0 + floor((k + 1)*512/sw)) & (SCOPE_LEN - 1)];
      j = 0; loop(max(1, floor(gsc + 0.5)), gfx_line(sx + k, sy + 0.5*sh - y0*sc_ + j, sx + k + 1, sy + 0.5*sh - y1*sc_ + j, 1); j += 1;);
      k += 1;
    );
  );
);

// ---- the picker, over everything
pop_c >= 0 ? chooser();

// ---- the keyboard: Tab and Shift+Tab move the focus, Esc closes the picker,
// then lets the focus go. The controls above have already taken Return,
// Space, the arrows and Delete.
key == 9 ? (
  fl_n > 0 ? (
    cur = -1; i = 0;
    loop(fl_n, FOCUS_TAB[i*5] == focus_id ? cur = i; i += 1;);
    (mouse_cap & 8) ? ( cur = cur <= 0 ? fl_n - 1 : cur - 1; ) : ( cur = cur < 0 ? 0 : (cur + 1) % fl_n; );
    focus_id = FOCUS_TAB[cur*5];
  );
) : key == 27 ? (
  pop_c >= 0 ? ( focus_id = focus_id > 0 ? 10 + pop_c : 0; pop_c = -1; ) : focus_id = 0;
);
// the focus ring, near-white and two pixels thick, drawn over everything
fr_on && focus_id > 0 ? (
  col(C_RING); k = 0;
  loop(max(2, floor(2*gsc + 0.5)), gfx_roundrect(floor(fr_x - 3*gsc) - k, floor(fr_y - 3*gsc) - k, floor(fr_w + 6*gsc) + 2*k, floor(fr_h + 6*gsc) + 2*k, floor(9*gsc) + k, 0); k += 1;);
);
